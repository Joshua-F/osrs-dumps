// 1531
[proc,raids_partydetails_preference_setactive](component $component0, int $int1, string $string0)
if_setonmouserepeat("cc_colour_swapper(event_com, $int1, 0xffa82f)", $component0);
if_setonmouseleave("cc_colour_swapper(event_com, $int1, 0xff981f)", $component0);
if_setop(1, "Set", $component0);
if_setopbase("<col=ff9040><$string0></col>", $component0);
if_setonop("raids_partydetails_preference_op(event_op, $component0, $int1, $string0)", $component0);
