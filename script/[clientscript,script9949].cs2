// 9949
[clientscript,script9949](component $component, int $int1, int $int2)
%slotinfo_other_00 = calc(clientclock + 2);
if (.cc_find($component, calc($int1 + $int2)) = true) {
    .cc_setmodelangle(0, 0, 1536, 512, 0, 1800);
    .cc_setontimer("script9950(calc(clientclock + 2), event_com, event_comsubid)");
}
