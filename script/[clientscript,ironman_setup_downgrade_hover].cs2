// 7403
[clientscript,ironman_setup_downgrade_hover](component $component0, int $int1, boolean $boolean2, int $int3, int $int4)
if ($boolean2 = true) {
    if (cc_find($component0, $int1) = true) {
        cc_settrans($int3);
    }
    if_setontimer("ironman_setup_downgrade_timeout(calc(clientclock + 2), event_com, $int1, $int4)", $component0);
} else {
    if (cc_find($component0, $int1) = true) {
        cc_settrans($int4);
    }
    if_setontimer(null, $component0);
}
