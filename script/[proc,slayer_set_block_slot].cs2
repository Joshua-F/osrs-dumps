// 8034
[proc,slayer_set_block_slot](int $int0, int $int1, int $int2)(int)
switch_int ($int0) {
    case 1, 9 :
        ~slayer_set_block_slot_turael($int1, $int2);
    case 2 :
        ~slayer_set_block_slot_mazchna($int1, $int2);
    case 3 :
        ~slayer_set_block_slot_vannaka($int1, $int2);
    case 4 :
        ~slayer_set_block_slot_chaeldar($int1, $int2);
    case 5 :
        ~slayer_set_block_slot_duradel($int1, $int2);
    case 6 :
        ~slayer_set_block_slot_nieve($int1, $int2);
    case 7 :
        ~slayer_set_block_slot_krystilia($int1, $int2);
    case 8 :
        ~slayer_set_block_slot_konar($int1, $int2);
}
