// 10339
[proc,quest_rating_toggle_update](component $component0, component $component1, component $component2, int $int)
if (%settings_disable_quest_rating_prompts = 1) {
    if_setop(1, "Enable", $component0);
    if ($int = 1) {
        if_setgraphic("checkbox,19", $component2);
    } else {
        if_setgraphic("checkbox,16", $component2);
    }
} else {
    if_setop(1, "Disable", $component0);
    if ($int = 1) {
        if_setgraphic("checkbox,18", $component2);
    } else {
        if_setgraphic("checkbox,15", $component2);
    }
}
if ($int = 1) {
    if_setcolour(0x5b442d, $component1);
} else {
    if_setcolour(0x403020, $component1);
}
