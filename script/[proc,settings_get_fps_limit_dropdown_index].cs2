// 3645
[proc,settings_get_fps_limit_dropdown_index]()(int)
if (~on_mobile = false & ~on_enhanced_desktop = false) {
    return(4);
}
def_int $int0 = getdeviceoption(^deviceoption_fps_limit);
if ($int0 = 0) {
    return(4);
} else if ($int0 <= 15) {
    return(0);
} else if ($int0 <= 20) {
    return(1);
} else if ($int0 <= 30) {
    return(2);
} else if ($int0 <= 60) {
    return(3);
} else {
    return(4);
}
