// 4942
[proc,colosseum_intermission_2_loot_draw](long $long)
def_component $tab_content_2_back = colosseum_intermission_2:tab_content_2_back;
def_component $tab_content_2_content = colosseum_intermission_2:tab_content_2_content;
cc_deleteall($tab_content_2_back);
cc_deleteall($tab_content_2_content);
def_int $int2 = 0;
cc_create($tab_content_2_back, ^iftype_rectangle, $int2);
cc_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_top);
cc_setsize(0, 0, ^setsize_minus, ^setsize_minus);
cc_setcolour(^black);
cc_settrans(200);
cc_setfill(true);
$int2 = calc($int2 + 1);
$int2 = ~thinbox($tab_content_2_back, $int2);
$int2 = 0;
def_obj $obj = null;
def_int $int4 = 0;
def_int $int5 = 0;
while ($int4 < inv_size(colosseum_rewards)) {
    $obj = inv_getobj(colosseum_rewards, $int4);
    if ($obj ! null) {
        $int2 = ~colosseum_intermission_2_item_draw($tab_content_2_content, $int2, $obj, inv_getnum(colosseum_rewards, $int4), $int5, 5);
        $int5 = calc($int5 + 1);
    }
    $int4 = calc($int4 + 1);
}
if ($int5 = 0) {
    ~create_text($tab_content_2_content, $int2, p12_full, 0, -20, ^setpos_abs_centre, ^setpos_abs_centre, 40, 40, ^setsize_minus, ^setsize_minus, "You have not earned any loot yet.", true, 0xff981f, ^settextalign_centre, ^settextalign_centre, 0);
    $int2 = calc($int2 + 1);
}
def_string $string = ",";
~create_text($tab_content_2_content, $int2, p12_full, 0, 0, ^setpos_abs_left, ^setpos_abs_bottom, 0, 20, ^setsize_minus, ^setsize_abs, "<tostring_spacer_long($long, $string)> GP", true, ^white, ^settextalign_centre, ^settextalign_centre, 0);
