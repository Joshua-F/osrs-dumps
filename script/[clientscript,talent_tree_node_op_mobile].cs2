// 9358
[clientscript,talent_tree_node_op_mobile](int $int0, int $int1, dbrow $dbrow, component $component3, component $component4, string $string, int $int5, int $int6)
switch_int ($int0) {
    case 1 :
        if (%talent_tree_mobile_op_toggle = 1) {
            ~talent_tree_select_node($int1, $dbrow);
        } else {
            ~talent_tree_mobile_tooltip($component3, $int1, $component4, $string, $int6);
        }
    case 2 :
        if (%talent_tree_mobile_op_toggle = 1) {
            ~talent_tree_mobile_tooltip($component3, $int1, $component4, $string, $int6);
        } else {
            ~talent_tree_select_node($int1, $dbrow);
        }
    case 3 :
        ~talent_tree_deselect_node($int1, $dbrow);
}
if (%talent_tree_showing_info_panel = 1) {
    ~script8566;
}
