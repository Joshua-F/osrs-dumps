// 2386
[proc,tap_drop_warning]
def_enum $enum = ~toplevel_getcomponents;
def_component $component = enum(component, component, $enum, toplevel_osm:side_container_warning);
if ($component = null) {
    return;
}
if (~tap_drop_warning_check = false) {
    if_sethide(true, $component);
} else {
    if_sethide(false, $component);
}
