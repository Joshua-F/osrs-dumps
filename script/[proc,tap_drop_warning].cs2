def_component $component1 = enum(component, component, $enum0, toplevel_osm:side_container_warning);
if ($component1 = null) {
    return;
}
if (~tap_drop_warning_check = false) {
    if_sethide(true, $component1);
} else {
    if_sethide(false, $component1);
}
