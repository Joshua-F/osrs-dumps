// 3501
[proc,death_office_resettakeall](component $component0)
~death_office_drawtakeall($component0, false, false);
if_setonmouserepeat("death_office_drawtakeall($component0, true, false)", $component0);
if_setonmouseleave("death_office_drawtakeall($component0, false, false)", $component0);
if_setonop("death_office_optakeall(event_op, $component0)", $component0);
if_setontimer(null, $component0);
