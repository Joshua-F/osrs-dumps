// 3501
[proc,death_office_resettakeall](component $component)
~death_office_drawtakeall($component, false, false);
if_setonmouserepeat("death_office_drawtakeall($component, true, false)", $component);
if_setonmouseleave("death_office_drawtakeall($component, false, false)", $component);
if_setonop("death_office_optakeall(event_op, $component)", $component);
if_setontimer(null, $component);
