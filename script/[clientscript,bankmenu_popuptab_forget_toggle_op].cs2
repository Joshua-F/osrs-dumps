// 9223
[clientscript,bankmenu_popuptab_forget_toggle_op](int $int0, component $component, int $int2)
if ($int0 ! 1) {
    return;
}
if (cc_find($component, $int2) = true) {
    sound_synth(synth_2266, 1, 0);
    %bank_setting_forget_popup = calc(1 - %bank_setting_forget_popup);
    ~bankmenu_popuptab_forget_toggle_set($component);
}
