// 9999
[proc,script9999](component $component, int $int1, int $int2, int $int3, string $string)(boolean)
if (cc_find($component, $int1) = true) {
    cc_query(2);
    if_query_refine(param_2677, $int3);
    if_query_refine(param_2676, $int2);
    if_query_refine(param_2658, 4);
    if (if_query_next = true) {
        cc_settext($string);
        return(true);
    } else {
        ~debug_mes_warn("Table <tostring($int1)>", "Failed to find text cell at <tostring($int2)>,<tostring($int3)>");
    }
}
return(false);
