// 7842
[clientscript,poh_bookcase_checkheld](component $component0, int $int1)
def_int $int2 = 0;
while ($int2 < $int1) {
    if (.cc_find($component0, calc($int1 + 2 * $int2 + 1)) = true) {
        ~poh_bookcase_checkheld(enum(int, namedobj, enum_5210, $int2));
    }
    $int2 = calc($int2 + 1);
}
