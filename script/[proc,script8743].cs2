// 8743
[proc,script8743](int $int, component $component, dbrow $dbrow)
if ($dbrow = sailing_sidepanel_facility_button_wind_catcher_button) {
    $int = calc($int - 2);
    if (cc_find($component, $int) = true) {
        cc_setontimer("script8744($int, $component, 0)");
    }
} else if ($dbrow = sailing_sidepanel_facility_hull_text) {
    if (cc_find($component, calc($int - 1)) = true) {
        if (%sailing_sidepanel_repairkits >= 16383) {
            cc_settext("Repairs:<br>Lots!");
        } else {
            cc_settext("<int_0=<tostring(%sailing_sidepanel_repairkits)>>Repairs:<br><int_0:spacer> HP");
        }
    }
} else if ($dbrow = sailing_sidepanel_facility_text_bosuns_workbench & cc_find($component, calc($int - 1)) = true) {
    if (%sailing_sidepanel_repairkits >= 16383) {
        cc_settext("Workbench:<br>Lots!");
    } else {
        cc_settext("<int_0=<tostring(%sailing_sidepanel_repairkits)>>Workbench:<br><int_0:spacer> HP");
    }
}
