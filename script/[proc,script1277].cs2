        $string0 = "<str0=<$string1>>You have <col=ffffff><str0>@or4@ bonds in your <col=ffffff>inventory@or4@, <col=ffffff>bank@or4@ & <col=ffffff>bond pouch@or4@.<br>You can <col=ffffff>redeem@or4@ them here.";
