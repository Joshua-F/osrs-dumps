// 9970
[proc,script9970](dbrow $dbrow, component $component, graphic $graphic2, int $int3, int $int4, int $int5, int $int6, graphic $graphic7, fontmetrics $fontmetrics, int $int9)(int)
def_int $int10 = 0;
def_int $int11 = 0;
def_string $string = "";
$int10, $int11 = ~script9968("Overview", $int10, $component, $int11, $graphic2, $int4, $int6);
$string = "Knowing how to effectively use special attacks can be the key to victory in a fight. Complete this challenge to gain a better understanding of how to catch your opponent off guard through the use of special attacks.";
$int10, $int11 = ~script9969($string, $int10, $component, $int11, $graphic7, $fontmetrics, $int9);
$int10, $int11 = ~script9968("Key Points", $int10, $component, calc($int11 + $int5), $graphic2, $int4, $int6);
$string = "- Use a combination of special attacks to help defeat your opponent, such as an Armadyl godsword into the granite maul.<br><br>- Change weapon and use a special attack against your opponent at the same time to become unpredictable.<br><br>- Keep your opponent guessing which special attack weapon you're going to use to ensure they can't use protection prayers against that style.<br><br>- Complete this challenge to receive 20 Blighted super restore (4) potions.";
$int10, $int11 = ~script9969($string, $int10, $component, $int11, $graphic7, $fontmetrics, $int9);
$int10, $int11 = ~script9968("Tips", $int10, $component, calc($int11 + $int5), $graphic2, $int4, $int6);
$string = "- Once this challenge has been completed, a free training mode is available to practice various combinations of special attacks. You can ask your opponent, nicely, to stop moving or using protection prayers for some great practice sessions.<br><br>- Ensure you are able to attack your opponent before pulling out your weapon to special attack. Otherwise, your opponent will see your what you're trying to do too early!<br><br>- Zooming in can make it easier to attack your opponent.<br><br>- Moving your weapon to the 21st inventory slot and using F-Key to switch to your Combat Options tab can help enable your special attacks quickly.<br><br>- Adjust your camera so your opponent is close to where you enable your special attack.<br><br>- Using faster weapons, such as a magic shortbow prior to using a special attack weapon, such as an Armadyl godsword, can help incur high damage on a player within quick succession.<br><br>- Equipping a weapon that has a special attack will give you instant access to the special attack bar and orb when switching to the weapon you wish to special attack with.<br><br>- If you cast the Vengeance spell from the Lunar Spellbook, the combined recoil damage with an unsuspecting special attack can be deadly.";
$int10, $int11 = ~script9969($string, $int10, $component, $int11, $graphic7, $fontmetrics, $int9);
return($int11);
