// 4920
[proc,colosseum_get_modifier_description](struct $struct)(string)
if (~script4980($struct) = 2) {
    return(struct_param($struct, param_1899));
}
if (~script4980($struct) = 1) {
    return(struct_param($struct, param_1898));
} else {
    return(struct_param($struct, param_1897));
}
