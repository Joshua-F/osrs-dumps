def_int $int = inv_size(tradeoffer);
while ($int > 0) {
    $int = calc($int - 1);
    if (cc_find(trademain:your_offer, $int) = true) {
        ~trade_tooltip(inv_getnum(tradeoffer, $int), ~script9913($int, 0), trademain:tooltip);
    }
}
~deltooltip_action(trademain:tooltip);
