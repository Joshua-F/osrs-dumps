// 8936
[proc,port_task_interface_setup_dropdown_hover](dbrow $dbrow, int $int)(boolean, string)
def_string $string = "";
def_boolean $boolean = false;
$boolean, $string = ~slayer_unlock_content_restrict($dbrow);
if ($boolean = true) {
    return(true, $string);
}
if (~league_world = true & ~script3689(%league_type, $int) = 0) {
    return(true, "You cannot unlock <col=ef1020><db_getfield($dbrow, slayer_unlock:name, 0)></col> during <~league_get_league_name>.");
}
return(false, "");
