// 422
[proc,script422](enum $enum, struct $struct)(int)
def_int $int = enum_getoutputcount($enum);
def_boolean $boolean = true;
def_string $string = "";
if ($int > 0 & struct_param($struct, param_2637) = true) {
    while ($int > 0 & $boolean = true) {
        $int = calc($int - 1);
        $string, $boolean = ~settings_get_dropdown_option($enum, $int, $struct);
    }
    if ($boolean = false) {
        $int = calc($int + 1);
    }
}
return($int);
