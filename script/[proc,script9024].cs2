// 9024
[proc,script9024](component $component, enum $enum)
def_int $int2 = 0;
def_dbrow $dbrow = enum(int, dbrow, $enum, calc(%dog_selection_current_selection / 5));
def_int $int4 = 10;
def_int $int5 = 250;
if (db_getfield($dbrow, puppy_colours:large, 0) = true) {
    $int4, $int5 = 20, 275;
}
~create_graphic($component, $int2, tradebacking_dark, 0, 0, ^setpos_abs_centre, ^setpos_abs_top, 0, 0, ^setsize_minus, ^setsize_minus, true);
$int2 = calc($int2 + 1);
cc_create($component, ^iftype_model, $int2);
$int2 = calc($int2 + 1);
cc_setmodel(db_getfield($dbrow, puppy_colours:puppy_selection, %dog_selection_colour));
cc_setmodelanim(dog_update_small_dog_ready);
cc_setsize(0, 0, ^setsize_minus, ^setsize_minus);
cc_setmodelangle(0, $int4, 0, 90, 0, $int5);
cc_setposition(0, 25, ^setpos_abs_centre, ^setpos_abs_top);
$int2 = ~thinbox($component, $int2);
