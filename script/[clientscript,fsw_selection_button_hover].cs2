// 6938
[clientscript,fsw_selection_button_hover](component $component0, int $int1, int $rgb2)
if (cc_find($component0, calc($int1 + 1)) = true) {
    cc_setcolour($rgb2);
}
if (cc_find($component0, calc($int1 + 11)) = true) {
    cc_setcolour($rgb2);
}
if (cc_find($component0, calc($int1 + 12)) = true) {
    cc_setcolour($rgb2);
}
