// 10071
[clientscript,tfa_partydetails_preference_resetbutton](component $component, int $int1, string $string0, string $string1, int $int2, int $int3, int $int4)
if (clientclock < $int3) {
    return;
}
if ($int1 ! -1 & cc_find($component, $int1) = true) {
    cc_setcolour(0xff981f);
    ~tfa_partydetails_preference_settext($string1, $int2, $int4);
}
~tfa_partydetails_preference_setactive($component, $int1, $string0, $string1, $int2, $int4);
