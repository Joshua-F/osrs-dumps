// 10305
[clientscript,quest_rating_init](component $universe, component $close, component $0, component $1, component $2, component $3, component $4, component $5)
~quest_rating_close_button($close);
~quest_rating_score_button($0, 0);
~quest_rating_score_button($1, 1);
~quest_rating_score_button($2, 2);
~quest_rating_score_button($3, 3);
~quest_rating_score_button($4, 4);
~quest_rating_score_button($5, 5);
