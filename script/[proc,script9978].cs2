// 9978
[proc,script9978](component $component0, int $int1, component $component2, int $int3)
if (($int1 < 0 & if_find($component0) = true | cc_find($component0, $int1) = true) & ($int3 < 0 & .if_find($component2) = true | .cc_find($component2, $int3) = true)) {
    .cc_setscrollpos(cc_getscrollx, cc_getscrolly);
}
