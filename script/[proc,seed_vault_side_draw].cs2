// 2813
[proc,seed_vault_side_draw](component $component0, component $component1)
cc_deleteall($component0);
cc_deleteall($component1);
def_int $int2 = calc((42 - 36) * 3 - 2);
def_int $int3 = calc((36 - 32) * 2);
def_int $int4 = 0;
def_obj $obj = null;
def_int $int6 = 0;
def_boolean $boolean7 = ~script7794(93);
def_boolean $boolean8 = false;
def_int $int9 = 0;
def_int $int10 = 0;
while ($int4 < inv_size(inv)) {
    cc_create($component0, ^iftype_graphic, $int4);
    cc_setsize(36, 32, ^setsize_abs, ^setsize_abs);
    $int9 = calc($int2 + $int4 % 4 * 42);
    $int10 = calc($int3 + $int4 / 4 * 36);
    cc_setposition($int9, $int10, ^setpos_abs_left, ^setpos_abs_top);
    cc_setgraphicshadow(0x333333);
    cc_setoutline(1);
    $obj = inv_getobj(inv, $int4);
    if ($obj ! null) {
        cc_sethide(false);
        cc_setobject($obj, inv_getnum(inv, $int4));
        cc_setopbase("<col=ff9040><oc_name($obj)></col>");
        cc_setop(10, "Examine");
        if (%seed_vault_selected_qty = ^max_32bit_int) {
            cc_setop(1, "Deposit-All");
        } else if (%seed_vault_selected_qty > 1) {
            cc_setop(1, "Deposit-<tostring(%seed_vault_selected_qty)>");
        }
        cc_setop(2, "Deposit-1");
        cc_setop(3, "Deposit-5");
        cc_setop(4, "Deposit-10");
        if (%seed_vault_requested_qty > 1) {
            cc_setop(5, "Deposit-<tostring(%seed_vault_requested_qty)>");
        }
        cc_setop(6, "Deposit-X");
        cc_setop(7, "Deposit-All");
    } else {
        cc_sethide(true);
        cc_setobject(blankobject, 1);
    }
    $boolean8 = ~bank_side_locked_slot($int4);
    if (~script7795 = true) {
        if ($boolean8 = true) {
            cc_setop(9, "Unlock-slot");
            cc_sethide(false);
        } else {
            cc_setop(9, "Lock-slot");
        }
    }
    if ($boolean7 = true) {
        $int6 = ~script7783($component1, $int9, $int10, $boolean8, $int6);
    }
    $int4 = calc($int4 + 1);
}
