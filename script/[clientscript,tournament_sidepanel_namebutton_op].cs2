// 3447
[clientscript,tournament_sidepanel_namebutton_op](int $int0, component $component, int $int2, int $int3)
if ($int0 = 1 & cc_find($component, $int2) = true) {
    cc_settrans(140);
    cc_setonmouserepeat(null);
    cc_setonmouseleave(null);
    cc_setonmouseleave(null);
    cc_setontimer("tournament_sidepanel_namebutton_reset(calc(clientclock + 20), $component, $int2, $int3)");
}
