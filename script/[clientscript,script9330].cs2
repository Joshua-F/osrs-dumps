// 9330
[clientscript,script9330](component $menu_container, component $depositworn_toggle)
~deposit_box_menu_draw_toggle("'Deposit worn items' button", $menu_container, $depositworn_toggle, -1);
~deposit_box_menu_depositworn_toggle_set($depositworn_toggle);
if_setonvartransmit("deposit_box_menu_depositworn_toggle_set($depositworn_toggle, cc_getid){bank_extratab}", $depositworn_toggle);
if_setonop("deposit_box_menu_depositworn_toggle_op(event_op, $depositworn_toggle, cc_getid)", $depositworn_toggle);
