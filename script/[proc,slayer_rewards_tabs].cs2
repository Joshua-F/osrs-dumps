        $component10 = slayer_rewards:unlock_contents;
        $component11 = slayer_rewards:unlock_scrollbar;
        ~slayer_rewards_unlock_draw($component0, 0, $component10, $component11, $main, $confirm, $confirm_info, $confirm_button, $back_button);
