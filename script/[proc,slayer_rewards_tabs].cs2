$int8, $int9 = ~slayer_rewards_tab($component0, $component1, $component3, "Extend", $int8, $int9, $component2, $component3, $component4, $component5, $component6, $component7);
$int8, $int9 = ~slayer_rewards_tab($component0, $component1, $component4, "Buy", $int8, $int9, $component2, $component3, $component4, $component5, $component6, $component7);
$int8, $int9 = ~slayer_rewards_tab($component0, $component1, $component5, "Tasks", $int8, $int9, $component2, $component3, $component4, $component5, $component6, $component7);
$int8, $int9 = ~slayer_rewards_tab($component0, $component1, $component6, "Cosmetics", $int8, $int9, $component2, $component3, $component4, $component5, $component6, $component7);
cc_create($component1, ^iftype_text, $int8);
cc_setposition(0, 0, ^setpos_abs_right, ^setpos_abs_top);
