// 2499
[proc,script2499](dbrow $dbrow, int $int)(dbrow)
switch_dbrow ($dbrow) {
    case skill_feature_magic_standard_48_home_teleport :
        if (%league_type = 6) {
            return(skill_feature_magic_standard_leagues_6_home_teleport);
        }
        if (%league_type = 1) {
            return(skill_feature_magic_standard_league_twisted_home_teleport);
        }
        if (%league_type = 3) {
            return(skill_feature_magic_standard_league_3_home_teleport);
        }
    case skill_feature_magic_ancient_01_zaros_home_tele :
        if (%league_type = 6) {
            return(skill_feature_magic_ancient_leagues_6_home_teleport);
        }
        if (%league_type = 3) {
            return(skill_feature_magic_ancient_league_3_home_teleport_2);
        }
    case skill_feature_magic_lunar_01_lunar_home_tele :
        if (%league_type = 6) {
            return(skill_feature_magic_lunar_leagues_6_home_teleport);
        }
        if (%league_type = 3) {
            return(skill_feature_magic_lunar_league_3_home_teleport_3);
        }
    case skill_feature_magic_arceuus_01_arceuus_home_teleport :
        if (%league_type = 6) {
            return(skill_feature_magic_arceuus_leagues_6_home_teleport);
        }
        if (%league_type = 3) {
            return(skill_feature_magic_arceuus_league_3_home_teleport_4);
        }
    case skill_feature_fishing_shimmeringshoal :
        if ($int = 7) {
            return(skill_feature_fishing_trawling_shimmeringshoal);
        }
    case skill_feature_fishing_giantkrillshoal :
        if ($int = 7) {
            return(skill_feature_fishing_trawling_giantkrillshoal);
        }
    case skill_feature_fishing_haddockshoal :
        if ($int = 7) {
            return(skill_feature_fishing_trawling_haddockshoal);
        }
    case skill_feature_fishing_glisteningshoal :
        if ($int = 7) {
            return(skill_feature_fishing_trawling_glisteningshoal);
        }
    case skill_feature_fishing_yellowfinshoal :
        if ($int = 7) {
            return(skill_feature_fishing_trawling_yellowfinshoal);
        }
    case skill_feature_fishing_halibutshoal :
        if ($int = 7) {
            return(skill_feature_fishing_trawling_halibutshoal);
        }
    case skill_feature_fishing_vibrantshoal :
        if ($int = 7) {
            return(skill_feature_fishing_trawling_vibrantshoal);
        }
    case skill_feature_fishing_bluefinshoal :
        if ($int = 7) {
            return(skill_feature_fishing_trawling_bluefinshoal);
        }
    case skill_feature_fishing_marlinshoal :
        if ($int = 7) {
            return(skill_feature_fishing_trawling_marlinshoal);
        }
}
return($dbrow);
