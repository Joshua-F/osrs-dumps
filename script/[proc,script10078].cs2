// 10078
[proc,script10078](component $component, int $int1, int $int2, string $string, int $int3, int $int4, graphic $graphic)
cc_deleteall($component);
cc_create($component, ^iftype_graphic, 0);
cc_setsize(7, 5, ^setsize_abs, ^setsize_abs);
cc_setposition(0, 2, ^setpos_abs_centre, ^setpos_abs_bottom);
.cc_create($component, ^iftype_graphic, 1);
if ($graphic = "tfa_grouping_icons,1") {
    .cc_setsize(19, 19, ^setsize_abs, ^setsize_abs);
} else {
    .cc_setsize(18, 19, ^setsize_abs, ^setsize_abs);
}
.cc_setposition(0, 2, ^setpos_abs_centre, ^setpos_abs_top);
.cc_setgraphic($graphic);
.cc_settrans(0);
if (%raids_listsort_details = $int2) {
    cc_setgraphic("sortarrows,1");
    cc_settrans(0);
    if (~on_mobile = false) {
        if_setonmouserepeat("script10079(event_com, cc_getid, .cc_getid, 120, tfa_partydetails:tooltip, $string)", $component);
        if_setonmouseleave("script10080(event_com, cc_getid, .cc_getid, 0, tfa_partydetails:tooltip)", $component);
    }
    if_setonclick("script10081($int1, $int3, $int4)", $component);
} else if (%raids_listsort_details = $int1) {
    cc_setgraphic("sortarrows,0");
    cc_settrans(0);
    if (~on_mobile = false) {
        if_setonmouserepeat("script10079(event_com, cc_getid, .cc_getid, 120, tfa_partydetails:tooltip, $string)", $component);
        if_setonmouseleave("script10080(event_com, cc_getid, .cc_getid, 0, tfa_partydetails:tooltip)", $component);
    }
    if_setonclick("script10081($int2, $int3, $int4)", $component);
} else {
    cc_setgraphic("sortarrows,0");
    cc_settrans(100);
    if (~on_mobile = false) {
        if_setonmouserepeat("script10079(event_com, cc_getid, .cc_getid, 200, tfa_partydetails:tooltip, $string)", $component);
        if_setonmouseleave("script10080(event_com, cc_getid, .cc_getid, 100, tfa_partydetails:tooltip)", $component);
    }
    if_setonclick("script10081($int1, $int3, $int4)", $component);
}
if_sethide(false, $component);
