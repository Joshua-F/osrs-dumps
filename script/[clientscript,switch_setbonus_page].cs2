// 3520
[clientscript,switch_setbonus_page](component $component0, component $component1, component $component2, boolean $boolean3)
if ($boolean3 = true) {
    if_sethide(true, $component1);
    if_sethide(false, $component2);
} else {
    if_sethide(false, $component1);
    if_sethide(true, $component2);
}
