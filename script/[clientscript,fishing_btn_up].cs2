// 204
[clientscript,fishing_btn_up](component $fishing_bar, component $fishing_bar_fill)
if (%if1 <= 0) {
    return;
}
if (%misc_points_fish >= 10) {
    return;
}
%misc_points_fish = calc(%misc_points_fish + 1);
%if1 = calc(%if1 - 1);
~kingdom_fill_bar_level(%misc_points_fish, $fishing_bar, $fishing_bar_fill);
