// 5866
[proc,makeovermage_pronouns](component $component0, component $component1, component $component2, component $component3, component $component4, component $component5)
switch_int (%if3) {
    case 0 :
        ~radiobutton_set($component0, $component1, 1);
        ~radiobutton_set($component2, $component3, 0);
        ~radiobutton_set($component4, $component5, 0);
    case 1 :
        ~radiobutton_set($component0, $component1, 0);
        ~radiobutton_set($component2, $component3, 1);
        ~radiobutton_set($component4, $component5, 0);
    case 2 :
        ~radiobutton_set($component0, $component1, 0);
        ~radiobutton_set($component2, $component3, 0);
        ~radiobutton_set($component4, $component5, 1);
}
