// 10144
[proc,script10144](int $int0, int $int1, int $int2)(string)
if ($int0 >= $int1 & $int2 = 1) {
    return("Too Long");
}
$int0 = min($int0, $int1);
def_int $int3 = calc($int0 / 50);
def_int $int4 = calc($int0 / (50 / 10));
if (%option_precise_timing = 0) {
    return(~script4159($int3, %option_separate_hours));
}
def_string $string = ~helper_questdisplay_up($int4, %option_separate_hours);
if ($int0 >= $int1) {
    $string = "> <$string>";
}
return($string);
