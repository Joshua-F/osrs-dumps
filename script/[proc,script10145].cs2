// 10145
[proc,script10145](string $string)
if (~on_mobile = true) {
    cc_setop(1, $string);
    cc_setonop("script10146(event_com, event_comsubid, tfa_stats:tooltip, $string, 512)");
} else {
    cc_setonmouserepeat("tooltip_mouserepeat(event_com, event_comsubid, tfa_stats:tooltip, $string, 25, 120)");
    cc_setonmouseleave("deltooltip(tfa_stats:tooltip)");
}
