// 5033
[proc,pvptut_vengeance_ui_draw_content](dbrow $dbrow, component $component, graphic $graphic2, int $int3, int $int4, int $int5, int $int6, graphic $graphic7, fontmetrics $fontmetrics, int $int9)(int)
def_int $int10 = 0;
def_int $int11 = 0;
def_string $string = "";
$int10, $int11 = ~pvptut_ui_draw_tutorial_header("Overview", $int10, $component, $int11, $graphic2, $int4, $int6);
$string = "Vengeance, if used correctly, can be the best method to conclude a fight early. Complete this challenge to gain a better understanding of the spell and how to use it effectively.";
$int10, $int11 = ~pvptut_ui_draw_tutorial_body($string, $int10, $component, $int11, $graphic7, $fontmetrics, $int9);
$int10, $int11 = ~pvptut_ui_draw_tutorial_header("Key Points", $int10, $component, calc($int11 + $int5), $graphic2, $int4, $int6);
$string = "- Use the Vengeance spell to defeat your opponent.<br><br>- Use Vengeance in combination with a special attack.<br><br>- Vengeance normally has a 30 second cooldown, however for this challenge, it will be reduced to 5 seconds to reduce downtime.<br><br>- Complete this challenge to receive 100 Blighted vengeance sacks.";
$int10, $int11 = ~pvptut_ui_draw_tutorial_body($string, $int10, $component, $int11, $graphic7, $fontmetrics, $int9);
$int10, $int11 = ~pvptut_ui_draw_tutorial_header("Tips", $int10, $component, calc($int11 + $int5), $graphic2, $int4, $int6);
$string = "- Once this challenge has been completed, a free training mode is available to practice Vengeance against a friendly foe.<br><br>- Timing is key, do not cast Vengeance too early, as it will make your actions predictable!<br><br>- Vengeance can be used to swiftly end your opponent, but also to chip down your opponent over the long term.<br><br>- The ring of recoil can be used in combination with the Vengeance spell to deal additional rebound damage to your foe.";
$int10, $int11 = ~pvptut_ui_draw_tutorial_body($string, $int10, $component, $int11, $graphic7, $fontmetrics, $int9);
return($int11);
