// 8471
[clientscript,ui_highlight_pulse](component $component0, int $int1, component $component2, int $int3, int $int4, int $int5, int $int6, boolean $boolean)
def_int $int8 = clientclock;
if ($boolean = false) {
    $int8 = ~script10162($component0, $int1);
