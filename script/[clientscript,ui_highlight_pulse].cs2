def_int $int9 = calc($int8 % $int6);
if (cc_find($component2, $int3) = true) {
    if (calc($int8 / $int6 % 2) = 0) {
        cc_settrans(interpolate($int4, $int5, 0, calc($int6 - 1), $int9));
    } else {
        cc_settrans(interpolate(0, $int4, 0, calc($int6 - 1), $int9));
