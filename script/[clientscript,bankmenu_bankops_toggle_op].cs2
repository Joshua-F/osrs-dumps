// 7860
[clientscript,bankmenu_bankops_toggle_op](int $int0, component $component, int $int2)
if ($int0 ! 1) {
    return;
}
if (cc_find($component, $int2) = true) {
    sound_synth(synth_2266, 1, 0);
    %bank_bankops_toggle_on = calc(1 - %bank_bankops_toggle_on);
    ~bankmenu_bankops_toggle_set($component);
}
