// 8955
[clientscript,mourning_deathaltar_list_init](component $universe, component $container, component $scrollbar, component $text)
cc_deleteall($scrollbar);
~scrollbar_vertical($scrollbar, $container, "scrollbar_parchment_dragger_v2,3", "scrollbar_parchment_dragger_v2,0", "scrollbar_parchment_dragger_v2,1", "scrollbar_parchment_dragger_v2,2", "scrollbar_parchment_v2,0", "scrollbar_parchment_v2,1");
~mourning_deathaltar_list_refresh(if_gettext($text), $universe, $container, $scrollbar, $text);
