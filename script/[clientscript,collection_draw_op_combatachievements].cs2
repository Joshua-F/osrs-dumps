// 4854
[clientscript,collection_draw_op_combatachievements](int $int, component $component)
if ($int ! 1) {
    return;
}
sound_synth(synth_2266, 1, 0);
~collection_draw_combatachievements($component, true);
if_setonmouserepeat(null, $component);
if_setonmouseleave(null, $component);
if_setonop(null, $component);
if_setontimer("collection_draw_reset_combatachievements(calc(clientclock + 20), event_com)", $component);
