// 1645
[clientscript,ge_history_addline](int $int0, obj $obj, int $int2, int $int3, long $long0, long $long1)
if (%poll_id < $int0) {
    return;
}
def_int $int4 = calc($int0 * 6);
if ($int3 <= 0) {
    $int3 = 1;
}
def_int $int5 = 0;
def_int $int6 = calc($int0 * 46);
cc_create(ge_history:list, ^iftype_graphic, $int4);
cc_setposition(0, $int6, ^setpos_abs_centre, ^setpos_abs_top);
cc_setsize(0, 46, ^setsize_minus, ^setsize_abs);
cc_setgraphic(tradebacking_light);
cc_settiling(true);
if (calc($int0 % 2) = 0) {
    cc_settrans(0);
    cc_setonmouseover("ge_history_mouseeffect(ge_history:list, $int4, 75, calc($int4 + 3), true, $obj, $int3)");
    cc_setonmouseleave("ge_history_mouseeffect(ge_history:list, $int4, 0, calc($int4 + 3), false, $obj, $int3)");
} else {
    cc_settrans(125);
    cc_setonmouseover("ge_history_mouseeffect(ge_history:list, $int4, 200, calc($int4 + 3), true, $obj, $int3)");
    cc_setonmouseleave("ge_history_mouseeffect(ge_history:list, $int4, 125, calc($int4 + 3), false, $obj, $int3)");
}
cc_setop(1, "Buy-offer");
cc_setop(10, "Examine");
cc_setopbase("<col=ff9040><oc_name($obj)></col>");
$int4 = calc($int4 + 1);
cc_create(ge_history:list, ^iftype_graphic, $int4);
$int4 = calc($int4 + 1);
cc_setposition($int5, calc($int6 + (46 - 35) / 2), ^setpos_abs_left, ^setpos_abs_top);
cc_setsize(35, 35, ^setsize_abs, ^setsize_abs);
$int5 = calc($int5 + 35);
.cc_create(ge_history:list, ^iftype_text, $int4);
$int4 = calc($int4 + 1);
.cc_setposition($int5, $int6, ^setpos_abs_left, ^setpos_abs_top);
.cc_setsize(45, 46, ^setsize_abs, ^setsize_abs);
$int5 = calc($int5 + 45);
.cc_setcolour(0xff981f);
.cc_settextfont(p11_full);
.cc_settextshadow(true);
.cc_settextalign(^settextalign_left, ^settextalign_centre, 0);
if ($int2 = 1) {
    cc_setgraphic("ge_icons,0");
    .cc_settext("Sold:");
} else {
    cc_setgraphic("ge_icons,2");
    .cc_settext("Bought:");
}
cc_create(ge_history:list, ^iftype_text, $int4);
$int4 = calc($int4 + 1);
cc_setposition($int5, $int6, ^setpos_abs_left, ^setpos_abs_top);
cc_setsize(170, 46, ^setsize_abs, ^setsize_abs);
$int5 = calc($int5 + 170);
cc_setcolour(0xff981f);
cc_settextfont(p12_full);
cc_settextshadow(true);
cc_settextalign(^settextalign_centre, ^settextalign_centre, 0);
if ($int3 >= 2) {
    cc_settext("<col=ffb83f><oc_name($obj)></col><br>x <~tostring_spacer($int3, ",")>");
} else {
    cc_settext("<col=ffb83f><oc_name($obj)></col>");
}
cc_create(ge_history:list, ^iftype_graphic, $int4);
$int4 = calc($int4 + 1);
cc_setposition($int5, calc($int6 + (46 - 32) / 2), ^setpos_abs_left, ^setpos_abs_top);
cc_setsize(36, 32, ^setsize_abs, ^setsize_abs);
$int5 = calc($int5 + 36);
cc_setgraphicshadow(0x333333);
cc_setoutline(1);
cc_setobject($obj, $int3);
cc_create(ge_history:list, ^iftype_text, $int4);
$int4 = calc($int4 + 1);
cc_setposition($int5, $int6, ^setpos_abs_left, ^setpos_abs_top);
cc_setsize($int5, 46, ^setsize_minus, ^setsize_abs);
cc_setcolour(0xff981f);
cc_settextfont(p11_full);
cc_settextshadow(true);
cc_settextalign(^settextalign_centre, ^settextalign_centre, 0);
def_long $long2 = 0;
def_string $string = "";
if ($int2 = 1 & $long1 > 0) {
    $long2 = long_max(0, calc($long0 - $long1));
    if ($long2 = 1) {
        $string = "<col=ffb83f>1 coin</col><br><col=9f9f9f>(<tostring_spacer_long($long0, ",")> - <tostring_spacer_long($long1, ",")>)</col>";
    } else {
        $string = "<col=ffb83f><tostring_spacer_long($long2, ",")> coins</col><br><col=9f9f9f>(<tostring_spacer_long($long0, ",")> - <tostring_spacer_long($long1, ",")>)</col>";
    }
    if ($int3 > 1) {
        cc_settext("<$string><br>= <tostring_spacer_long(calc($long2 / int_to_long($int3)), ",")> each");
    } else {
        cc_settext($string);
    }
} else {
    if ($long0 = 1) {
        $string = "<col=ffb83f>1 coin</col>";
    } else {
        $string = "<col=ffb83f><tostring_spacer_long($long0, ",")> coins</col>";
    }
    if ($int3 > 1) {
        cc_settext("<$string><br>= <tostring_spacer_long(calc($long0 / int_to_long($int3)), ",")> each");
    } else {
        cc_settext($string);
    }
}
%poll_id = calc($int0 + 1);
