// 8072
[clientscript,bankmenu_chuggingbarrel_toggle_op](int $int0, component $component, int $int2)
if ($int0 ! 1) {
    return;
}
if (cc_find($component, $int2) = true) {
    sound_synth(interface_select1, 1, 0);
    %bank_chugging_fill_open = calc(1 - %bank_chugging_fill_open);
    ~bankmenu_chuggingbarrel_toggle_set($component);
}
