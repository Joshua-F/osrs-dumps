// 3574
[proc,hallowed_tools_side_create_move_all](component $component, string $string, boolean $boolean)
if_setonmouserepeat("hallowed_tools_side_recreate_move_all($component, $string, true, $boolean)", $component);
if_setonmouseleave("hallowed_tools_side_recreate_move_all($component, $string, false, $boolean)", $component);
~hallowed_tools_side_recreate_move_all($component, $string, false, $boolean);
