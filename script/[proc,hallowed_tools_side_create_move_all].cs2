// 3574
[proc,hallowed_tools_side_create_move_all](component $component0, string $string0, boolean $boolean1)
if_setonmouserepeat("hallowed_tools_side_recreate_move_all($component0, $string0, true, $boolean1)", $component0);
if_setonmouseleave("hallowed_tools_side_recreate_move_all($component0, $string0, false, $boolean1)", $component0);
~hallowed_tools_side_recreate_move_all($component0, $string0, false, $boolean1);
