// 3084
[proc,br_reward_shop_showpoints](component $component)
def_string $string = ",";
if (%if2 < 32767) {
    if_settext("<int_0=<tostring(%if1)>><int_1=<tostring(%if2)>>Points: <col=ffffff><int_0:spacer></col><br>Wins: <col=ffffff><int_1:spacer></col>", $component);
} else {
    if_settext("<int_0=<tostring(%if1)>>Points: <col=ffffff><int_0:spacer></col><br>Wins: <col=ffffff>Lots!</col>", $component);
}
