// 10185
[proc,script10185]()(int)
def_int $int = 0;
if (%prayerbook = 0) {
    $int = calc($int + bitcount(%prayer_allactive));
    $int = calc($int + bitcount(%prayer_allactive_alternate_0));
} else if (%prayerbook = 1) {
    $int = calc($int + bitcount(%prayer_allactive_ruinous));
}
return($int);
