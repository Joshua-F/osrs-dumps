// 7869
[proc,league_relic_trophies_backing](int $int)(boolean)
switch_int ($int) {
    case 1, 2, 3, 4 :
        if (%if1 >= $int) {
            return(true);
        }
    case 5, 6 :
        if (~league_relic_active(struct_4723) = 1) {
            return(true);
        }
}
return(false);
