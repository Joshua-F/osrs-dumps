// 10173
[proc,script10173](obj $obj, int $int1)(boolean)
def_string $string = "";
def_int $int2 = 0;
if (%total_completed_thefracturedarchive < oc_param($obj, param_2722)) {
    if ($int1 = 1) {
        mes("You need <~tostring_commas(oc_param($obj, param_2722))> completions of the Fractured Archive to gain that Record. Current completions: <~tostring_commas(%total_completed_thefracturedarchive)>");
    }
    return(false);
}
return(true);
