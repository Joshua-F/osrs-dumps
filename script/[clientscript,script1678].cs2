// 1678
[clientscript,script1678](component $wood_bar, component $wood_bar_fill)
if (%if1 <= 0) {
    return;
}
if (%misc_points_wood >= 10) {
    return;
}
%misc_points_wood = calc(%misc_points_wood + 1);
%if1 = calc(%if1 - 1);
~script10317(%misc_points_wood, $wood_bar, $wood_bar_fill);
