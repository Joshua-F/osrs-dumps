// 8264
[proc,bingo_get_num_line_rewards_per_grid](int $int)(int)
switch_int (~bingo_get_grid_layout($int)) {
    case default :
        return(0);
    case 1 :
        return(~bingo_get_num_line_rewards_per_square(3));
    case 2 :
        return(~bingo_get_num_line_rewards_per_square(4));
    case 3 :
        return(~bingo_get_num_line_rewards_per_square(5));
    case 4, 5 :
        return(~bingo_get_num_line_rewards_per_square(7));
}
