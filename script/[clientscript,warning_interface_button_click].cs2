// 9640
[clientscript,warning_interface_button_click](component $component0, string $string, int $int1, int $int2, component $component3)
sound_synth(synth_2266, 1, 0);
if_resume_pausebutton($component3);
if_setop(1, "", $component0);
if_setonop("warning_interface_setup_button($component0, $string, 1, 1)", $component0);
if_setonmouserepeat("warning_interface_setup_button($component0, $string, 1, 1)", $component0);
if_setonmouseleave("warning_interface_setup_button($component0, $string, 1, 1)", $component0);
~warning_interface_setup_button($component0, $string, $int1, $int2);
