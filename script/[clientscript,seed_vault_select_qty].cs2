// 2821
[clientscript,seed_vault_select_qty](component $component, int $int1, int $int2, int $int3, int $int4, int $int5)
if (%seed_vault_requested_qty > 0) {
    if_setop(1, "<int_0=<tostring(%seed_vault_requested_qty)>>Default quantity: <int_0:spacer>", seed_vault:xx);
} else {
    if_setop(1, "", seed_vault:xx);
}
