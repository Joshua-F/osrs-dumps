// 8677
[proc,sailing_charting_filters_redraw]
if (%sailing_charting_completion_filter = -1) {
    %sailing_charting_completion_filter = 0;
}
if (%sailing_charting_level_filter = -1) {
    %sailing_charting_level_filter = 0;
}
def_component $dropdown = sailing_log:dropdown;
def_component $dropdown_content = sailing_log:dropdown_content;
def_component $dropdown_scroller = sailing_log:dropdown_scroller;
~sailing_charting_completion_filter_redraw($dropdown, $dropdown_content, $dropdown_scroller);
~sailing_charting_level_filter_redraw($dropdown, $dropdown_content, $dropdown_scroller);
~sailing_charting_ocean_filter_redraw($dropdown, $dropdown_content, $dropdown_scroller);
~sailing_charting_sea_filter_redraw($dropdown, $dropdown_content, $dropdown_scroller);
