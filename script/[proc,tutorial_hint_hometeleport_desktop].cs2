// 8556
[proc,tutorial_hint_hometeleport_desktop]
if_settext("", tutorial_overlay:hint_text_1);
if_settext("When you're ready, use your Home Teleport spell.", tutorial_overlay:hint_text_2);
def_string $string = "This will take you to the mainland.";
if (~script10311 = true) {
    $string = "This will take you to Death's office.";
}
if_settext($string, tutorial_overlay:hint_text_3);
if_settext("", tutorial_overlay:hint_text_4);
