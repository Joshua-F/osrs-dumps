// 10302
[proc,script10302](component $component, int $int)(int)
cc_create($component, ^iftype_graphic, $int);
$int = calc($int + 1);
cc_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_centre);
cc_setsize(4, 4, ^setsize_minus, ^setsize_minus);
cc_setgraphic(ge_textbackdrop_c);
cc_settiling(true);
cc_create($component, ^iftype_graphic, $int);
$int = calc($int + 1);
cc_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_top);
cc_setsize(4, 4, ^setsize_minus, ^setsize_abs);
cc_setgraphic(ge_textbackdrop_n);
cc_settiling(true);
cc_create($component, ^iftype_graphic, $int);
$int = calc($int + 1);
cc_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_bottom);
cc_setsize(4, 4, ^setsize_minus, ^setsize_abs);
cc_setgraphic(ge_textbackdrop_s);
cc_settiling(true);
cc_create($component, ^iftype_graphic, $int);
$int = calc($int + 1);
cc_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_centre);
cc_setsize(4, 4, ^setsize_abs, ^setsize_minus);
cc_setgraphic(ge_textbackdrop_w);
cc_settiling(true);
cc_create($component, ^iftype_graphic, $int);
$int = calc($int + 1);
cc_setposition(0, 0, ^setpos_abs_right, ^setpos_abs_centre);
cc_setsize(4, 4, ^setsize_abs, ^setsize_minus);
cc_setgraphic(ge_textbackdrop_e);
cc_settiling(true);
cc_create($component, ^iftype_graphic, $int);
$int = calc($int + 1);
cc_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_top);
cc_setsize(4, 4, ^setsize_abs, ^setsize_abs);
cc_setgraphic(ge_textbackdrop_nw);
cc_settiling(false);
cc_create($component, ^iftype_graphic, $int);
$int = calc($int + 1);
cc_setposition(0, 0, ^setpos_abs_right, ^setpos_abs_top);
cc_setsize(4, 4, ^setsize_abs, ^setsize_abs);
cc_setgraphic(ge_textbackdrop_ne);
cc_settiling(false);
cc_create($component, ^iftype_graphic, $int);
$int = calc($int + 1);
cc_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_bottom);
cc_setsize(4, 4, ^setsize_abs, ^setsize_abs);
cc_setgraphic(ge_textbackdrop_sw);
cc_settiling(false);
cc_create($component, ^iftype_graphic, $int);
$int = calc($int + 1);
cc_setposition(0, 0, ^setpos_abs_right, ^setpos_abs_bottom);
cc_setsize(4, 4, ^setsize_abs, ^setsize_abs);
cc_setgraphic(ge_textbackdrop_se);
cc_settiling(false);
return($int);
