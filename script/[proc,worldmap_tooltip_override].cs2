// 4792
[proc,worldmap_tooltip_override](string $string, mapelement $mapelement)(string)
if (mec_category($mapelement) = category_1056) {
    $string = ~worldmap_tooltip_quest_override($mapelement);
}
if (mec_category($mapelement) = category_1104) {
    $string = ~worldmap_tooltip_fairyring_override($mapelement);
}
return($string);
