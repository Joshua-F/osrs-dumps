// 9700
[proc,castle_drakan_set_consumable_status](int $int0, int $int1)
def_int $int2 = calc($int0 - 1);
def_int $int3 = calc($int2 / 32 + 1);
$int2 = calc($int2 % 32);
def_int $int4 = ~castle_drakan_get_consumable_varp_value($int3);
if ($int4 = -1) {
    return;
}
if ($int1 = 1) {
    $int4 = setbit($int4, $int2);
} else {
    $int4 = clearbit($int4, $int2);
}
~castle_drakan_set_consumable_varp_value($int3, $int4);
