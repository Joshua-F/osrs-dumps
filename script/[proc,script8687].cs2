// 8687
[proc,script8687]
def_dbrow $dbrow = null;
if (~sailing_charting_ocean_filter_get ! -1 & ~sailing_charting_sea_filter_get ! -1) {
    db_find(sailing_sea:unique_id, ~sailing_charting_sea_filter_get);
    $dbrow = db_findnext;
    $dbrow = db_getfield($dbrow, sailing_sea:ocean, 0);
    if ($dbrow ! null & ~sailing_charting_ocean_filter_get ! db_getfield($dbrow, sailing_sea:unique_id, 0)) {
        %sailing_charting_sea_filter = -1;
        ~script8661;
    }
}
