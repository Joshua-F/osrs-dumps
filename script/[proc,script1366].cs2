// 1366
[proc,script1366]
if_settext(tostring(~barbassault_get_attackerpoints), barbassault_reward_shop:barbassault_reward_pts_att);
if_settext(tostring(~barbassault_get_defenderpoints), barbassault_reward_shop:barbassault_reward_pts_def);
if_settext(tostring(~barbassault_get_collectorpoints), barbassault_reward_shop:barbassault_reward_pts_col);
if_settext(tostring(~barbassault_get_healerpoints), barbassault_reward_shop:barbassault_reward_pts_heal);
