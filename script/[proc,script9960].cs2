// 9960
[proc,script9960](dbrow $dbrow, component $component, graphic $graphic2, int $int3, int $int4, int $int5, int $int6, graphic $graphic7, fontmetrics $fontmetrics, int $int9)(int)
def_int $int10 = 0;
def_int $int11 = 0;
def_string $string = "";
$int10, $int11 = ~script9968("Overview", $int10, $component, $int11, $graphic2, $int4, $int6);
$string = "When your opponent is able to use protection prayers that reduce damage by 40%, it's not always ideal to constantly attack them with the same style of combat. In this scenario, you'll practice switching gear in response to an opponent switching their overhead prayers and gear.";
$int10, $int11 = ~script9969($string, $int10, $component, $int11, $graphic7, $fontmetrics, $int9);
$int10, $int11 = ~script9968("Key Points", $int10, $component, calc($int11 + $int5), $graphic2, $int4, $int6);
$string = "- Switch gear frequently to keep your opponent on their toes.<br><br>- Use offensive gear that is optimal against your opponent's weakest defences.<br><br>- Complete this challenge to receive 20 Blighted super restore (4) potions.";
$int10, $int11 = ~script9969($string, $int10, $component, $int11, $graphic7, $fontmetrics, $int9);
$int10, $int11 = ~script9968("Tips", $int10, $component, calc($int11 + $int5), $graphic2, $int4, $int6);
$string = "- Changing your offensive prayers before changing gear can provide less pressure on your switches when trying to hit your opponent off prayer. After all, your opponent can't see your offensive prayers!<br><br>- Use F-Keys to change between your inventory, prayers and spellbook quickly.<br><br>- Switching gear to increase your damage output is important in fights, but when you're unable to attack, you can further mitigate incoming damage by changing gear to your tankiest equipment until you're free to attack again.<br><br>- Switching certain pieces of gear to make it look like you're going to do a certain attack style, then swiftly switching gear to a new style is a great way to catch players off guard. If this change of equipment is performed at the same time as you attack your opponent, they will not be able to see the style you are going to attack with, leaving them having to guess which style you will use in the future.<br><br>- If you don't unequip a staff that has an autocast setting enabled, it can make it significantly easier to attack your opponent while using magic.<br><br>- The placement of your items in your inventory can have a huge impact. Placing equipment in the same areas in your inventory where you normally access your prayers or special attack can significantly improve your ability to switch.<br><br>- When you're looking to combine a deadly special attack with the Vengeance spell from the Lunar spellbook, equipping worse defensive gear can benefit you greatly as your opponent is more likely to land an attack on you, making the vengeance recoil damage more likely.";
$int10, $int11 = ~script9969($string, $int10, $component, $int11, $graphic7, $fontmetrics, $int9);
return($int11);
