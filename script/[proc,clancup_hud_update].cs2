// 1185
[proc,clancup_hud_update](component $component0, component $component1)
def_string $string = "";
if (%clancup_score_me > %clancup_score_them) {
    $string = "<int_0=<tostring(%clancup_score_me)>><int_1=<tostring(%clancup_score_them)>><col=ffffff><int_0:spacer></col><br><int_1:spacer>";
} else if (%clancup_score_me < %clancup_score_them) {
    $string = "<int_0=<tostring(%clancup_score_me)>><int_1=<tostring(%clancup_score_them)>><int_0:spacer><br><col=ffffff><int_1:spacer></col>";
} else {
    $string = "<int_0=<tostring(%clancup_score_me)>><int_1=<tostring(%clancup_score_them)>><int_0:spacer><br><int_1:spacer>";
}
if (%clancup_time_remaining >= ^max_32bit_int) {
    if_settext("Your team:<br>Opponents:<br>Starting soon...", $component0);
    $string = append($string, "<br>");
} else if (%clancup_time_remaining > 1) {
    if_settext("Your team:<br>Opponents:<br>Time:", $component0);
    $string = append($string, "<br><tostring(%clancup_time_remaining)> mins");
} else if (%clancup_time_remaining = 1) {
    if_settext("Your team:<br>Opponents:<br>Time:", $component0);
    $string = append($string, "<br>1 min");
} else if (%clancup_score_me = %clancup_score_them) {
    if_settext("Your team:<br>Opponents:<br>", $component0);
    $string = append($string, "<br>Next kill wins!");
} else {
    if_settext("Your team:<br>Opponents:<br>Ending...", $component0);
    $string = append($string, "<br>");
}
if_settext($string, $component1);
