// 6005
[proc,examine_price_info](obj $obj, long $long0, int $int, boolean $boolean2, long $long1, boolean $boolean3, long $long2, long $long3)
if (~on_enhanced_any = false) {
    return;
}
if (%examine_price_ge_enabled = 0 & %examine_price_alch_enabled = 0) {
    return;
}
if ($obj = null) {
    return;
}
$long0 = long_max($long0, 1);
$obj = oc_uncert($obj);
def_string $string = "";
if (%examine_price_ge_enabled = 1 & $boolean2 = true) {
    $string = ~script6006($string, "GE", $long1, $long0);
}
if (%examine_price_alch_enabled = 1 & $boolean3 = false) {
    if ($long2 > 0) {
        $string = ~script6006($string, "HA", $long2, $long0);
    }
    if ($long3 > 0) {
        $string = ~script6006($string, "LA", $long3, $long0);
    }
}
if (string_length($string) <= 0) {
    return;
}
if ($int = 1) {
    if ($long0 > 1) {
        mes("Price of <tostring_spacer_long($long0, ",")> x <oc_name($obj)>: <$string>");
    } else {
        mes("Price of <oc_name($obj)>: <$string>");
    }
} else {
    mes("Price: <$string>");
}
