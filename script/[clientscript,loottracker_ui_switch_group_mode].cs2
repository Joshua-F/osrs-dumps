// 4454
[clientscript,loottracker_ui_switch_group_mode]
switch_int (%option_loottracker_display_group_mode) {
    case 0 :
        %option_loottracker_display_group_mode = 1;
    case 1 :
        %option_loottracker_display_group_mode = 0;
    case default :
        %option_loottracker_display_group_mode = 0;
}
~loottracker_ui_sync_group_mode;
