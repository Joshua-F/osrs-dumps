// 9959
[proc,script9959](dbrow $dbrow, component $component, graphic $graphic2, int $int3, int $int4, int $int5, int $int6, graphic $graphic7, fontmetrics $fontmetrics, int $int9)(int)
def_int $int10 = 0;
def_int $int11 = 0;
def_string $string = "";
$int10, $int11 = ~script9968("Overview", $int10, $component, $int11, $graphic2, $int4, $int6);
$string = "Running away is rarely the best escape. Complete this challenge to learn how binding spells and obstacles can help you survive dangerous situations in the Wilderness.";
$int10, $int11 = ~script9969($string, $int10, $component, $int11, $graphic7, $fontmetrics, $int9);
$int10, $int11 = ~script9968("Key Points", $int10, $component, calc($int11 + $int5), $graphic2, $int4, $int6);
$string = "- Use a binding spell on your opponent to stop them from moving.<br><br>- After your opponent cannot move, hug a wall, tree, or obstacle to break their line of sight. This prevents them from attacking you and allows you to hop worlds to escape!<br><br>- Both the Ancient and standard spellbook provide binding spells that can freeze your opponent for a considerable amount of time. These spells are:<br>  - Entangle: Level 79 Magic.<br>  - Ice Blitz: Level 82 Magic.<br>  - Ice Barrage: Level 94 Magic.<br><br>- Complete this challenge to receive 100 Blighted ancient ice sacks and 100 Blighted Entangle sacks.";
$int10, $int11 = ~script9969($string, $int10, $component, $int11, $graphic7, $fontmetrics, $int9);
$int10, $int11 = ~script9968("Tips", $int10, $component, calc($int11 + $int5), $graphic2, $int4, $int6);
$string = "- Your opponent may use mithril and adamant seeds to slowly move while frozen. This is a technique used in the Wilderness, so always try to use obstacles to your advantage to protect yourself from your opponent planting seeds to move!<br><br>- If your opponent uses a binding spell to stop you from moving, wait until your freeze is close to expiring before trying to freeze them. Otherwise, you will be frozen at the same time and will not be able to run behind an obstacle!<br><br>- If you are feeling overwhelmed in a fight, freezing your opponent so you can stand under them or run behind an obstacle is a great way to reset the pace. You can use this time to eat food, drink potions, let your special attack restore or even organise your gear in your inventory.<br><br>- Some binding spells, such as ice barrage, can be autocast. This can make it easier to catch opponents who are constantly moving.<br><br>- In multi-combat scenarios, you can freeze opponents and stand under them so they can't attack you while they're frozen. This can help smaller teams beat bigger teams, with the right coordination.";
$int10, $int11 = ~script9969($string, $int10, $component, $int11, $graphic7, $fontmetrics, $int9);
return($int11);
