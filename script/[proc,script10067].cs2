// 10067
[proc,script10067](component $component, string $string0, string $string1, int $int1, int $int2, int $int3)
if_sethide(false, $component);
cc_deleteall($component);
cc_create($component, ^iftype_text, 0);
switch_component ($component) {
    case tfa_partydetails:preferred_completions, tfa_partydetails:preferred_size :
        cc_setsize(32, 17, ^setsize_minus, ^setsize_minus);
        cc_setposition(11, 7, ^setpos_abs_left, ^setpos_abs_top);
