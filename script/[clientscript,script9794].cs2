// 9794
[clientscript,script9794](component $component, int $int1, int $int2)
if (cc_find($component, $int1) = true & cc_find($component, calc($int1 + 1)) = true) {
    if ($int2 = 1) {
        cc_setcolour(^white);
    } else if (%dog_selection_current_colour = $int1) {
        cc_setcolour(0xff981f);
    } else {
        cc_setcolour(0x0e0e0c);
    }
}
