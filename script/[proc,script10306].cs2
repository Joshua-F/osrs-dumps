// 10306
[proc,script10306](component $component)
cc_deleteall($component);
cc_create($component, ^iftype_graphic, 0);
cc_setsize(26, 23, ^setsize_abs, ^setsize_abs);
cc_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_centre);
def_graphic $graphic = "close_buttons,6";
cc_setgraphic($graphic);
if_setonmouseleave("script3440(event_com, cc_getid, $graphic, null)", $component);
$graphic = "close_buttons,7";
if_setonmouseover("script3440(event_com, cc_getid, $graphic, null)", $component);
if_setop(1, "Close", $component);
if_setonop("closebutton_click_sound", $component);
if (%keybinding_esc_to_close = 1) {
    if_setopkey(1, ^key_escape, 0, $component);
}
