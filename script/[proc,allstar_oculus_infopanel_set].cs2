// 9500
[proc,allstar_oculus_infopanel_set](boolean $boolean, component $component1, component $component2, component $component3, component $component4, component $component5)
if_sethide($boolean, $component2);
if ($boolean = true) {
    %allstar_oculus_hidehint = true;
    cc_setontimer(null);
    cc_setonkey("script9504(event_keycode, event_com, event_comsubid, $component2, $component3, $component4, $component5)");
    return;
}
%allstar_oculus_hidehint = false;
if_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_centre, $component2);
~allstar_oculus_flashers($component3, $component4, $component5);
cc_setontimer("allstar_oculus_flashers($component3, $component4, $component5)");
cc_setonkey("allstar_oculus_infopanel_hide(event_keycode, event_com, event_comsubid, $component2, $component3, $component4, $component5)");
