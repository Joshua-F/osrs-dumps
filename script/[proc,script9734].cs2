// 9734
[proc,script9734](int $int)
if ($int = 21 & %con_contract_discussed = 1) {
    switch_int (%if1) {
        case default :
            cc_setop(2, "");
        case 1 :
            cc_setop(2, "Beginner Contract");
        case 2 :
            cc_setop(2, "Novice Contract");
        case 3 :
            cc_setop(2, "Adept Contract");
        case 4 :
            cc_setop(2, "Expert Contract");
    }
}
