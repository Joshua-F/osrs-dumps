// 6463
[proc,settings_minimap_icons_at_max_zoom]
if (~on_enhanced_any = false) {
    return;
}
if (%option_minimap_icons_max_zoom_disabled = 0) {
    %option_minimap_icons_max_zoom_disabled = 1;
    minimap_seticonzoomlimit(3);
} else {
    %option_minimap_icons_max_zoom_disabled = 0;
    minimap_seticonzoomlimit(2);
}
