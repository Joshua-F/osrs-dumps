// 5934
[proc,buff_bar_set_processor_on_component](struct $struct)
def_int $int = struct_param($struct, param_1277);
switch_int ($int) {
    case 3 :
        cc_setontimer("buff_bar_processor_timer($struct, clientclock, %map_clock)");
    case 4 :
        cc_setontimer("buff_bar_processor_timer($struct, clientclock, %map_clock)");
    case 5 :
        cc_setontimer("buff_bar_processor_timer($struct, clientclock, %map_clock)");
}
