// 9956
[proc,script9956](dbrow $dbrow, component $component, graphic $graphic2, int $int3, int $int4, int $int5, int $int6, graphic $graphic7, fontmetrics $fontmetrics, int $int9)(int)
def_int $int10 = 0;
def_int $int11 = 0;
def_string $string = "";
$int10, $int11 = ~script9968("Overview", $int10, $component, $int11, $graphic2, $int4, $int6);
$string = "In this intermediate challenge against Pete, he will function as an average opponent that you'd find out in the Wilderness!";
$int10, $int11 = ~script9969($string, $int10, $component, $int11, $graphic7, $fontmetrics, $int9);
$int10, $int11 = ~script9968("Key Points", $int10, $component, calc($int11 + $int5), $graphic2, $int4, $int6);
$string = "- Defeat Pete to receive 2 vouchers per victory, which can be traded in with Justine.";
$int10, $int11 = ~script9969($string, $int10, $component, $int11, $graphic7, $fontmetrics, $int9);
$int10, $int11 = ~script9968("Tips", $int10, $component, calc($int11 + $int5), $graphic2, $int4, $int6);
$string = "- Use F-Keys to change between your inventory, prayers and spellbook quickly.<br><br>- Before a fight starts, ensure you drink your potions and set your offensive and defensive prayers to be prepared in advance for the fight.<br><br>- When drinking a Saradomin brew, you should drink a super restore potion to restore your lowered levels. The optimal ratio is 3 Saradomin brew sips to 1 super restore potion sip.<br><br>- Switch your gear to try hit Pete with a style he is not protecting against.<br><br>- Monitor what equipment Pete is wearing to predict what he will attack with next and change your overhead defensive prayers to counter him.<br><br>- Use your special attack early in the fight so it has a chance to regenerate.<br><br>- If you feel overwhelmed during the fight, use ice barrage to freeze Pete and stand under him so you can replenish your health.<br><br>- Make effective use of your offensive prayers and potions as those are significant buffs to your accuracy and damage.";
