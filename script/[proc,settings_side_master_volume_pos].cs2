def_int $int5 = ~minmax(0, 100, scale($int1, calc($int2 - 16), 100));
if (%option_master_volume ! $int5 | $int3 = 1) {
    %option_master_volume = ~minmax(0, 100, $int5);
    ~settings_apply_volume_master;
