// 2132
[clientscript,fossil_driftnet_init](component $universe, component $confirmation, component $message, component $bin, component $bank, component $inv, component $cancel, component $confirm_destroy, component $confirm_bank, component $confirm_bank_dont_ask)
if_sethide(true, $confirmation);
~script2136($cancel, "Cancel", $confirmation);
~script2136($confirm_destroy, "Discard all", $confirmation);
~script2136($confirm_bank, "Bank all", $confirmation);
~script2136($confirm_bank_dont_ask, "Bank all, don't ask again", $confirmation);
~script2133($bin, 0, "Discard all", "bankbuttons,6", "Are you sure you want to <col=ff0000>destroy</col><br>everything you've caught?", $cancel, $confirmation, $message, $confirm_destroy, null, $confirm_bank, $confirm_bank_dont_ask);
~script2133($bank, 1, "Bank all", "bankbuttons,5", "Pay <tostring(5)> numulites to <col=ffffff>bank</col><br>everything you've caught?", $cancel, $confirmation, $message, $confirm_bank, $confirm_bank_dont_ask, $confirm_destroy, null);
~script2133($inv, 0, "Take all", "bankbuttons,0", "", $cancel, null, null, null, null, null, null);
