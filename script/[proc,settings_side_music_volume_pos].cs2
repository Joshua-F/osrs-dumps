// 9238
[proc,settings_side_music_volume_pos](component $component, int $int1, int $int2, int $int3)
def_int $int4 = %option_music;
def_int $int5 = ~minmax(0, 100, scale($int1, calc($int2 - 16), 100));
if (%option_music ! $int5 | $int3 = 1) {
    %option_music = ~minmax(0, 100, $int5);
    ~settings_apply_volume_music;
    ~settings_side_music_volume_set_position($component, $int2);
