// 9768
[clientscript,omnishop_main_list_item_op](dbrow $dbrow, inv $inv, int $int2, obj $obj, int $int4, int $int5)
switch_int ($int5) {
    case 1 :
        if ($int4 = 1) {
            ~omnishop_main_list_item_select($dbrow, $inv, -1);
        } else {
            ~omnishop_main_list_item_select($dbrow, $inv, $int2);
        }
    case 2 :
        ~omnishop_main_buy($dbrow, $int2, 1);
    case 3 :
        ~omnishop_main_buy($dbrow, $int2, 2);
    case 4 :
        ~omnishop_main_buy($dbrow, $int2, 3);
    case 5 :
        ~omnishop_main_buy($dbrow, $int2, 4);
    case 10 :
        ~omnishop_main_examine($obj);
}
