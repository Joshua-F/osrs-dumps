// 5312
[clientscript,nex_fadetimer](component $component)
if (if_gettrans($component) > %nex_overlay_fade) {
    if_settrans(~max(50, calc(if_gettrans($component) - 1)), $component);
} else if (if_gettrans($component) < %nex_overlay_fade) {
    if_settrans(~min(255, calc(if_gettrans($component) + 1)), $component);
}
