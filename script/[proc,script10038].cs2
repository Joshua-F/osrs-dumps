// 10038
[proc,script10038](component $component, int $int1, int $int2, int $int3)
$int1 = calc($int1 + clientclock);
def_int $int4 = calc($int1 / 50);
def_int $int5 = calc($int1 / 5);
$int4 = ~minmax(0, scale(60, 100, 600000), $int4);
$int5 = ~minmax(0, scale(60, 10, 600000), $int5);
def_string $string = "";
if ($int2 = 0) {
    $string = ~script4159($int4, $int3);
} else {
    $string = ~helper_questdisplay_up($int5, $int3);
}
if_settext($string, $component);
if (string_length($string) <= 5) {
    if_settextalign(^settextalign_centre, ^settextalign_centre, 24, $component);
} else {
    if_settextalign(^settextalign_left, ^settextalign_centre, 24, $component);
}
