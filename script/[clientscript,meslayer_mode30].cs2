// 9904
[clientscript,meslayer_mode30](string $string0)
~meslayer_open(30);
if_settext($string0, chatbox:mes_text);
~script222("");
def_string $string1 = "";
if_setonkey("meslayer_onkey(event_keycode, event_keychar, $string1)", chatbox:mes_text2);
if_setondialogabort("meslayer_ondialogabort", chatbox:mes_text2);
if (~on_mobile = true) {
    ~keyboard_show(1, 19);
    if_setposition(0, -18, ^setpos_abs_centre, ^setpos_abs_centre, chatbox:mes_text);
    if_setsize(0, 36, ^setsize_minus, ^setsize_abs, chatbox:mes_text);
    if_setposition(0, 10, ^setpos_abs_centre, ^setpos_abs_centre, chatbox:mes_text2);
    if_setsize(0, 20, ^setsize_minus, ^setsize_abs, chatbox:mes_text2);
    ~meslayer_button_draw(chatbox:mes_layer_button_1, "T", 0);
    if_setonclick("meslayer_mode30_button(event_com, \"T\", $string0)", chatbox:mes_layer_button_1);
    if_setposition(-105, 8, ^setpos_abs_centre, ^setpos_abs_bottom, chatbox:mes_layer_button_1);
    ~meslayer_button_draw(chatbox:mes_layer_button_2, "B", 0);
    if_setonclick("meslayer_mode30_button(event_com, \"B\", $string0)", chatbox:mes_layer_button_2);
    if_setposition(-35, 8, ^setpos_abs_centre, ^setpos_abs_bottom, chatbox:mes_layer_button_2);
    ~meslayer_button_draw(chatbox:mes_layer_button_3, "M", 0);
    if_setonclick("meslayer_mode30_button(event_com, \"M\", $string0)", chatbox:mes_layer_button_3);
    if_setposition(35, 8, ^setpos_abs_centre, ^setpos_abs_bottom, chatbox:mes_layer_button_3);
    ~meslayer_button_draw(chatbox:mes_layer_button_4, "K", 0);
    if_setonclick("meslayer_mode30_button(event_com, \"K\", $string0)", chatbox:mes_layer_button_4);
    if_setposition(105, 8, ^setpos_abs_centre, ^setpos_abs_bottom, chatbox:mes_layer_button_4);
}
