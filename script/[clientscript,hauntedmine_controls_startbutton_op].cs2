// 3823
[clientscript,hauntedmine_controls_startbutton_op](int $int, component $component)
if ($int ! 1) {
    return;
}
sound_synth(synth_2266, 1, 0);
~hauntedmine_controls_startbutton_draw(true, null, $component);
if_setontimer("hauntedmine_controls_startbutton_reset(calc(clientclock + 20), $component)", $component);
