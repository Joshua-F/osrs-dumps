// 2136
[proc,fossil_driftnet_confirmbutton_init](component $component0, string $string0, component $component1)
~fossil_driftnet_confirmbutton_draw(false, $component0, $string0);
if_setonmouserepeat("fossil_driftnet_confirmbutton_draw(true, $component0, $string0)", $component0);
if_setonmouseleave("fossil_driftnet_confirmbutton_draw(false, $component0, $string0)", $component0);
if_setop(1, $string0, $component0);
if_setonop("fossil_driftnet_confirmbutton_op(event_op, $component1)", $component0);
