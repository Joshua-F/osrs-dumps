// 1962
[proc,storage_side_create_move_all](component $component, string $string, boolean $boolean)
if_setonmouserepeat("storage_side_recreate_move_all($component, $string, true, $boolean)", $component);
if_setonmouseleave("storage_side_recreate_move_all($component, $string, false, $boolean)", $component);
~storage_side_recreate_move_all($component, $string, false, $boolean);
