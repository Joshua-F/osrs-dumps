// 1962
[proc,storage_side_create_move_all](component $component0, string $string0, boolean $boolean1)
if_setonmouserepeat("storage_side_recreate_move_all($component0, $string0, true, $boolean1)", $component0);
if_setonmouseleave("storage_side_recreate_move_all($component0, $string0, false, $boolean1)", $component0);
~storage_side_recreate_move_all($component0, $string0, false, $boolean1);
