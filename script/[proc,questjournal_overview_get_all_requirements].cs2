// 6825
[proc,questjournal_overview_get_all_requirements](dbrow $dbrow, component $component)(string, string)
def_string $string0 = ~questjournal_overview_get_quest_requirements("", $dbrow);
def_string $string1 = ~questjournal_overview_get_skill_requirements("", $dbrow);
def_string $string2 = ~questjournal_overview_list_misc_requirements("", $dbrow);
def_int $int2 = paraheight($string0, if_getwidth($component), p12_full);
def_int $int3 = paraheight($string1, if_getwidth($component), p12_full);
def_int $int4 = paraheight($string2, if_getwidth($component), p12_full);
if ($int2 <= 0 & $int3 <= 0 & $int4 <= 0) {
    return("<"<col=800000>">None", "");
}
def_string $string3 = "";
def_string $string4 = "";
if ($int2 <= 3 | $int3 <= 3 | calc($int2 + $int3) <= 8 | $int4 > 0) {
    $string3 = "<$string0><$string1><$string2>";
} else {
    $string3, $string4 = $string0, $string1;
}
return($string3, $string4);
