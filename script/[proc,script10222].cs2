// 10222
[proc,script10222]
def_int $int = string_length(%displayname_menu_input);
if ($int > 0) {
    if ($int > 12) {
        %displayname_menu_input = substring(%displayname_menu_input, 0, 12);
    }
    displaynames_claim(%displayname_menu_input);
    %displayname_menu_changetime = clientclock;
}
