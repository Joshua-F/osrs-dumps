// 6073
[proc,settings_full_screen]
if (~on_enhanced_desktop = false) {
    return;
}
def_int $int = calc(1 - getdeviceoption(^deviceoption_full_screen));
setdeviceoption(^deviceoption_full_screen, $int);
if ($int = 1 & getwindowmode = ^windowmode_small & %option_interface_scaling = 0) {
    mes("You might like to enable interface scaling, or change your client layout, to get more out of full screen mode.");
}
