// 5757
[clientscript,league_3_fragment_filters_clear_button_init](component $button_2, component $button_2_text)
if_setonop("league_3_fragment_filters_clear_button_click($button_2, $button_2_text)", $button_2);
if_setop(1, "Clear", $button_2);
if_setopbase("<col=ff9040>Filters</col>", $button_2);
~league_3_fragment_filters_clear_button_draw($button_2, $button_2_text);
