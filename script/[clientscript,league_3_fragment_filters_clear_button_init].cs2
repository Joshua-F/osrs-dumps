// 5757
[clientscript,league_3_fragment_filters_clear_button_init](component $component0, component $component1)
if_setonop("league_3_fragment_filters_clear_button_click($component0, $component1)", $component0);
if_setop(1, "Clear", $component0);
if_setopbase("<col=ff9040>Filters</col>", $component0);
~league_3_fragment_filters_clear_button_draw($component0, $component1);
