// 10135
[proc,tfa_stats_party_init_col_header](component $component, int $int1, int $int2, int $int3, graphic $graphic, int $int5, int $int6, string $string)
~cc_table_init_cell_graphic($component, $int1, $int2, $int3, $graphic, $int5, $int6);
if (cc_find($component, ~cc_table_find_cell($component, $int1, $int2, $int3)) = true) {
    ~tfa_stats_init_tooltip($string);
}
