// 7397
[clientscript,bankmenu_depositpotion_toggle_op](int $int0, component $component, int $int2)
if ($int0 ! 1) {
    return;
}
if (cc_find($component, $int2) = true) {
    sound_synth(synth_2266, 1, 0);
    %bank_depositpotion = calc(1 - %bank_depositpotion);
    ~bankmenu_depositpotion_toggle_set($component);
}
