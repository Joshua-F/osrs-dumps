// 9958
[proc,script9958](dbrow $dbrow, component $component, graphic $graphic2, int $int3, int $int4, int $int5, int $int6, graphic $graphic7, fontmetrics $fontmetrics, int $int9)(int)
def_int $int10 = 0;
def_int $int11 = 0;
def_string $string = "";
$int10, $int11 = ~script9968("Overview", $int10, $component, $int11, $graphic2, $int4, $int6);
$string = "Although eating a piece of food isn't a hard task, eating multiple pieces of food can save your life in several situations out in the wild. With most food, there is a delay before you can eat more. However, some foods ignore this delay. In this scenario, you'll try survive your opponents by eating multiple pieces of food effectively. You will not be able to use overhead prayers.";
$int10, $int11 = ~script9969($string, $int10, $component, $int11, $graphic7, $fontmetrics, $int9);
$int10, $int11 = ~script9968("Key Points", $int10, $component, calc($int11 + $int5), $graphic2, $int4, $int6);
$string = "- Ensure you are eating multiple food in one go to survive some otherwise impossible situations.<br><br>- You will not be able to raise your hitpoints over 99 with Saradomin brews during this challenge.<br><br>- You will be given unlimited quantities of food and potions.<br><br>- Complete this challenge to receive 100 Blighted Manta Rays and 50 Blighted Karambwans.";
$int10, $int11 = ~script9969($string, $int10, $component, $int11, $graphic7, $fontmetrics, $int9);
$int10, $int11 = ~script9968("Tips", $int10, $component, calc($int11 + $int5), $graphic2, $int4, $int6);
$string = "- Only a small number of food items ignore the usual eating delay. The most common of these is karambwan. Some potions can also heal you, with these also ignoring the delay. As they're not food themselves, they also don't set the delay, meaning you can use them for a bigger healing combo.<br><br>- The order of which you eat food or drink potions matters. Shark - Potion - Karambwan. These three actions can all be done in one, if you're quick enough.<br><br>- Ensure you wait until the damage has hit you before eating. Otherwise, you'll be wasting precious hitpoints that could have been restored.<br><br>- The Phoenix necklace is not a piece of food, however is an essential item in multi-combat situations. When worn, if your hitpoints drop below 20% of their maximum, the necklace will break, but your hitpoints will be restored by up to 30% and all further pending incoming damage will be cancelled.";
$int10, $int11 = ~script9969($string, $int10, $component, $int11, $graphic7, $fontmetrics, $int9);
return($int11);
