// 5974
[clientscript,script5974](component $farm_bar, component $farm_bar_fill)
if (~script10318 = false) {
    return;
}
if (%misc_points_farm <= 0) {
    return;
}
%misc_points_farm = calc(%misc_points_farm - 1);
%if1 = calc(%if1 + 1);
~script10317(%misc_points_farm, $farm_bar, $farm_bar_fill);
