// 1428
[clientscript,script1428](component $incinerator_toggle, component $sideops_toggle, component $depositworn_toggle, component $depositinv_toggle, component $banktut_toggle)
~bankmenu_draw_toggle("'Bank tutorial' button", $banktut_toggle, 1);
~bankmenu_banktut_toggle_set($banktut_toggle);
if_setonvartransmit("bankmenu_banktut_toggle_set($banktut_toggle, cc_getid){item_redemption}", $banktut_toggle);
if_setonop("bankmenu_banktut_toggle_op(event_op, $banktut_toggle, cc_getid)", $banktut_toggle);
~bankmenu_draw_toggle("Incinerator", $incinerator_toggle, 0);
~bankmenu_incinerator_toggle_set($incinerator_toggle);
if_setonvartransmit("bankmenu_incinerator_toggle_set($incinerator_toggle, cc_getid){prayer25}", $incinerator_toggle);
if_setonop("bankmenu_incinerator_toggle_op(event_op, $incinerator_toggle, cc_getid)", $incinerator_toggle);
def_component $component = bankmain:bankops_toggle;
~bankmenu_draw_toggle("Bank item options", $component, 1);
~bankmenu_bankops_toggle_set($component);
if_setonvartransmit("bankmenu_bankops_toggle_set($component, cc_getid){bankdeposit}", $component);
if_setonop("bankmenu_bankops_toggle_op(event_op, $component, cc_getid)", $component);
~bankmenu_draw_toggle("Inventory item options", $sideops_toggle, 0);
~bankmenu_sideops_toggle_set($sideops_toggle);
if_setonvartransmit("bankmenu_sideops_toggle_set($sideops_toggle, cc_getid){item_redemption}", $sideops_toggle);
if_setonop("bankmenu_sideops_toggle_op(event_op, $sideops_toggle, cc_getid)", $sideops_toggle);
~bankmenu_draw_toggle("'Deposit inventory' button", $depositinv_toggle, 1);
~bankmenu_depositinv_toggle_set($depositinv_toggle);
if_setonvartransmit("bankmenu_depositinv_toggle_set($depositinv_toggle, cc_getid){item_redemption}", $depositinv_toggle);
if_setonop("bankmenu_depositinv_toggle_op(event_op, $depositinv_toggle, cc_getid)", $depositinv_toggle);
~bankmenu_draw_toggle("'Deposit worn items' button", $depositworn_toggle, 0);
~bankmenu_depositworn_toggle_set($depositworn_toggle);
if_setonvartransmit("bankmenu_depositworn_toggle_set($depositworn_toggle, cc_getid){prayer26}", $depositworn_toggle);
if_setonop("bankmenu_depositworn_toggle_op(event_op, $depositworn_toggle, cc_getid)", $depositworn_toggle);
$component = bankmain:depositpotion_toggle;
~bankmenu_draw_toggle("Always deposit to potion store", $component, 1);
~bankmenu_depositpotion_toggle_set($component);
if_setonvartransmit("bankmenu_depositpotion_toggle_set($component, cc_getid){bankdeposit}", $component);
if_setonop("bankmenu_depositpotion_toggle_op(event_op, $component, cc_getid)", $component);
