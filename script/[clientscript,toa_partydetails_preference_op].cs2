// 6743
[clientscript,toa_partydetails_preference_op](int $int0, component $component, int $int2, string $string, int $int3, int $int4)
if ($int0 ! 1) {
    return;
}
if (cc_find($component, $int2) = true & .cc_find(toa_partydetails:pausebuttons, enum(component, int, enum_4792, $component)) = true) {
    sound_synth(interface_select1, 1, 0);
    cc_setcolour(0x7f7f7f);
    cc_settext("...");
    if_setonmouserepeat(null, $component);
    if_setonmouseleave(null, $component);
    if_setonop(null, $component);
    if_clearops($component);
    if_setontimer("toa_partydetails_preference_resetbutton($component, $int2, $string, $int3, calc(clientclock + 80), $int4)", $component);
    .cc_resume_pausebutton;
}
