// 4117
[clientscript,roguesden_mosaic_init](component $universe, component $tile1, component $tile2, component $tile3, component $tile4)
~script4119($tile1, $tile2, $tile3, $tile4);
if (~on_mobile = false) {
    if_setonmouseover("roguesden_piece_mouseover($tile1)", $tile1);
    if_setonmouseleave("roguesden_piece_mouseleave($tile1)", $tile1);
    if_setonmouseover("roguesden_piece_mouseover($tile2)", $tile2);
    if_setonmouseleave("roguesden_piece_mouseleave($tile2)", $tile2);
    if_setonmouseover("roguesden_piece_mouseover($tile3)", $tile3);
    if_setonmouseleave("roguesden_piece_mouseleave($tile3)", $tile3);
    if_setonmouseover("roguesden_piece_mouseover($tile4)", $tile4);
    if_setonmouseleave("roguesden_piece_mouseleave($tile4)", $tile4);
}
if_setoninvtransmit("script4118($tile1, $tile2, $tile3, $tile4){inv}", $universe);
