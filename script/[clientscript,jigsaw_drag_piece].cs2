// 7966
[clientscript,jigsaw_drag_piece](dbrow $dbrow0, component $component1, int $int2, int $int3, int $int4)
if (cc_find($component1, $int2) = true) {
    $int3, $int4 = ~jigsaw_drag_clamp_position($dbrow0, $int3, $int4);
    cc_setposition($int3, $int4, ^setpos_abs_left, ^setpos_abs_top);
}
