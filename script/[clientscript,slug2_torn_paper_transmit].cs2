// 4155
[clientscript,slug2_torn_paper_transmit](component $component0, component $component1, component $component2)
~slug2_torn_paper_toggle_set($component0, slug2_page4a, %slug2_piece1_show, %slug2_piece1_select);
~slug2_torn_paper_toggle_set($component1, slug2_page4b, %slug2_piece2_show, %slug2_piece2_select);
~slug2_torn_paper_toggle_set($component2, slug2_page4c, %slug2_piece3_show, %slug2_piece3_select);
