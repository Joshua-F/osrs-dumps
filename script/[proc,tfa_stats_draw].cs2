[proc,tfa_stats_draw]
if (%tfa_stats_tab = 0) {
    if_setsize(80, 55, ^setsize_minus, ^setsize_minus, tfa_stats:stats_content_container);
    if_setposition(70, 37, ^setpos_abs_left, ^setpos_abs_top, tfa_stats:stats_content_container);
    if_sethide(false, tfa_stats:all_stats_container_border);
} else {
    if_setsize(36, 58, ^setsize_minus, ^setsize_minus, tfa_stats:stats_content_container);
    if_setposition(18, 37, ^setpos_abs_left, ^setpos_abs_top, tfa_stats:stats_content_container);
    if_sethide(true, tfa_stats:all_stats_container_border);
}
~tfa_stats_all_show_category(%tfa_stats_all_selected_category);
~tfa_stats_draw_resize(tfa_stats:universe, 64159748);
~script9975(tfa_stats:title_background, struct_3714, 7496785);
~cc_closebutton(tfa_stats:close_button, "Close", "<col=ff9040>Log</col>");
~tfa_stats_draw_left_tabs;
~tfa_stats_draw_top_tabs;
~script10105;
~tfa_stats_init_show_tab;
