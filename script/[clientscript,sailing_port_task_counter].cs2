// 8708
[clientscript,sailing_port_task_counter](int $int, component $component)
if ($int = 1) {
    if_setonvartransmit("sailing_port_task_counter(0, event_com){port_tasks_completed}", $component);
}
if_settext("<int_0=<tostring(%port_tasks_completed)>>Completed: <col=ffffff><int_0:spacer>", $component);
