// 3090
[clientscript,br_reward_shop_refuse](string $string, component $component0, component $component1, component $component2, component $component3)
sound_synth(synth_2277, 1, 0);
mes($string);
if (%if2 > 0) {
    ~br_reward_shop_draw(-1, $component0, $component1, $component2, $component3);
} else {
    ~br_reward_shop_draw_untradeables(-1, $component0, $component1, $component2, $component3);
}
