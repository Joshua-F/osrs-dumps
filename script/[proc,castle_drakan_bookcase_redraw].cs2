// 9647
[proc,castle_drakan_bookcase_redraw](component $component)
def_int $int1 = 0;
def_int $int2 = 0;
while ($int1 < 8) {
    if (cc_find($component, $int1) = true) {
        $int2 = ~castle_drakan_bookcase_get_book($int1);
        cc_setgraphic(~castle_drakan_bookcase_graphic($int2));
    }
    $int1 = calc($int1 + 1);
}
