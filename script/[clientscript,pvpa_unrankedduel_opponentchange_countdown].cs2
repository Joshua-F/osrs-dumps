// 6214
[clientscript,pvpa_unrankedduel_opponentchange_countdown](int $int, component $component1, component $component2)
if (clientclock >= $int) {
    if_settext("", $component1);
    if_setontimer(null, $component1);
    if_sethide(false, $component2);
} else {
    ~pvpa_unrankedduel_opponentchange_countdown($int, $component1);
}
