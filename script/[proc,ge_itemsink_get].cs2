[proc,ge_itemsink_get](int $int)(obj, long)
switch_int ($int) {
    case 0 :
        return(%ge_itemsink_obj_0, long_max(0, %ge_itemsink_price_long_0));
    case 1 :
        return(%ge_itemsink_obj_1, long_max(0, %ge_itemsink_price_long_1));
    case 2 :
        return(%ge_itemsink_obj_2, long_max(0, %ge_itemsink_price_long_2));
    case 3 :
        return(%ge_itemsink_obj_3, long_max(0, %ge_itemsink_price_long_3));
    case 4 :
        return(%ge_itemsink_obj_4, long_max(0, %ge_itemsink_price_long_4));
    case 5 :
        return(%ge_itemsink_obj_5, long_max(0, %ge_itemsink_price_long_5));
    case 6 :
        return(%ge_itemsink_obj_6, long_max(0, %ge_itemsink_price_long_6));
    case 7 :
        return(%ge_itemsink_obj_7, long_max(0, %ge_itemsink_price_long_7));
}
return(null, 0);
