// 9757
[proc,settings_renderer_option_apply]
if (~on_enhanced_any = false) {
    return;
}
def_int $int = ~settings_renderer_option_get_current;
switch_int ($int) {
    case 1 :
        rt7_sd;
        rt7_setenabled(true);
    case 2 :
        rt7_hd;
        rt7_setenabled(true);
    case default :
        rt7_setenabled(false);
}
~script7915;
