// 8878
[proc,sailing_boat_cargohold_depositall_init](component $component, string $string, obj $obj, graphic $graphic, coord $coord)
if_setop(1, "Deposit", $component);
if_setopbase("<col=ff9040><$string></col>", $component);
~sailing_boat_cargohold_depositall_draw(0, $component, $obj, $graphic, $coord);
if (~on_mobile = false) {
    if_setonmouseover("sailing_boat_cargohold_depositall_draw(1, $component, $obj, $graphic, $coord)", $component);
}
if_setonmouseleave("sailing_boat_cargohold_depositall_draw(0, $component, $obj, $graphic, $coord)", $component);
