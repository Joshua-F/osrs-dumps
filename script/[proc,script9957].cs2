$int10, $int11 = ~script9968("Key Points", $int10, $component, calc($int11 + $int5), $graphic2, $int4, $int6);
$string = "- Defeat Pete to receive 5 vouchers per victory, which can be traded in with Justine. You will also receive an unlimited supply of ancient fabric, which can be used on any imbued god cape obtained from the Mage Arena II miniquest.";
$int10, $int11 = ~script9969($string, $int10, $component, $int11, $graphic7, $fontmetrics, $int9);
