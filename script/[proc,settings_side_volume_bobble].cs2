// 7101
[proc,settings_side_volume_bobble](component $component)
if (~on_enhanced_any = false) {
    if_setgraphic("settings_slider,6", $component);
    return;
}
if (%option_master_volume <= 0) {
    if_setgraphic("settings_slider,12", $component);
} else {
    if_setgraphic("settings_slider,6", $component);
}
