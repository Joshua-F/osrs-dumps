// 6689
[gclientclicknpc,highlighting_npc_all_highlight]
if (~on_enhanced_any = false) {
    return;
}
def_string $string = ~script6690(npc_type);
if (highlight_group_get($string, 6) = true) {
    highlight_group_off($string, 6);
} else {
    highlight_group_on($string, 6);
}
%varclient_1079 = calc(clientclock + 10);
