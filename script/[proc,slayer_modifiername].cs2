// 9744
[proc,slayer_modifiername](int $int0, int $int1, int $int2)(string)
switch_int ($int0) {
    case 1 :
        return("(+<tostring($int1)> Slayer points)");
    case 2 :
        if ($int2 = 1) {
            return("(-<tostring($int1)> Assigned)");
        } else {
            return("(+<tostring($int1)> Assigned)");
        }
    case 3 :
        return("(+<tostring($int1)>% Clue chance)");
    case 4 :
        return("(+<tostring($int1)>% Superior unique chance)");
    case 5 :
        return("(+<tostring($int1)>% Slayer XP)");
    case default :
        if ($int0 ! 0) {
            ~script2075("Player <name> called slayer_modifiername with an invalid modifier_id of <tostring($int0)>, task id <tostring(%slayer_target)>.");
        }
        return("");
}
