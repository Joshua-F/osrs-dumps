// 792
[proc,ge_collect_drawitem](int $int0, inv $inv, component $component2, int $int3, component $component4, component $component5)
def_graphic $graphic6 = "ge_itembackdrop,0";
def_graphic $graphic7 = "ge_itembackdrop,1";
if (.cc_find($component2, $int3) = true) {
    .cc_setgraphic($graphic6);
}
def_obj $obj = inv_getobj($inv, $int0);
def_int $int9 = 0;
if ($obj ! null) {
    $obj, $int9 = ~script9910($obj, $inv, $int0);
    cc_sethide(false);
    cc_clearops;
    cc_setonmouserepeat("cc_graphic_swapper(event_com, $int3, $graphic7, null)");
    cc_setonmouseleave("cc_graphic_swapper(event_com, $int3, $graphic6, null)");
    if ($component4 ! null) {
        if (oc_cert($obj) ! $obj) {
            if ($int9 = 1) {
                cc_setop(1, "Collect-item");
                cc_setop(2, "Collect-note");
            } else {
                cc_setop(1, "Collect-notes");
                cc_setop(2, "Collect-items");
            }
        } else {
            cc_setop(2, "Collect");
        }
    }
    if ($component5 ! null) {
        cc_setop(3, "Bank");
    }
    cc_setop(10, "Examine");
    cc_setopbase("<col=ff9040><oc_name($obj)></col>");
    if ($int9 ! -1) {
        cc_setobject($obj, $int9);
    } else {
        cc_setobject_nonum($obj, ^max_32bit_int);
    }
    if (.cc_find($component2, calc(cc_getid + 2)) = true) {
        .cc_setposition(cc_getx, cc_gety, ^setpos_abs_left, ^setpos_abs_top);
        .cc_settext("Lots!");
        .cc_setsize(cc_getwidth, cc_getheight, ^setsize_abs, ^setsize_abs);
        .cc_settextshadow(true);
        .cc_settextfont(p11_full);
        .cc_settextalign(^settextalign_left, ^settextalign_top, 0);
        .cc_setcolour(0x00ff80);
        if ($int9 = -1) {
            .cc_sethide(false);
        } else {
            .cc_sethide(true);
        }
    }
} else {
    cc_sethide(true);
    cc_clearops;
    cc_setonmouserepeat(null);
    cc_setonmouseleave(null);
    if (.cc_find($component2, calc(cc_getid + 2)) = true) {
        .cc_sethide(true);
    }
}
