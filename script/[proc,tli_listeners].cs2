// 9679
[proc,tli_listeners](enum $enum)
def_component $component = enum(component, component, $enum, toplevel_osrs_stretch:tli_listener);
cc_deleteall($component);
if (~on_enhanced_any = true) {
    ~script9680($component);
    ~script9681($component);
    ~tli_listener_minimap_zoom_level($component);
    ~tli_listener_quest($component);
}
~tli_listener_music($component);
