// 6987
[proc,directional_lock_button_op_confirm](component $component, string $string)
if (%directional_lock_length <= 0) {
    sound_synth(synth_6651, 1, 0);
    return;
}
sound_synth(synth_6652, 1, 0);
~directional_lock_setbutton($component, null, $string, true, 1);
if_setonmouserepeat(null, $component);
if_setonmouseleave(null, $component);
if_setonop(null, $component);
if_clearops($component);
resume_countdialog(tostring(calc(%directional_lock_input * 10 + %directional_lock_length)));
if_setontimer("directional_lock_button_reset_confirm($component, $string, calc(clientclock + 40), false)", $component);
