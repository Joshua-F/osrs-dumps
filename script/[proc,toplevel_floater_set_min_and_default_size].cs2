// 8228
[proc,toplevel_floater_set_min_and_default_size](int $int0, int $int1, int $int2, int $int3)
%toplevel_floater_min_width, %toplevel_floater_min_height = max($int0, 200), max($int1, 200);
%toplevel_floater_default_width, %toplevel_floater_default_height = max($int2, %toplevel_floater_min_width), max($int3, %toplevel_floater_min_height);
