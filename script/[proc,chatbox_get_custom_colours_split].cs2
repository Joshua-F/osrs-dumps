// 4485
[proc,chatbox_get_custom_colours_split](string $string0, string $string1)(string, string)
if (calc(%varplayer_3008 - 1) ! -1) {
    $string0 = ~string_colour_to_tag(calc(%varplayer_3008 - 1), "col");
}
if (calc(%varplayer_3009 - 1) ! -1) {
    $string1 = ~string_colour_to_tag(calc(%varplayer_3009 - 1), "col");
}
return($string0, $string1);
