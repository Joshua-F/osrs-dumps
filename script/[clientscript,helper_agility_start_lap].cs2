// 5173
[clientscript,helper_agility_start_lap](int $int)
if (%helper_agility_course_start_time = 0 | %helper_agility_course_drawn ! %helper_agility_current_course) {
    ~helper_agility_reset_data;
    %helper_agility_course_start_time = $int;
}
~helper_agility_set_laps_until_level;
%helper_agility_xp_gained = 0;
