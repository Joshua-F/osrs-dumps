[clientscript,ballot_overview_poll_finished](int $int0, int $int1)
if ($int1 = 1) {
    ~ballot_overview_draw_intro($int0, "This poll has closed with <"<col=ffffff>">one</col> vote.");
} else {
    ~ballot_overview_draw_intro($int0, "<int_0=<tostring($int1)>>This poll has closed with <"<col=ffffff>"><int_0:spacer></col> votes.");
}
