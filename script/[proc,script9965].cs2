// 9965
[proc,script9965](component $component, string $string0, string $string1)
if (~on_mobile = false) {
    cc_setonmouserepeat("tooltip_mouserepeat(event_com, event_comsubid, $component, $string0, 25, 200)");
    cc_setonmouseleave("deltooltip($component)");
} else {
    cc_setop(1, $string1);
    cc_setonop("script9966($string0)");
}
