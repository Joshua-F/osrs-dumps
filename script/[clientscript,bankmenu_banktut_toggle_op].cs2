// 3370
[clientscript,bankmenu_banktut_toggle_op](int $int0, component $component, int $int2)
if ($int0 ! 1) {
    return;
}
if (cc_find($component, $int2) = true) {
    sound_synth(synth_2266, 1, 0);
    %bank_hidebanktut = calc(1 - %bank_hidebanktut);
    ~bankmenu_banktut_toggle_set($component);
    ~bankmain_banktut_create(bankmain:bank_tut);
}
