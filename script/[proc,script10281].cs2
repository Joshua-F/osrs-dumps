// 10281
[proc,script10281](string $string)
if (~on_mobile = true) {
    cc_setop(1, $string);
    cc_setonop("script10282($string)");
    return;
}
cc_setonmouserepeat("tooltip_mouserepeat(event_com, event_comsubid, hc_summary:tooltip, $string, 25, 512)");
cc_setonmouseleave("deltooltip(hc_summary:tooltip)");
