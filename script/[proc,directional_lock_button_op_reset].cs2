// 6985
[proc,directional_lock_button_op_reset](component $component)
if (%directional_lock_length <= 0) {
    sound_synth(synth_6651, 1, 0);
    return;
}
sound_synth(synth_6652, 1, 0);
%directional_lock_input = 0;
%directional_lock_length = 0;
~directional_lock_update_combination($component);
