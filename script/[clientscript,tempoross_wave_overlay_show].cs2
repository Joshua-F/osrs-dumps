// 4068
[clientscript,tempoross_wave_overlay_show](int $int0)
if_sethide(false, interface_437:com_3);
if_setposition(0, 16384, ^setpos_abs_centre, ^setpos_rel_bottom, interface_437:com_6);
if (on_mobile = true) {
    if_sethide(true, interface_437:com_6);
}
if_setontimer("tempoross_wave_adjust_overlay(clientclock, $int0, true)", interface_437:com_3);
