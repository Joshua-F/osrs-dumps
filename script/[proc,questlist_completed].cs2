// 5995
[proc,questlist_completed](component $component)
def_string $string = ",";
if (~speedrunning_world = false) {
    if_settext("<int_0=<tostring(%quests_completed_count)>><int_1=<tostring(%quests_total_count)>>Completed: <int_0:spacer>/<int_1:spacer>", $component);
} else {
    if_settext("<int_0=<tostring(min(%speedrun_points, 800000))>>Speedrun Points: <int_0:spacer>", $component);
}
