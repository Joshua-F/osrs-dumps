// 1593
[clientscript,mining_btn_up](component $mining_bar, component $mining_bar_fill)
if (%if1 <= 0) {
    return;
}
if (%misc_points_mine >= 10) {
    return;
}
%misc_points_mine = calc(%misc_points_mine + 1);
%if1 = calc(%if1 - 1);
~kingdom_fill_bar_level(%misc_points_mine, $mining_bar, $mining_bar_fill);
