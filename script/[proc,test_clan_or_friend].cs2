// 5217
[proc,test_clan_or_friend](string $string)(boolean)
if (compare($string, chat_playername) = 0) {
    return(true);
}
if (friend_test($string) = true) {
    return(true);
} else if (~activeclanchannel_test_affinity($string, ^clantype_clan) = true) {
    if (ignore_test($string) = false) {
        return(true);
    }
} else {
    return(false);
}
