// 9973
[proc,script9973](component $component, string $string0, string $string1)
cc_deleteall($component);
cc_create($component, ^iftype_graphic, 0);
cc_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_top);
cc_setsize(26, 23, ^setsize_abs, ^setsize_abs);
cc_setgraphic("close_buttons,1");
cc_settiling(false);
cc_setonmouseover("closebutton_over($component)");
cc_setonmouseleave("closebutton_leave($component)");
cc_create($component, ^iftype_graphic, 1);
cc_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_top);
cc_setsize(26, 23, ^setsize_abs, ^setsize_abs);
cc_setgraphic("close_buttons,0");
cc_settiling(false);
cc_setonmouseover("closebutton_over($component)");
cc_setonmouseleave("closebutton_leave($component)");
if_setop(1, $string0, $component);
if_setopbase($string1, $component);
if_setonop("closebutton_click", $component);
if_setonkey("closebutton_key(event_keycode)", $component);
