// 2328
[clientscript,tob_partydetails_preference_resetbutton](component $component0, int $int1, string $string0, int $int2, int $int3)
if (clientclock < $int3) {
    return;
}
if (cc_find($component0, $int1) = true) {
    cc_setcolour(0xff981f);
    ~tob_partydetails_preference_settext($string0, $int2);
}
~tob_partydetails_preference_setactive($component0, $int1, $string0, $int2);
