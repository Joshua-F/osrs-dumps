// 2328
[clientscript,tob_partydetails_preference_resetbutton](component $component, int $int1, string $string, int $int2, int $int3)
if (clientclock < $int3) {
    return;
}
if (cc_find($component, $int1) = true) {
    cc_setcolour(0xff981f);
    ~tob_partydetails_preference_settext($string, $int2);
}
~tob_partydetails_preference_setactive($component, $int1, $string, $int2);
