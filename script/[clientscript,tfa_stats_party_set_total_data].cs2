[clientscript,tfa_stats_party_set_total_data](int $int0, int $int1, int $int2)
~cc_table_set_cell_text(tfa_stats:party_panel_stats, %tfa_stats_party_stats_table_id, 8, 0, ~tfa_stat_abbreviate_tostring($int0, ","));
~cc_table_set_cell_text(tfa_stats:party_panel_stats, %tfa_stats_party_stats_table_id, 8, 1, ~tfa_stat_abbreviate_tostring($int1, ","));
~cc_table_set_cell_text(tfa_stats:party_panel_stats, %tfa_stats_party_stats_table_id, 8, 2, ~tfa_stat_abbreviate_tostring($int2, ","));
