// 2694
[clientscript,tournament_supplies_resetapplybutton](int $int0)
if (clientclock < $int0) {
    return;
}
~tournament_supplies_drawapplybutton(false, false);
if_setonmouserepeat("tournament_supplies_drawapplybutton(true, false)", tournament_supplies:loadout_apply);
if_setonmouseleave("tournament_supplies_drawapplybutton(false, false)", tournament_supplies:loadout_apply);
if_setonop("tournament_supplies_opapplybutton(event_op)", tournament_supplies:loadout_apply);
