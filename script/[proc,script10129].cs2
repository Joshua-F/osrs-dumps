// 10129
[proc,script10129](string $string)
if (string_length($string) > 0) {
    if_settext($string, tfa_stats:party_panel_mvp_name);
    if_setcolour(0xd0b088, tfa_stats:party_panel_mvp_name);
} else {
    if_settext("Unavailable", tfa_stats:party_panel_mvp_name);
    if_setcolour(0xd0b088, tfa_stats:party_panel_mvp_name);
}
if_settextshadow(true, tfa_stats:party_panel_mvp_name);
~script10130;
