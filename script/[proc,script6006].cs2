// 6006
[proc,script6006](string $string0, string $string1, long $long0, long $long1)(string)
def_string $string2 = $string0;
def_string $string3 = "";
if (string_length($string0) > 0) {
    $string3 = "  ";
}
def_string $string4 = "";
if (calc(9223372036854775807 / $long1) > $long0) {
    $string4 = tostring_spacer_long(calc($long0 * $long1), ",");
} else {
    $string4 = "Lots!";
}
$string0 = "<$string0><$string3><$string1> <"<col=ef1020>"><$string4></col>";
if ($long1 > 1 & $long0 > 0) {
    $string0 = "<$string0> (<"<col=ef1020>"><tostring_spacer_long($long0, ",")></col>ea)";
}
if (string_length(removetags($string0)) < 80) {
    return($string0);
} else {
