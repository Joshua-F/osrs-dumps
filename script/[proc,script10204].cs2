// 10204
[proc,script10204](int $int0, component $component1, int $int2, int $int3, component $component4)
%displayname_input_listening = true;
if (cc_find($component1, $int3) = true & .cc_find($component1, $int2) = true) {
    ~script10205;
    .cc_setonmouserepeat(null);
    .cc_setonmouseleave(null);
    .cc_setcolour(0x372e22);
    .cc_settrans(255);
    .cc_setonclick("script10207(event_com, event_comsubid, $int3, $component4)");
    .cc_setontimer("script10206(event_com, event_comsubid, $int3, $component4)");
    .cc_setonkey("script10208(event_keycode, event_keychar, event_com, event_comsubid, $int3, $component4)");
}
if ($int0 = 1) {
    ~keyboard_show_string(0, 12, %displayname_menu_input);
}
