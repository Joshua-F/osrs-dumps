// 10221
[proc,script10221](component $component, int $int1)
def_int $int2 = string_length(%displayname_menu_input);
while ($int2 > 0 & string_indexof_string(" _-", substring(%displayname_menu_input, 0, 1), 0) ! -1) {
    %displayname_menu_input = substring(%displayname_menu_input, 1, $int2);
    $int2 = calc($int2 - 1);
}
def_int $int3 = calc($int2 - 1);
while ($int2 > 0 & string_indexof_string(" _-", substring(%displayname_menu_input, $int3, $int2), 0) ! -1) {
    %displayname_menu_input = substring(%displayname_menu_input, 0, $int3);
    $int2, $int3 = $int3, calc($int3 - 1);
}
if (cc_find($component, $int1) = true) {
    ~script10205;
}
if ($int2 > 0) {
    if ($int2 > 12) {
        %displayname_menu_input = substring(%displayname_menu_input, 0, 12);
    }
    if (compare(~script10223(removetags(chat_playername)), ~script10223(removetags(%displayname_menu_input))) ! 0) {
        displaynames_check(%displayname_menu_input);
        %displayname_menu_lookuptime, %displayname_menu_countchecks = clientclock, calc(%displayname_menu_countchecks + 1);
    } else {
        sound_synth(pillory_wrong, 1, 0);
        mes("That's your name already.");
    }
} else {
    sound_synth(pillory_wrong, 1, 0);
    mes("Please enter the name you wish to check.");
}
