// 3656
[proc,prayer_overrides](obj $obj)(int, int, int, int, boolean)
def_int $int1 = stat_base(prayer);
def_int $int2 = stat_base(attack);
def_int $int3 = stat_base(strength);
def_int $int4 = stat_base(defence);
def_int $int5 = ~script10157;
def_boolean $boolean = map_members;
if ($int5 = 1) {
    $boolean = true;
    $int1 = 99;
    $int3 = 99;
    switch_int (%br_active_build_player) {
        case default :
            $int2, $int4 = 99, 85;
        case 1 :
            $int2, $int4 = 80, 50;
        case 2 :
            $int2, $int4 = 75, 1;
    }
} else if ($int5 = 2) {
    $boolean = true;
    $int1 = ~script9971(%pvptut_active_tutorial, prayer, $int1);
    $int2 = ~script9971(%pvptut_active_tutorial, attack, $int2);
    $int3 = ~script9971(%pvptut_active_tutorial, strength, $int3);
    $int4 = ~script9971(%pvptut_active_tutorial, defence, $int4);
}
return($int1, $int2, $int3, $int4, $boolean);
