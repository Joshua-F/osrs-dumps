// 6744
[clientscript,toa_partydetails_preference_resetbutton](component $component0, int $int1, string $string0, int $int2, int $int3, int $int4)
if (clientclock < $int3) {
    return;
}
if (cc_find($component0, $int1) = true) {
    cc_setcolour(0xff981f);
    ~toa_partydetails_preference_settext($string0, $int2, $int4);
}
~toa_partydetails_preference_setactive($component0, $int1, $string0, $int2, $int4);
