// 8855
[proc,sailing_customisation_return_extra_desc_wind_catcher](dbrow $dbrow, string $string0)(string)
def_string $string1 = "";
if ($dbrow = null) {
    return("");
}
def_int $int = db_getfield($dbrow, sailing_boat_facility_stats:boat_max_wind_motes, 0);
if ($int > 0) {
    $string1 = "Max motes stored: <$string0><tostring($int)>";
}
if (string_length($string1) > 0) {
    return($string1);
}
return("");
