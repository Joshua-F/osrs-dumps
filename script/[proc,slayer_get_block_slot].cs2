// 8025
[proc,slayer_get_block_slot](int $int0, int $int1)(int)
switch_int ($int0) {
    case 1, 9 :
        return(~slayer_get_block_slot_turael($int1));
    case 2 :
        return(~slayer_get_block_slot_mazchna($int1));
    case 3 :
        return(~slayer_get_block_slot_vannaka($int1));
    case 4 :
        return(~slayer_get_block_slot_chaeldar($int1));
    case 5 :
        return(~slayer_get_block_slot_duradel($int1));
    case 6 :
        return(~slayer_get_block_slot_nieve($int1));
    case 7 :
        return(~slayer_get_block_slot_krystilia($int1));
    case 8 :
        return(~slayer_get_block_slot_konar($int1));
    case 10 :
        return(~slayer_get_block_slot_mortimer($int1));
}
return(-1);
