// 9518
[clientscript,allstar_searchbar_input_changed](component $component, int $int1, int $int2, int $int3)
if (cc_find($component, $int1) = true & ($int2 = 0 | cc_input_getfocus = true)) {
    cc_setontimer("allstar_start_search(calc(clientclock + $int3), ~string_trim(cc_gettext), cc_getlayer, cc_getid)");
}
