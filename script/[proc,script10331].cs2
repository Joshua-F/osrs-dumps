// 10331
[proc,script10331](component $component0, component $component1, component $component2)
if (%misc_rarewood_type = 0) {
    if_setgraphic("miscgraphics,11", $component0);
    if_setgraphic("miscgraphics,10", $component1);
    if_setgraphic("miscgraphics,10", $component2);
} else if (%misc_rarewood_type = 1) {
    if_setgraphic("miscgraphics,10", $component0);
    if_setgraphic("miscgraphics,11", $component1);
    if_setgraphic("miscgraphics,10", $component2);
} else {
    if_setgraphic("miscgraphics,10", $component0);
    if_setgraphic("miscgraphics,10", $component1);
    if_setgraphic("miscgraphics,11", $component2);
}
