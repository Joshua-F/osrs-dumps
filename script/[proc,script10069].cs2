// 10069
[proc,script10069](component $component, int $int1, string $string0, string $string1, int $int2, int $int3)
if_setontimer(null, $component);
if ($int1 ! -1 & ~on_mobile = false) {
    if_setonmouserepeat("cc_colour_swapper(event_com, $int1, 16757595)", $component);
    if_setonmouseleave("cc_colour_swapper(event_com, $int1, 16750623)", $component);
}
if_setop(1, $string0, $component);
if (string_length($string1) > 0) {
    if_setopbase("<col=ff9040><$string1></col>", $component);
}
if_setonop("script10070(event_op, $component, $int1, $string0, $string1, $int2, $int3)", $component);
