// 4149
[clientscript,script4149](component $border, component $content, component $item_area, component $model_view, component $colours, component $select_container, component $select_and_close, component $scroll_bar, component $thinbox)
def_component $universe = dog_selection:universe;
def_component $infinity = dog_selection:infinity;
def_enum $enum = enum_5845;
if ($infinity ! null) {
    ~script9801($universe, $infinity, ^min_32bit_int, ^min_32bit_int, $scroll_bar, $item_area, $enum);
