// 10336
[proc,quest_rating_toggle_button](component $component0, component $component1, component $component2)
if_setonvartransmit("quest_rating_toggle_update($component0, $component1, $component2, 0){questlist}", $component0);
if_setonop("quest_rating_toggle_button_press($component0, $component1, $component2)", $component0);
~quest_rating_toggle_update($component0, $component1, $component2, 0);
if (~on_mobile = false) {
    if_setonmouserepeat("quest_rating_toggle_update($component0, $component1, $component2, 1)", $component0);
    if_setonmouseleave("quest_rating_toggle_update($component0, $component1, $component2, 0)", $component0);
}
