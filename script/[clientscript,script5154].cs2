// 5154
[clientscript,script5154](int $int, boolean $boolean)
if ($int = 1) {
    if (%ge_price_custom > 0) {
        if ($boolean = true) {
            sound_synth(ge_up_amount, 1, 0);
        } else {
            sound_synth(ge_down_amount, 1, 0);
        }
    }
} else {
    sound_synth(interface_select1, 1, 0);
}
