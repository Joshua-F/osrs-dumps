// 10000
[proc,script10000](component $component, int $int1, int $int2, int $int3, graphic $graphic, int $int5, int $int6)(boolean)
if (cc_find($component, $int1) = true) {
    cc_query(2);
    if_query_refine(param_2677, $int3);
    if_query_refine(param_2676, $int2);
    if_query_refine(param_2658, 5);
    if (if_query_next = true) {
        cc_setsize($int5, $int6, ^setsize_abs, ^setsize_abs);
        cc_setgraphic($graphic);
        return(true);
    } else {
        ~debug_mes_warn("Table <tostring($int1)>", "Failed to find graphic cell at <tostring($int2)>,<tostring($int3)>");
    }
}
return(false);
