// 9367
[clientscript,talent_tree_select_node](int $int0, int $int1, dbrow $dbrow)
switch_int ($int0) {
    case 1 :
        ~talent_tree_select_node($int1, $dbrow);
    case 2 :
        ~talent_tree_deselect_node($int1, $dbrow);
}
if (%talent_tree_showing_info_panel = 1) {
    ~script8566;
}
