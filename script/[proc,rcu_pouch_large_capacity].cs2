// 3671
[proc,rcu_pouch_large_capacity]()(int)
if (%rcu_pouch_degradation_large >= 1000) {
    return(0);
}
if (%rcu_pouch_degradation_large >= 800) {
    return(3);
}
if (%rcu_pouch_degradation_large >= 600) {
    return(5);
}
if (%rcu_pouch_degradation_large >= 400) {
    return(7);
}
return(9);
