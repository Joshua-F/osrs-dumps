// 8474
[proc,ui_highlight_init_fx](component $component, int $int, dbrow $dbrow)
switch_dbtable (db_getrowtable($dbrow)) {
    case ui_highlighting_fx_pulse :
        cc_setontimer("ui_highlight_pulse($component, $int, cc_getlayer, cc_getid, db_getfield($dbrow, ui_highlighting_fx_pulse:transparency_range, 0), db_getfield($dbrow, ui_highlighting_fx_pulse:step_duration, 0), db_getfield($dbrow, ui_highlighting_fx_pulse:use_global_time, 0))");
    case ui_highlighting_fx_single_pulse :
        cc_setontimer("script10161($component, $int, cc_getlayer, cc_getid, db_getfield($dbrow, ui_highlighting_fx_single_pulse:transparency_range, 0), db_getfield($dbrow, ui_highlighting_fx_single_pulse:start_duration, 0), db_getfield($dbrow, ui_highlighting_fx_single_pulse:end_duration, 0), db_getfield($dbrow, ui_highlighting_fx_single_pulse:use_global_time, 0))");
}
