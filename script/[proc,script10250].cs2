// 10250
[proc,script10250](component $component, string $string, int $rgb, int $int2, int $int3)
def_int $int4 = 0;
cc_deleteall($component);
if ($int2 = 0) {
    $int4 = ~v2_stone_button_out_filled($component);
} else {
    $int4 = ~v2_stone_button_in_filled($component);
}
cc_create($component, ^iftype_text, $int4);
cc_setsize(0, 0, ^setsize_minus, ^setsize_minus);
cc_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_centre);
cc_setcolour($rgb);
cc_settextshadow(true);
cc_settextfont(p12_full);
cc_settextalign(^settextalign_centre, ^settextalign_centre, 0);
cc_settext($string);
if (~on_mobile = false) {
    if_setonmouserepeat("script10248($component, 1, $int3)", $component);
    if_setonmouseleave("script10248($component, 0, $int3)", $component);
}
