// 3475
[proc,gravestone_generic_parsefee](int $int)(string)
if ($int < 0) {
    return("Loading...");
}
if ($int = 0) {
    return("Fee: <col=ffffff>Paid</col>");
}
if ($int = 1) {
    return("Fee: <col=ffffff>1 coin</col>");
}
return("<int_0=<tostring($int)>>Fee: <col=ffffff><int_0:spacer> coins</col>");
