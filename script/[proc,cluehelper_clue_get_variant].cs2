// 6658
[proc,cluehelper_clue_get_variant](dbrow $dbrow)(dbrow)
switch_dbrow ($dbrow) {
    case cluehelper_anagram_medium_nieve :
        if (%mm2_slayer_master = 1) {
            return(cluehelper_anagram_medium_steve);
        } else {
            return($dbrow);
        }
}
return($dbrow);
