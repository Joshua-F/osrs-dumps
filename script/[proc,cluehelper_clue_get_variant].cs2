// 6658
[proc,cluehelper_clue_get_variant](dbrow $dbrow0)(dbrow)
switch_dbrow ($dbrow0) {
    case cluehelper_anagram_medium_nieve :
        if (%mm2_slayer_master = 1) {
            return(cluehelper_anagram_medium_steve);
        } else {
            return($dbrow0);
        }
}
return($dbrow0);
