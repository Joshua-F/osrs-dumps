// 1759
[proc,worldmap_elements_twistmarker]()(int)
if (testbit(%varplayerbit_5640, 4) = ^true) {
    return(0);
}
def_int $int0 = calc(clientclock % 40);
if ($int0 < 20) {
    return(scale(pow($int0, 2), 400, 8192));
}
$int0 = calc(40 - $int0);
return(calc(16384 - scale(pow($int0, 2), 400, 8192)));
