// 10336
[proc,script10336](component $component0, component $component1, component $component2)
if_setonvartransmit("script10338($component0, $component1, $component2, 0){questlist}", $component0);
if_setonop("script10337($component0, $component1, $component2)", $component0);
~script10339($component0, $component1, $component2, 0);
if (~on_mobile = false) {
    if_setonmouserepeat("script10338($component0, $component1, $component2, 1)", $component0);
    if_setonmouseleave("script10338($component0, $component1, $component2, 0)", $component0);
}
