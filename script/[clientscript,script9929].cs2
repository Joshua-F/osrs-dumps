// 9929
[clientscript,script9929](component $universe, component $atab, component $adisplay, component $btab, component $bdisplay, component $ctab, component $cdisplay)
switch_int (%pvptut_loadout_default_tab) {
    case 0 :
        if_sethide(false, $adisplay);
        if_sethide(true, $bdisplay);
        if_sethide(true, $cdisplay);
    case 1 :
        if_sethide(true, $adisplay);
        if_sethide(false, $bdisplay);
        if_sethide(true, $cdisplay);
    case 2 :
        if_sethide(true, $adisplay);
        if_sethide(true, $bdisplay);
        if_sethide(false, $cdisplay);
}
~script9931("<"Expert"> kit", $atab, $adisplay, "<"Intermediate"> kit", $btab, $bdisplay, "<"Combo eating"> kit", $ctab, $cdisplay);
