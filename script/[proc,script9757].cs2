// 9757
[proc,script9757]
if (~on_enhanced_any = false) {
    return;
}
def_int $int = ~script9752;
switch_int ($int) {
    case 1 :
        rt7_sd;
        rt7_setenabled(true);
    case 2 :
        rt7_hd;
        rt7_setenabled(true);
    case default :
