// 1356
[proc,questlist_qp](component $component)
def_string $string = ",";
if (~speedrunning_world = false) {
    if_settext("<int_0=<tostring(%qp)>><int_1=<tostring(%qp_max)>>Quest Points: <int_0:spacer>/<int_1:spacer>", $component);
} else {
    if_settext("<int_0=<tostring(~speedrunning_total_trophies)>>Speedrun Trophies: <int_0:spacer>", $component);
}
