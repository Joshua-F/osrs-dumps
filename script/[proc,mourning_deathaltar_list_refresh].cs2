// 8957
[proc,mourning_deathaltar_list_refresh](string $string, component $component0, component $component1, component $component2, component $component3)
def_int $int = 0;
if (string_length($string) > 0) {
    $int = calc(paraheight($string, if_getwidth($component1), p12_full) * 12 + 5);
}
if_setscrollpos(0, 0, $component1);
if ($int > if_getheight($component1)) {
    if_setscrollsize(0, $int, $component1);
} else {
    if_setscrollsize(0, 0, $component1);
}
~scrollbar_resize($component2, $component1, 0);
if_setontimer("mourning_deathaltar_list_check($string, event_com, $component1, $component2, $component3)", $component0);
