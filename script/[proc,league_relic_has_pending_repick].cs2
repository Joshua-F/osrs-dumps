// 7695
[proc,league_relic_has_pending_repick]()(boolean)
if (calc(%league_relic_repick_0 + %league_relic_repick_1 + %league_relic_repick_2 + %league_relic_repick_3 + %league_relic_repick_4 + %league_relic_repick_5 + %league_relic_repick_6 + %league_relic_repick_7) > 0) {
    return(true);
}
return(false);
