// 6169
[clientscript,pvpa_legacyduel_optionbuttons_init](component $option_buttons)
~pvpa_legacyduel_optionbutton_init(4, "No Ranged", pvp_arena_legacyduel_options:option_ranged, "Neither player is allowed to use ranged attacks.");
~pvpa_legacyduel_optionbutton_init(5, "No Melee", pvp_arena_legacyduel_options:option_melee, "Neither player is allowed to use melee attacks.");
~pvpa_legacyduel_optionbutton_init(6, "No Magic", pvp_arena_legacyduel_options:option_magic, "Neither player is allowed to use magic attacks.");
~pvpa_legacyduel_optionbutton_init(13, "No Special Attacks", pvp_arena_legacyduel_options:option_specialattacks, "Neither player is allowed to use special attacks.");
~pvpa_legacyduel_optionbutton_init(12, "Fun Weapons", pvp_arena_legacyduel_options:option_funweapons, "Both players must use a 'fun weapon', such as flowers or a rubber chicken.");
~pvpa_legacyduel_optionbutton_init(0, "No Forfeit", pvp_arena_legacyduel_options:option_forfeit, "Neither player is allowed to forfeit the duel.");
~pvpa_legacyduel_optionbutton_init(9, "No Prayer", pvp_arena_legacyduel_options:option_prayer, "Neither player is allowed to use prayer.");
~pvpa_legacyduel_optionbutton_init(7, "No Drinks", pvp_arena_legacyduel_options:option_potions, "Neither player is allowed to use drinks.");
~pvpa_legacyduel_optionbutton_init(8, "No Food", pvp_arena_legacyduel_options:option_food, "Neither player is allowed to use food.");
~pvpa_legacyduel_optionbutton_init(1, "No Movement", pvp_arena_legacyduel_options:option_movement, "Players stand next to each other and aren't allowed to move or use hold spells.");
~pvpa_legacyduel_optionbutton_init(2, "No Weapon Switch", pvp_arena_legacyduel_options:option_noswitch, "Neither player is allowed to swap their weapons during the duel.");
~pvpa_legacyduel_optionbutton_init(3, "Show Inventories", pvp_arena_legacyduel_options:option_showinv, "Show your opponent your worn and back pack inventory, and view theirs.");
~pvpa_legacyduel_options_radio_buttons;
if_setonvartransmit("pvpa_legacyduel_options_radio_buttons{dueloptions}", $option_buttons);
