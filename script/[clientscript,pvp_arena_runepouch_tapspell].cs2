// 6428
[clientscript,pvp_arena_runepouch_tapspell](component $component, int $int, obj $obj2, obj $obj3, obj $obj4)
sound_synth(interface_select1, 1, 0);
if (%magic_spellbook_tooltip = $obj2) {
    cc_deleteall(pvp_arena_runepouch:tooltip);
    if_setontimer(null, pvp_arena_runepouch:tooltip);
    %magic_spellbook_tooltip = null;
} else {
    %magic_spellbook_tooltip = $obj2;
    ~magic_spellbook_settooltip(true, $obj2, $component, $int, pvp_arena_runepouch:tooltip, calc(if_getheight($component) - 5), $obj3, $obj4);
    if_setontimer("pvp_arena_runepouch_resetspell(calc(clientclock + 125), event_com)", pvp_arena_runepouch:tooltip);
}
