// 237
[proc,autocast_spellhighlight](obj $obj)
if (stat(magic) >= oc_param($obj, param_604) & ~magic_spellbook_hasrunes($obj, inv_getobj(worn, 3), inv_getobj(worn, 5)) = true) {
    cc_setgraphic(~magic_spellbook_get_icon($obj, -1, true));
} else {
    cc_setgraphic(~magic_spellbook_get_icon($obj, -1, false));
}
