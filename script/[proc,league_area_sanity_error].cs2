// 9474
[proc,league_area_sanity_error](int $int0, int $int1, int $int2)
if (~rental_world = true & inv_total(inv, league_tomato) > 0) {
    ~debug_mes("<str_region_0=<~get_region_name($int1)>><str_region_1=<~get_region_name($int2)>>Would error as your area: <tostring($int0)> is <str_region_0> (<tostring($int1)>), but we should be forcing <str_region_1> (<tostring($int2)>) - We assume you are debugging.");
} else {
    ~error("<str_region_0=<~get_region_name($int1)>><str_region_1=<~get_region_name($int2)>>Player <name>, managed to get their region selection: <tostring($int0)> is <str_region_0> (<tostring($int1)>), but we should be forcing <str_region_1> (<tostring($int2)>), We need to fix this.");
}
