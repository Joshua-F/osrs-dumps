// 3437
[proc,myq5_update_tile_status](int $int0)(int)
def_int $int1 = ~myq5_get_tile_status($int0);
def_int $int2 = -1;
if ($int1 = 0) {
    $int2 = ~myq5_set_tile_status($int0, 2);
} else if ($int1 = 2) {
    $int2 = ~myq5_set_tile_status($int0, 1);
} else if ($int1 = 1) {
    $int2 = ~myq5_set_tile_status($int0, 0);
}
return($int2);
