// 6004
[proc,examine_item](obj $obj, long $long0, string $string, boolean $boolean1, long $long1, boolean $boolean2, long $long2, long $long3)
if ($long0 >= 100000) {
    mes("<tostring_spacer_long($long0, ",")> x <oc_name($obj)>.");
    ~examine_price_info($obj, $long0, 0, $boolean1, $long1, $boolean2, $long2, $long3);
} else {
    mes($string);
    ~examine_price_info($obj, $long0, 1, $boolean1, $long1, $boolean2, $long2, $long3);
}
