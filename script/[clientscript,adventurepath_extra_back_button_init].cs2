// 3013
[clientscript,adventurepath_extra_back_button_init](component $component0, component $component1, component $component2, component $component3, component $component4)
~v2_stone_button_out_filled($component1);
if_setonmouseleave("adventurepath_extra_back_button_leave($component1)", $component1);
if_setonmouserepeat("adventurepath_extra_back_button_repeat($component1)", $component1);
if_setonop("adventurepath_extra_back_button_onop($component0, $component2, $component3, $component4, $component1)", $component1);
if_setop(1, "Back", $component1);
~adventurepath_extra_back_button_text($component1, 9);
