// 3013
[clientscript,adventurepath_extra_back_button_init](component $extra_task_info, component $extra_back_button, component $task_list, component $path_menu, component $banner)
~v2_stone_button_out_filled($extra_back_button);
if_setonmouseleave("adventurepath_extra_back_button_leave($extra_back_button)", $extra_back_button);
if_setonmouserepeat("adventurepath_extra_back_button_repeat($extra_back_button)", $extra_back_button);
if_setonop("adventurepath_extra_back_button_onop($extra_task_info, $task_list, $path_menu, $banner, $extra_back_button)", $extra_back_button);
if_setop(1, "Back", $extra_back_button);
~adventurepath_extra_back_button_text($extra_back_button, 9);
