// 6041
[clientscript,bcs_burner_meter_change](component $component0, component $component1, component $component2, component $component3, component $component4, int $int5, int $int6, int $int7, int $int8, boolean $boolean9)
if (~bcs_burner_meter_check = true) {
    ~bcs_burner_update($component0, $component1, $component2, $component3, $component4);
    return;
}
if (~bcs_burner_meter_get($int8) <= 0 & $boolean9 = false | ~bcs_burner_meter_get($int8) >= 45 & $boolean9 = true) {
    sound_synth(synth_5598, 1, 0);
    return;
}
%bcs_burner_1 = ~minmax(0, 45, calc(%bcs_burner_1 + $int5));
%bcs_burner_2 = ~minmax(0, 45, calc(%bcs_burner_2 + $int6));
%bcs_burner_3 = ~minmax(0, 45, calc(%bcs_burner_3 + $int7));
sound_synth(synth_2595, 1, 0);
~bcs_burner_update($component0, $component1, $component2, $component3, $component4);
