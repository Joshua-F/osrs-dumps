// 9306
[proc,music_playlist_remove_track](int $int, dbrow $dbrow)(boolean)
switch_int (%music_current_playlist) {
    case 1 :
        return(~music_playlist_1_remove_track($dbrow));
    case 2 :
        return(~music_playlist_2_remove_track($dbrow));
    case 3 :
        return(~music_playlist_3_remove_track($dbrow));
}
return(false);
