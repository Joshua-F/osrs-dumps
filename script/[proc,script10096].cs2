// 10096
[proc,script10096](int $int0, component $component1, int $int2, string $string, component $component3)
def_int $rgb = ^black;
def_int $int5 = 228;
if (calc($int0 % 2) = 0) {
    $rgb, $int5 = ^black, 242;
}
cc_setcolour($rgb);
cc_settrans($int5);
if (~on_mobile = false) {
    if_setonmouserepeat("xpdrops_setup_skilllist_mouseover(event_com, cc_getid, ^black, 210)", $component1);
    if_setonmouseleave("xpdrops_setup_skilllist_mouseover(event_com, cc_getid, $rgb, $int5)", $component1);
}
if_setonop("script10097(event_op, event_com, cc_getid, $rgb, $int5, ^black, 210, $int2, $string, $component3)", $component1);
if_setontimer(null, $component1);
