// 5023
[clientscript,dizanas_quiver_worn_init](component $component0, component $component1, component $component2)
if_sethide(true, $component0);
if_setop(1, "", $component1);
if_setop(2, "", $component1);
if_setop(10, "", $component1);
if (map_members = false) {
    return;
}
if_sethide(false, $component0);
~dizanas_quiver_worn_ammo_draw($component2, $component1);
if_setoninvtransmit("dizanas_quiver_worn_ammo_draw($component2, $component1){inv, worn}", $component0);
if_setonvartransmit("dizanas_quiver_worn_ammo_draw($component2, $component1){dizanas_quiver_temp_ammo_amount, dizanas_quiver_temp_ammo}", $component0);
