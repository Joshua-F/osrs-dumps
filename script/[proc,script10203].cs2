// 10203
[proc,script10203](component $component, int $int1, int $int2)
%displayname_input_listening = false;
if (cc_find($component, $int2) = true & .cc_find($component, $int1) = true) {
    cc_setcolour(0x9f9f9f);
    cc_settextfont(b12_full);
    if (string_length(%displayname_menu_input) > 0) {
        cc_settext(%displayname_menu_input);
    } else {
        cc_settext("---");
    }
    .cc_setonmouserepeat(null);
    .cc_setonmouseleave(null);
    .cc_setcolour(0x372e22);
    .cc_settrans(255);
    .cc_setonclick(null);
    .cc_setontimer(null);
    .cc_setonkey(null);
}
