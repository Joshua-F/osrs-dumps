// 9967
[proc,pvptut_ui_draw_tutorial_content](dbrow $dbrow, component $component, graphic $graphic2, int $int3, int $int4, int $int5, int $int6, graphic $graphic7, fontmetrics $fontmetrics, int $int9)(int)
switch_dbrow ($dbrow) {
    case pvptut_prayer :
        return(~pvptut_prayer_ui_draw_content($dbrow, $component, $graphic2, $int3, $int4, $int5, $int6, $graphic7, $fontmetrics, $int9));
    case pvptut_freeze :
        return(~pvptut_freeze_ui_draw_content($dbrow, $component, $graphic2, $int3, $int4, $int5, $int6, $graphic7, $fontmetrics, $int9));
    case pvptut_special_attack :
        return(~pvptut_special_attack_ui_draw_content($dbrow, $component, $graphic2, $int3, $int4, $int5, $int6, $graphic7, $fontmetrics, $int9));
    case pvptut_gear_switch :
        return(~pvptut_gear_switch_ui_draw_content($dbrow, $component, $graphic2, $int3, $int4, $int5, $int6, $graphic7, $fontmetrics, $int9));
    case pvptut_combo_eating :
        return(~pvptut_combo_eating_ui_draw_content($dbrow, $component, $graphic2, $int3, $int4, $int5, $int6, $graphic7, $fontmetrics, $int9));
    case pvptut_vengeance :
        return(~pvptut_vengeance_ui_draw_content($dbrow, $component, $graphic2, $int3, $int4, $int5, $int6, $graphic7, $fontmetrics, $int9));
    case pvptut_boss_medium :
        return(~pvptut_boss_medium_ui_draw_content($dbrow, $component, $graphic2, $int3, $int4, $int5, $int6, $graphic7, $fontmetrics, $int9));
    case pvptut_boss_expert :
        return(~pvptut_boss_expert_ui_draw_content($dbrow, $component, $graphic2, $int3, $int4, $int5, $int6, $graphic7, $fontmetrics, $int9));
}
return(0);
