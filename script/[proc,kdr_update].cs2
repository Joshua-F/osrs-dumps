// 2874
[proc,kdr_update]
def_string $string = ",";
def_int $int0 = 0;
def_int $int1 = 0;
def_int $int2 = 0;
if (%kd_toggle = 0 | %inside_wilderness = 0 & ~script2871 = false) {
    cc_settext("");
} else if (~deadman_world ! 0 & %deadman_protection_left > 0) {
    cc_settext("");
} else if (%kdr_transmit_deaths = 0) {
    cc_settext("<int_0=<tostring(%kdr_transmit_kills)>><int_kd=<tostring(0)>>Kills: <int_0:spacer><br>Deaths: 0<br>K/D Ratio: <int_kd:spacer_1_z>");
} else {
    if (calc(%kdr_transmit_kills / %kdr_transmit_deaths) < calc(^max_32bit_int / 10)) {
        $int0 = scale(%kdr_transmit_kills, %kdr_transmit_deaths, 10);
    } else {
        $int0 = ~script9914(long_scale(int_to_long(%kdr_transmit_kills), int_to_long(%kdr_transmit_deaths), 10));
    }
    cc_settext("<int_0=<tostring(%kdr_transmit_kills)>><int_1=<tostring(%kdr_transmit_deaths)>><int_kd=<tostring($int0)>>Kills: <int_0:spacer><br>Deaths: <int_1:spacer><br>K/D Ratio: <int_kd:spacer_1_z>");
}
