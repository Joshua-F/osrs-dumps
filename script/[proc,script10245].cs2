// 10245
[proc,script10245](component $component)
cc_deleteall($component);
cc_create($component, ^iftype_text, 0);
cc_setsize(8, 4, ^setsize_minus, ^setsize_minus);
cc_setposition(4, 2, ^setpos_abs_centre, ^setpos_abs_centre);
cc_settextshadow(true);
cc_settextfont(p12_full);
cc_settextalign(^settextalign_left, ^settextalign_top, 15);
cc_setcolour(0xffa82f);
def_string $string = "";
if (%hc_death_option = 1) {
    if (map_members = true) {
        $string = "Reset character - Retain your <"Hardcore player"> status<br><br>By choosing to reset, you will keep your status as <a> <"Hardcore player">.<br>You will lose all your items, quest progress and experience.<br>Your hiscores will be reset.<br><br>Your character will be set up as if it were a brand new character.<br>Reset count: <tostring(%hc_reset_count)>";
    } else {
        $string = "Reset character - Retain your <"Hardcore player"> status<br><br>By choosing to reset, you will keep your status as <a> <"Hardcore player">.<br>You will lose all your items, quest progress and experience.<br>Your hiscores will be reset.<br><br>Your character will be set up as if it were a brand new character.<br>Reset count: <tostring(%hc_reset_count)><br><br><"Hardcore Mode"> is only available on members servers.";
    }
} else if (%hc_death_option = 2) {
    $string = "Transfer character - Continue as a <"Non-hardcore player"><br><br>By choosing to transfer, you will lose your <"Hardcore"> status and continue with an unrestricted ruleset.<br><br>You will keep all items still on your person, as well as in your bank and other storages.<br>All progress such as quests and achievement diaries transfer over.<br><br>You keep your stats and all other progress on your character.";
} else {
    $string = "Pick an option to read more about it.";
    cc_settextalign(^settextalign_centre, ^settextalign_centre, 15);
}
cc_settext($string);
