// 8264
[proc,script8264](int $int)(int)
switch_int (~bingo_get_grid_layout($int)) {
    case default :
        return(0);
    case 1 :
        return(~script8262(3));
    case 2 :
        return(~script8262(4));
    case 3 :
        return(~script8262(5));
    case 4, 5 :
        return(~script8262(7));
}
