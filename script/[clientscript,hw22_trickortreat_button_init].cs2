// 6921
[clientscript,hw22_trickortreat_button_init](component $component)
~v2_stone_button_filled($component);
if (~on_mobile = false) {
    if_setonmouserepeat("hw22_trickortreat_button_setstate(true, false, $component)", $component);
}
if_setonmouseleave("hw22_trickortreat_button_setstate(false, false, $component)", $component);
if_setonhold("hw22_trickortreat_button_setstate(false, true, $component)", $component);
if_setonrelease("hw22_trickortreat_button_setstate(true, false, $component)", $component);
