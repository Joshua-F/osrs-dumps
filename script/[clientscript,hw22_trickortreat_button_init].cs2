// 6921
[clientscript,hw22_trickortreat_button_init](component $component0)
~v2_stone_button_filled($component0);
if (~on_mobile = false) {
    if_setonmouserepeat("hw22_trickortreat_button_setstate(true, false, $component0)", $component0);
}
if_setonmouseleave("hw22_trickortreat_button_setstate(false, false, $component0)", $component0);
if_setonhold("hw22_trickortreat_button_setstate(false, true, $component0)", $component0);
if_setonrelease("hw22_trickortreat_button_setstate(true, false, $component0)", $component0);
