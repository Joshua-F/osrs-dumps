// 9406
[proc,league_task_override_name](dbrow $dbrow)(string)
def_string $string = db_getfield($dbrow, action:action_name, 0);
if (cc_find_param(league_tasks:task_hotfix, param_678, $dbrow) = true & string_length(cc_param(param_2579)) > 0) {
    return(cc_param(param_2579));
}
return($string);
