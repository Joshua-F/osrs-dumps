// 1132
[clientscript,trawler_camshake_init](component $noshake, component $background)
if_setnoclickthrough(true, $background);
if_setonclick("opsound(0, 0)", $background);
if_setopbase("<col=ff8040>Camera motion</col>", $noshake);
~trawler_camshake_set($noshake, $background);
if_setonvartransmit("trawler_camshake_set($noshake, $background){musicloop}", $noshake);
