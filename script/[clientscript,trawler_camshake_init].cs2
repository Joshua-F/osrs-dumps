// 1132
[clientscript,trawler_camshake_init](component $component0, component $component1)
if_setnoclickthrough(true, $component1);
if_setonclick("opsound(0, 0)", $component1);
if_setopbase("<col=ff8040>Camera motion</col>", $component0);
~trawler_camshake_set($component0, $component1);
if_setonvartransmit("trawler_camshake_set($component0, $component1){varplayer_19}", $component0);
