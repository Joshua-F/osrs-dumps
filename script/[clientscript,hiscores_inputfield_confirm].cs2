// 7527
[clientscript,hiscores_inputfield_confirm](component $component, int $int)
def_string $string = "";
if ($int ! -1 & cc_find($component, $int) = true) {
    $string = removetags(cc_gettext);
    %hiscores_queue_lookup = $string;
    ~hiscores_request_data($string, %hiscores_type);
}
return;
