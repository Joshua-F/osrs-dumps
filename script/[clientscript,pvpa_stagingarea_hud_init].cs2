// 6256
[clientscript,pvpa_stagingarea_hud_init](component $universe, component $dodger, component $contents, component $timer, component $hint)
~interface_dodger_init($dodger, $contents, 52968, ^setpos_abs_centre, ^setpos_abs_top, false);
~pvpa_stagingarea_hud_drawtimer($timer);
if_setonvartransmit("pvpa_stagingarea_hud_drawtimer(event_com){pvpa_temp_transmit_0}", $timer);
~pvpa_stagingarea_hud_drawhint($hint);
if_setonvartransmit("pvpa_stagingarea_hud_drawhint(event_com){pvpa_temp_transmit_0}", $hint);
