// 10218
[proc,displayname_menu_button_op](component $component, string $string, graphic $graphic, obj $obj, int $int)
sound_synth(interface_select1, 1, 0);
~displayname_menu_button_draw(1, $string, $graphic, $obj, $component);
if_setonmouserepeat(null, $component);
if_setonmouseleave(null, $component);
if_setontimer("displayname_menu_button_reset(calc(clientclock + 30), $string, event_com, $graphic, $obj, $int)", $component);
