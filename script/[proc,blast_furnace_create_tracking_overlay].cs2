// 6671
[proc,blast_furnace_create_tracking_overlay]
~blast_furnace_highlights;
def_entityoverlay $entityoverlay = entityoverlay_create_loc(4, ^overlaytype_middle, 1, 1, 1);
if (if_find_entityoverlay($entityoverlay) = true) {
    cc_setonvartransmit("blast_furnace_highlights{blast_furnace_readings}");
    cc_setoninvtransmit("blast_furnace_highlights{inv, worn}");
}
