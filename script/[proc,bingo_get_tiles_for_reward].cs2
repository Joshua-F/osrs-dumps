// 8268
[proc,bingo_get_tiles_for_reward](int $int0, int $int1)(intarray)
def_intarray $intarray = array_create(int, 0, 7);
def_int $int2 = 0;
switch_int (~bingo_get_grid_layout($int0)) {
    case 1 :
        ~script8269($intarray, 3, $int1);
    case 2 :
        ~script8269($intarray, 4, $int1);
    case 3 :
        ~script8269($intarray, 5, $int1);
    case 4 :
        ~script8269($intarray, 7, $int1);
    case 5 :
        $int2 = ~bingo_get_num_line_rewards_per_square(7);
        if ($int1 < $int2) {
            ~script8269($intarray, 7, $int1);
        } else if ($int1 < calc($int2 + ~bingo_get_num_tiles_per_square(7))) {
            array_push($intarray, calc($int1 - $int2));
        }
}
return($intarray);
