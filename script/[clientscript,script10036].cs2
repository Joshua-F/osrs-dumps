// 10036
[clientscript,script10036](int $int0, int $int1)
if ($int0 = -1) {
    if_setontimer(null, tfa_hud:raid_timer);
    if_settext("-", tfa_hud:raid_timer);
} else {
    $int0 = calc($int0 * 30 - clientclock);
    if ($int1 = 1) {
        ~script10038(tfa_hud:raid_timer, $int0, %option_precise_timing, %option_separate_hours);
        if_setontimer(null, tfa_hud:raid_timer);
    } else {
        if_setontimer("script10037(tfa_hud:raid_timer, $int0, %option_precise_timing, %option_separate_hours)", tfa_hud:raid_timer);
    }
}
