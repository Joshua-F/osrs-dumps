// 10062
[proc,script10062]
def_string $string0 = "Members";
if (%raids_count_2 > 0) {
    $string0 = "<$string0> (<tostring(%raids_count_2)>)";
}
def_int $int = calc(%raids_count - 8);
def_string $string1 = "Applicants";
if ($int > 0) {
    $string1 = "<$string1> (<tostring($int)>)";
}
~script3723(tfa_partydetails:members_tab, 0, $string0);
~script3723(tfa_partydetails:applicants_tab, 0, $string1);
