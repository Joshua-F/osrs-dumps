// 7186
[clientscript,loottracker_ui_switch_value_mode]
switch_int (%varplayerbit_14881) {
    case 0 :
        %varplayerbit_14881 = 1;
    case 1 :
        %varplayerbit_14881 = 0;
    case default :
        %varplayerbit_14881 = 0;
}
~loottracker_ui_sync_value_mode;
~loottracker_ui_redraw_display_full;
