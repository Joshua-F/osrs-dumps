// 9985
[clientscript,script9985](component $component, int $int1)
def_int $int2 = 0;
if ($int1 = -1 & if_find($component) = true | cc_find($component, $int1) = true) {
    $int2 = cc_param(param_2663);
} else {
    return;
}
if (cc_find($component, calc($int2 + 1)) = true) {
    cc_dragpickup(0, calc(cc_getwidth / 2));
}
if (cc_find($component, 1) = true) {
    cc_dragpickup(calc(cc_getwidth / 2), 0);
}
