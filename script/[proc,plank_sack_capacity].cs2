// 9135
[proc,plank_sack_capacity]()(int)
def_int $int = 28;
$int = calc($int - ~plank_sack_contents(woodplank));
$int = calc($int - ~plank_sack_contents(plank_oak));
$int = calc($int - ~plank_sack_contents(plank_teak));
$int = calc($int - ~plank_sack_contents(plank_mahogany));
$int = calc($int - ~plank_sack_contents(plank_camphor));
$int = calc($int - ~plank_sack_contents(plank_ironwood));
$int = calc($int - ~plank_sack_contents(plank_rosewood));
return(max(0, $int));
