// 2094
[proc,lunar_contact_npc_draw](component $component)
cc_deleteall($component);
def_int $int1 = db_listall(npc_contact);
def_int $int2 = 1;
def_dbrow $dbrow = db_findnext;
def_string $string = "";
def_model $model = null;
def_int $int5 = -1;
def_int $int6 = -1;
def_int $int7 = 65;
def_int $int8 = 125;
def_int $int9 = 35;
def_int $int10 = 0;
def_int $int11 = 0;
def_int $int12 = 0;
def_int $int13 = 0;
while ($dbrow ! null) {
    $string, $model, $int5, $int6, $int13 = ~script9733($dbrow);
    cc_create($component, ^iftype_layer, $int12);
    cc_setsize($int7, $int8, ^setsize_abs, ^setsize_abs);
    cc_setposition($int10, $int11, ^setpos_abs_left, ^setpos_abs_top);
    cc_setonmouseover("script9730($component, $int12)");
    cc_setonmouseleave("script9731($component, $int12)");
    cc_setop(1, "Contact <col=ff981f><$string>");
    cc_setonop("script9732($int13, event_op)");
    ~script9734($int13);
    $int12 = calc($int12 + 1);
    cc_create_child(^iftype_model, $int12);
    cc_setsize(0, 0, ^setsize_minus, ^setsize_minus);
    cc_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_centre);
    cc_setmodel($model);
    cc_setmodelangle(0, 0, 0, $int6, 0, $int5);
    $int12 = calc($int12 + 1);
    cc_create_sibling(^iftype_text, $int12);
    cc_setsize($int7, $int9, ^setsize_abs, ^setsize_abs);
    cc_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_bottom);
    cc_settext($string);
    cc_settextfont(p12_full);
    cc_settextshadow(true);
    cc_settextalign(^settextalign_centre, ^settextalign_centre, 0);
    cc_setcolour(0xff981f);
    $int12 = calc($int12 + 1);
    if (calc($int2 % 7) = 0) {
        $int10 = 0;
        $int11 = calc($int11 + 125);
    } else {
        $int10 = calc($int10 + 67);
    }
    $dbrow = db_findnext;
    $int2 = calc($int2 + 1);
}
