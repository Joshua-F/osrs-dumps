// 1324
[proc,motherlode_hud_paydirt_item](obj $obj)(boolean)
switch_obj ($obj) {
    case runite_ore, adamantite_ore, mithril_ore, gold_ore, coal :
        return(true);
    case motherlode_nugget :
        return(true);
    case paydirt :
        return(true);
    case default :
        return(false);
}
