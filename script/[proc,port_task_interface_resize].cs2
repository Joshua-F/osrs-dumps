// 8932
[proc,port_task_interface_resize](component $component0, component $component1, component $component2)
switch_int (%responsive_current_breakpoint) {
    case 2, 3 :
        if_setsize(720, 470, ^setsize_abs, ^setsize_abs, $component0);
    case default :
        if_setsize(600, 392, ^setsize_abs, ^setsize_abs, $component0);
}
~port_task_interface_content_resize($component1, $component2);
