// 10310
[proc,script10310](dbrow $dbrow)(int)
if (db_getrowtable($dbrow) ! hiscores_bosses_info) {
    ~script2075("Dbrow of the wrong type provided in ca_get_boss_kc");
    return(-1);
}
switch_dbrow ($dbrow) {
    case default :
        ~script2075("<db_getfield($dbrow, hiscores_bosses_info:bossname, 0)> boss dbrow passed into ca_get_boss_kc but case is unimplemented.");
    case hiscores_bosses_abyssal_sire :
        return(%total_abyssalsire_kills);
    case hiscores_bosses_alchemical_hydra :
        return(%total_hydraboss_kills);
    case hiscores_bosses_amoxliatl :
        return(%total_amoxliatl_kills);
