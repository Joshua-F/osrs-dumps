// 408
[proc,slayer_rewards_tab](component $component0, component $component1, component $component2, string $string, int $int3, int $int4, component $component5, component $component6, component $component7, component $component8, component $component9, component $component10)(int, int)
cc_create($component1, ^iftype_graphic, $int3);
.cc_create($component1, ^iftype_text, calc($int3 + 1));
cc_setsize(65, 22, ^setsize_abs, ^setsize_abs);
.cc_setsize(65, 22, ^setsize_abs, ^setsize_abs);
cc_setposition($int4, 0, ^setpos_abs_left, ^setpos_abs_top);
.cc_setposition($int4, 0, ^setpos_abs_left, ^setpos_abs_top);
.cc_settextfont(p11_full);
.cc_settextalign(^settextalign_centre, ^settextalign_centre, 0);
.cc_setcolour(0xff981f);
.cc_settextshadow(true);
.cc_settext($string);
if ($component2 ! $component10) {
    cc_setgraphic("combatboxesmed,0");
    cc_setonmouseover("cc_colour_swapper(event_com, .cc_getid, 16777215)");
    cc_setonmouseleave("cc_colour_swapper(event_com, .cc_getid, 16750623)");
    cc_setop(1, $string);
    cc_setonop("slayer_rewards_tabs($component0, $component1, $component5, $component6, $component7, $component8, $component9, $component2)");
} else {
    cc_setgraphic("combatboxesmed,1");
}
return(calc($int3 + 2), calc($int4 + 66));
