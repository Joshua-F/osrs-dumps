// 4492
[proc,tob_scoreboard_tab_update](component $component0, component $component1, component $component2)
~tab_modal_short_draw($component1, 0, "Normal");
~tab_modal_short_draw($component0, 0, "Entry");
~tab_modal_short_draw($component2, 0, "Hard");
switch_int (%varplayerbit_12270) {
    case 1 :
        ~tab_modal_short_draw($component0, 1, "Entry");
    case 2 :
        ~tab_modal_short_draw($component2, 1, "Hard");
    case default :
        ~tab_modal_short_draw($component1, 1, "Normal");
}
