// 9373
[proc,script9373](dbrow $dbrow)
def_component $tree_node_draw_layer = talent_tree:tree_node_draw_layer;
if (.cc_find($tree_node_draw_layer, cc_param(param_2552)) = true) {
    .cc_setgraphic(~talent_tree_get_node_background($dbrow, cc_param(param_2551)));
}
if (.cc_find($tree_node_draw_layer, cc_param(param_2553)) = true) {
    .cc_setgraphic(~talent_tree_get_node_graphic($dbrow, cc_param(param_2551)));
}
