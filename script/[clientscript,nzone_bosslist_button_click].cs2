// 1249
[clientscript,nzone_bosslist_button_click](component $component0, string $string0)
sound_synth(synth_2266, 1, 0);
~nzone_bosslist_button_set(true, $component0, "---");
if_setonmouseover(null, $component0);
if_setonmouseleave(null, $component0);
if_setonclick(null, $component0);
if_setontimer("nzone_bosslist_button_reset(calc(clientclock + 60), $component0, $string0)", $component0);
