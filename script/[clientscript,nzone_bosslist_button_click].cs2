// 1249
[clientscript,nzone_bosslist_button_click](component $component, string $string)
sound_synth(synth_2266, 1, 0);
~nzone_bosslist_button_set(true, $component, "---");
if_setonmouseover(null, $component);
if_setonmouseleave(null, $component);
if_setonclick(null, $component);
if_setontimer("nzone_bosslist_button_reset(calc(clientclock + 60), $component, $string)", $component);
