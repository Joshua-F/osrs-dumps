// 1429
[clientscript,bankmenu_depositworn_toggle_op](int $int0, component $component, int $int2)
if ($int0 ! 1) {
    return;
}
if (cc_find($component, $int2) = true) {
    sound_synth(synth_2266, 1, 0);
    %bank_hidedepositworn = calc(1 - %bank_hidedepositworn);
    ~bankmenu_depositworn_toggle_set($component);
}
