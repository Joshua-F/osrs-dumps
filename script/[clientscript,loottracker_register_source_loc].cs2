// 7193
[clientscript,loottracker_register_source_loc](loc $loc0, int $int1, int $int2, int $int3)
def_string $string0 = removetags(lc_name($loc0));
if (string_length($string0) = 0) {
    return;
}
loottracker_sourceadd($string0, $int2, $int3, $int1);
~loottracker_ui_update_with_source($string0, 1, $int1);
