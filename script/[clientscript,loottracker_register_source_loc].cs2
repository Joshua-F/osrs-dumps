// 7193
[clientscript,loottracker_register_source_loc](loc $loc, int $int1, int $int2, int $int3)
def_string $string = removetags(lc_name($loc));
if (string_length($string) = 0) {
    return;
}
loottracker_sourceadd($string, $int2, $int3, $int1);
~loottracker_ui_update_with_source($string, 1, $int1);
