[proc,sailing_boat_get_name_var_whole](int $int)(int)
switch_int ($int) {
    case 1 :
        return(%sailing_boat_1_name);
    case 2 :
        return(%sailing_boat_2_name);
    case 3 :
        return(%sailing_boat_3_name);
    case 4 :
        return(%sailing_boat_4_name);
    case 5 :
        return(%sailing_boat_5_name);
}
return(0);
