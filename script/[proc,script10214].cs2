// 10214
[proc,script10214](string $string, graphic $graphic, obj $obj, component $component, int $int)
~script10215(0, $string, $graphic, $obj, $component);
if (~on_mobile = false) {
    if_setonmouserepeat("script10216(1, $string, event_com, $graphic, $obj, $int)", $component);
}
if_setonmouseleave("script10216(0, $string, event_com, $graphic, $obj, $int)", $component);
if_setop(1, removetags(~string_findandreplace($string, "<br>", " ")), $component);
if_setontimer(null, $component);
