// 9972
[proc,script9972](dbrow $dbrow)(boolean)
switch_dbrow ($dbrow) {
    case pvptut_prayer :
        return(~int_to_bool(%pvptut_prayer_complete));
    case pvptut_freeze :
        return(~int_to_bool(%pvptut_freeze_complete));
    case pvptut_special_attack :
        return(~int_to_bool(%pvptut_special_attack_complete));
    case pvptut_gear_switch :
        return(~int_to_bool(%pvptut_gear_switch_complete));
    case pvptut_combo_eating :
        return(~int_to_bool(%pvptut_combo_eating_complete));
    case pvptut_boss_medium :
        return(~int_to_bool(%pvptut_boss_medium_complete));
    case pvptut_boss_expert :
        return(~int_to_bool(%pvptut_boss_expert_complete));
}
return(false);
