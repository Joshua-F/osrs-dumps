// 5975
[clientscript,farm_btn_up](component $farm_bar, component $farm_bar_fill)
if (~script10318 = false) {
    return;
}
if (%if1 <= 0) {
    return;
}
if (%misc_points_farm >= 10) {
    return;
}
%misc_points_farm = calc(%misc_points_farm + 1);
%if1 = calc(%if1 - 1);
~kingdom_fill_bar_level(%misc_points_farm, $farm_bar, $farm_bar_fill);
