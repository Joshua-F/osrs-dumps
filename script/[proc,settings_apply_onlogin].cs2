// 4618
[proc,settings_apply_onlogin]
~settings_apply_remove_roof;
if (~on_enhanced_any = false) {
    return;
}
setgameoption(^gameoption_haptic_on_op, calc(1 - %option_haptic_on_op_disabled));
setgameoption(^gameoption_haptic_on_drag, calc(1 - %option_haptic_on_drag_disabled));
setgameoption(^gameoption_haptic_on_minimenu_open, calc(1 - %option_haptic_on_minimenu_open_disabled));
setgameoption(^gameoption_haptic_on_minimenu_entry_hover, %option_haptic_on_minimenu_entry_hover_enabled);
setgameoption(^gameoption_minimenu_long_press_time, %option_minimenu_long_press_time);
~settings_chat_timestamps;
setdeviceoption(^deviceoption_is_sfx_8_bit, 0);
