// 4618
[proc,settings_apply_onlogin]
setgameoption(^gameoption_remove_roof, %varplayerbit_12378);
if (~on_enhanced_any = false) {
    return;
}
setgameoption(^gameoption_haptic_on_op, calc(1 - %varplayerbit_13831));
setgameoption(^gameoption_haptic_on_drag, calc(1 - %varplayerbit_13832));
setgameoption(^gameoption_haptic_on_minimenu_open, calc(1 - %varplayerbit_13833));
setgameoption(^gameoption_haptic_on_minimenu_entry_hover, %varplayerbit_13834);
setgameoption(^gameoption_minimenu_long_press_time, %varplayerbit_13835);
~settings_chat_timestamps;
