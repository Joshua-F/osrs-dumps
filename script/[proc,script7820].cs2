// 7820
[proc,script7820](component $component, string $string, int $int1, boolean $boolean)(int)
cc_deleteall($component);
if_setop(1, "Select", $component);
if_setopbase("<col=ff9040><$string></col>", $component);
def_int $int3 = 0;
cc_create($component, ^iftype_graphic, $int3);
$int3 = calc($int3 + 1);
cc_setsize(17, 17, ^setsize_abs, ^setsize_abs);
cc_setposition(10, 0, ^setpos_abs_left, ^setpos_abs_centre);
cc_setoutline(0);
cc_settrans(0);
if ($boolean = false) {
    if_setonmouserepeat("cc_settrans(event_com, cc_getid, 127, null)", $component);
    if_setonmouseleave("cc_settrans(event_com, cc_getid, 0, null)", $component);
}
.cc_create($component, ^iftype_text, $int3);
$int3 = calc($int3 + 1);
.cc_setsize(80, 0, ^setsize_abs, ^setsize_minus);
.cc_setposition(calc(cc_getx + cc_getwidth + 6), 0, ^setpos_abs_left, ^setpos_abs_centre);
.cc_setcolour(0xff981f);
.cc_settextfont(p12_full);
.cc_settextalign(^settextalign_left, ^settextalign_centre, 0);
.cc_settextshadow(true);
.cc_settext($string);
return(cc_getid);
