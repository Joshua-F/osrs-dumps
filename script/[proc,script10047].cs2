// 10047
[proc,script10047](component $component)
if (%tfa_client_partystatus = 2) {
    if_settext("Step Inside Now!", $component);
    if_setcolour(~tob_hud_nameflasher, $component);
    if_setontimer("script10048($component)", $component);
} else if (%tfa_client_partystatus = 0) {
    if_settext("No Party", $component);
    if_setcolour(0xff981f, $component);
    if_setontimer(null, $component);
} else {
    if_settext("Party", $component);
    if_setcolour(0xff981f, $component);
    if_setontimer(null, $component);
}
