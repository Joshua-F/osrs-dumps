// 2432
[proc,stonebutton_target_init](string $string0, component $component0, graphic $graphic1)
~stonebutton_draw(false, $string0, $graphic1, 0, $component0);
%clan_button_pressed = 0;
if (~on_mobile = false) {
    if_setonmouserepeat("stonebutton_target_hoverevent(true, $string0, event_com, $graphic1)", $component0);
}
if_setonmouseleave("stonebutton_target_hoverevent(false, $string0, event_com, $graphic1)", $component0);
if (%clan_i_am_founder = 1 | %gim_i_am_leader = 1) {
    if_setop(1, removetags($string0), $component0);
}
if_setontimer(null, $component0);
if_settargetverb(removetags($string0), $component0);
if_setopbase("", $component0);
if (if_gettargetmask($component0) ! 0) {
    if_setontargetenter("clan_create_targetmode(true, event_com, $string0, $graphic1)", $component0);
    if_setontargetleave("clan_create_targetmode(false, event_com, $string0, $graphic1)", $component0);
}
