// 2811
[clientscript,seed_vault_side_init](component $inv, component $locked_slot)
if_setoninvtransmit("seed_vault_side_draw($inv, $locked_slot){inv}", $inv);
if_setonvartransmit("seed_vault_side_draw($inv, $locked_slot){seed_vault_selected_qty, bank_locked_slots}", $inv);
def_component $lock_menu = seed_vault:lock_menu;
~script6478($lock_menu, 0);
if_setop(1, "Deposit Lock Settings", $lock_menu);
~script4081(2, $lock_menu);
if_setonvartransmit("script4080(2, event_com){bank_locked_slots}", $lock_menu);
