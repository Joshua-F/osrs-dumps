// 1235
[clientscript,wilderness_lootingbag_setprices](inv $inv, long $long0, long $long1, long $long2, long $long3, long $long4, long $long5, long $long6, long $long7, long $long8, long $long9, long $long10, long $long11, long $long12, long $long13, long $long14, long $long15, long $long16, long $long17, long $long18, long $long19, long $long20, long $long21, long $long22, long $long23, long $long24, long $long25, long $long26, long $long27)
%slotinfo_00_long = $long0;
%slotinfo_01_long = $long1;
%slotinfo_02_long = $long2;
%slotinfo_03_long = $long3;
%slotinfo_04_long = $long4;
%slotinfo_05_long = $long5;
%slotinfo_06_long = $long6;
%slotinfo_07_long = $long7;
%slotinfo_08_long = $long8;
%slotinfo_09_long = $long9;
%slotinfo_10_long = $long10;
%slotinfo_11_long = $long11;
%slotinfo_12_long = $long12;
%slotinfo_13_long = $long13;
%slotinfo_14_long = $long14;
%slotinfo_15_long = $long15;
%slotinfo_16_long = $long16;
%slotinfo_17_long = $long17;
%slotinfo_18_long = $long18;
%slotinfo_19_long = $long19;
%slotinfo_20_long = $long20;
%slotinfo_21_long = $long21;
%slotinfo_22_long = $long22;
%slotinfo_23_long = $long23;
%slotinfo_24_long = $long24;
%slotinfo_25_long = $long25;
%slotinfo_26_long = $long26;
%slotinfo_27_long = $long27;
def_int $int = inv_size($inv);
def_long $long28 = 0;
def_string $string = "Invalid item.";
while ($int > 0) {
    $int = calc($int - 1);
    if (cc_find(wilderness_lootingbag:items, $int) = true) {
        $long28 = ~script9913($int, 0);
        if ($inv = inv & $long28 <= -1 & inv_getobj(inv, $int) ! null) {
            cc_setonmouserepeat("tooltip_mouserepeat(event_com, event_comsubid, wilderness_lootingbag:tooltip, $string, 25, 512)");
            cc_setonmouseleave("deltooltip(wilderness_lootingbag:tooltip)");
        } else {
            ~trade_tooltip(inv_getnum($inv, $int), $long28, wilderness_lootingbag:tooltip);
        }
    }
}
~deltooltip_action(wilderness_lootingbag:tooltip);
