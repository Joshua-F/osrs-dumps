// 5498
[clientscript,cr_quests_ui_on_progress_transmit]
if (%cr_quests_update_cache = 1 | %quests_completed_count ! %cr_quests_cached_quests_completed | %subquests_completed_count ! %cr_quests_cached_subquests_completed | %miniquests_completed_count ! %cr_quests_cached_miniquests_completed) {
    if_setontimer("cr_quests_ui_on_progress_change(clientclock, cr_ui:quests_recommendations)", cr_ui:quests_recommendations);
}
