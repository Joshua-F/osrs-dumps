// 10256
[proc,script10256](string $string, int $int0, int $int1)
cc_setop(1, "Highlight");
cc_setopbase($string);
cc_setonop("script10285($int0)");
if (.cc_find(hc_summary:stats_content, $int1) = true) {
    .cc_setonmouseover("script10257($int1)");
    .cc_setonmouseleave("script10258($int1, .cc_gettrans)");
}
