// 1784
[proc,buff_tob_teleport_total]()(int)
if (%teleport_crystal_afk_mode = 1) {
    if (inv_total(worn, tob_teleport) > 0) {
        return(1);
    }
    if (inv_total(inv, tob_teleport) > 0) {
        return(1);
    }
    if (%holding_inventory_contains_teleport_crystal = 1) {
        return(1);
    }
}
return(0);
