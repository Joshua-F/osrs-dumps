// 5861
[clientscript,lotg_makeover_confirm](component $component0)
cc_deleteall($component0);
~v2_stone_button_filled($component0);
if (~on_mobile = false) {
    if_setonmouseleave("lotg_makeover_confirm_hover($component0, 0)", $component0);
    if_setonmouserepeat("lotg_makeover_confirm_hover($component0, 1)", $component0);
}
