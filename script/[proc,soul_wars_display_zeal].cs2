// 852
[proc,soul_wars_display_zeal](component $component)
def_string $string = ",";
if ($component = soul_wars_rewards:total_zeal) {
    if_settext("<int_0=<tostring(%soul_wars_zeal)>>Lifetime Zeal:<br> <col=ffffff><int_0:spacer></col>", $component);
} else if ($component = soul_wars_rewards:total_zeal_tokens) {
    if_settext("<int_0=<tostring(%soul_wars_zeal_tokens)>>Zeal Tokens:<br> <col=ffffff><int_0:spacer></col>", $component);
}
