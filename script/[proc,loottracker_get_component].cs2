// 4031
[proc,loottracker_get_component](int $int0, int $int1)(component)
switch_int ($int0) {
    case 0 :
        return(~loottracker_get_source_info_component($int1));
    case 1 :
        return(~loottracker_get_source_display_component($int1));
    case 2 :
        return(~loottracker_get_drop_info_component($int1));
    case 3 :
        return(~loottracker_get_drop_display_component($int1));
}
return(null);
