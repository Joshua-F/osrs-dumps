// 7234
[clientscript,ground_items_filter](obj $obj0)
if (~ground_items_obj_in_vector(stringvector_3, $obj0, false) = true) {
    ~ground_items_remove_obj_from_vector(stringvector_3, $obj0, 1);
} else {
    if (~ground_items_obj_in_vector(stringvector_4, $obj0, false) = true) {
        ~ground_items_remove_obj_from_vector(stringvector_4, $obj0, 0);
    }
    if (~ground_items_obj_in_vector(stringvector_4, $obj0, true) = true) {
        mes_typed(^chattype_spam, "<removetags(oc_name($obj0))> is being ignored via a wildcard entry.");
    }
    ~ground_items_add_obj_to_vector(stringvector_3, $obj0, 1);
}
