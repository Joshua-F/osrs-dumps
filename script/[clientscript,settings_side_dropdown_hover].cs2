// 4575
[clientscript,settings_side_dropdown_hover](boolean $boolean0, component $component, int $int2, int $int3, boolean $boolean4)
if (cc_find($component, $int2) = true & .cc_find($component, $int3) = true) {
    if ($boolean0 = true) {
        if ($boolean4 = false) {
            cc_setcolour(0xffb83f);
        }
        .cc_sethide(false);
        .cc_setposition(cc_getx, calc(cc_gety - 1), ^setpos_abs_left, ^setpos_abs_top);
    } else {
        if ($boolean4 = false) {
            cc_setcolour(0xff981f);
        }
        .cc_sethide(true);
    }
}
