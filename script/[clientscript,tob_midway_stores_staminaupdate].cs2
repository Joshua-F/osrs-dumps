// 4488
[clientscript,tob_midway_stores_staminaupdate](component $component, int $int, namedobj $namedobj)
if (cc_find($component, $int) = true) {
    cc_setobject_alwaysnum($namedobj, %tob_midwaychest_staminapot);
    if (%tob_midwaychest_staminapot = 0) {
        cc_settrans(128);
    }
}
