// 6211
[clientscript,pvpa_unrankedduel_opponent_opconfirm](int $int, component $component1, component $component2, component $component3)
if ($int ! 1) {
    return;
}
sound_synth(synth_2266, 1, 0);
~stonebutton_draw(true, "<col=9f9f9f>Confirmed</col>", p12_full, 0, $component2);
if_clearops($component2);
if_setonmouserepeat(null, $component2);
if_setonmouseleave(null, $component2);
if_setonop(null, $component2);
if_setontimer("pvpa_unrankedduel_opponent_resetconfirm(calc(clientclock + 30), $component1, $component2, $component3)", $component2);
