// 9668
[proc,castle_drakan_worldmap_draw_button](component $component0, string $string, int $int1, int $int2, component $component3, component $component4, component $component5, component $component6, component $component7, component $component8, component $component9, component $component10, component $component11, component $component12)
~castle_drakan_worldmap_setbutton($component0, $string, $int1, $int2, 0);
if_setonmouserepeat("castle_drakan_worldmap_setbutton($component0, $string, $int1, $int2, 1)", $component0);
if_setonmouseleave("castle_drakan_worldmap_setbutton($component0, $string, $int1, $int2, 0)", $component0);
if_setnoclickthrough(true, $component0);
if ($int1 = $int2) {
    if_setop(1, "", $component0);
    if_setopbase("", $component0);
    if_setonop(null, $component0);
} else {
    if_setop(1, "View", $component0);
    if_setopbase("<col=ff9040><removetags($string)></col>", $component0);
    if_setonop("castle_drakan_worldmap_op_button($int1, $component3, $component4, $component5, $component6, $component7, $component8, $component9, $component10, $component11, $component12)", $component0);
}
