// 1246
[proc,nzone_bosslist_button_init](component $component0, string $string0)
if_sethide(false, $component0);
if_setontimer(null, $component0);
~nzone_bosslist_button_set(false, $component0, $string0);
if_setonmouseover("nzone_bosslist_button_set(true, $component0, $string0)", $component0);
if_setonmouseleave("nzone_bosslist_button_set(false, $component0, $string0)", $component0);
if_setonclick("nzone_bosslist_button_click($component0, $string0)", $component0);
