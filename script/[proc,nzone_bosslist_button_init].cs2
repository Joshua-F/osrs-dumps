// 1246
[proc,nzone_bosslist_button_init](component $component, string $string)
if_sethide(false, $component);
if_setontimer(null, $component);
~nzone_bosslist_button_set(false, $component, $string);
if_setonmouseover("nzone_bosslist_button_set(true, $component, $string)", $component);
if_setonmouseleave("nzone_bosslist_button_set(false, $component, $string)", $component);
if_setonclick("nzone_bosslist_button_click($component, $string)", $component);
