// 7233
[clientscript,ground_items_highlight](obj $obj)
if (~ground_items_obj_in_vector(stringvector_4, $obj, false) = true) {
    ~ground_items_remove_obj_from_vector(stringvector_4, $obj, 1);
} else {
    if (~ground_items_obj_in_vector(stringvector_3, $obj, false) = true) {
        ~ground_items_remove_obj_from_vector(stringvector_3, $obj, 0);
    }
    if (~ground_items_obj_in_vector(stringvector_3, $obj, true) = true) {
        mes_typed(^chattype_spam, "<removetags(oc_name($obj))> is being highlighted via a wildcard entry.");
    }
    ~ground_items_add_obj_to_vector(stringvector_4, $obj, 1);
}
