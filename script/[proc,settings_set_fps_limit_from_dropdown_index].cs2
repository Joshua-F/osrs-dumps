// 3646
[proc,settings_set_fps_limit_from_dropdown_index](int $int)
if (~on_mobile = false & ~on_enhanced_desktop = false) {
    return;
}
$int = calc($int + 1);
switch_int ($int) {
    case 1 :
        setdeviceoption(^deviceoption_fps_limit, 15);
        setdeviceoption(^deviceoption_background_fps_limit, 15);
    case 2 :
        setdeviceoption(^deviceoption_fps_limit, 20);
        setdeviceoption(^deviceoption_background_fps_limit, 20);
    case 3 :
        setdeviceoption(^deviceoption_fps_limit, 30);
        setdeviceoption(^deviceoption_background_fps_limit, 30);
    case 4 :
        setdeviceoption(^deviceoption_fps_limit, 60);
        setdeviceoption(^deviceoption_background_fps_limit, 60);
    case 5 :
        setdeviceoption(^deviceoption_fps_limit, 999);
        setdeviceoption(^deviceoption_background_fps_limit, 999);
    case default :
}
