// 9250
[proc,settings_side_sound_area_volume_pos](component $component, int $int1, int $int2, int $int3)
def_int $int4 = %option_areasounds;
def_int $int5 = ~minmax(0, 100, scale($int1, calc($int2 - 16), 100));
if (%option_areasounds ! $int5 | $int3 = 1) {
    %option_areasounds = ~minmax(0, 100, $int5);
    ~settings_apply_volume_areasounds;
    ~settings_side_sound_area_volume_set_position($component, $int2);
    ~settings_side_update_mute_icon(32);
    ~settings_side_volume_update_bobbles;
    if ($int4 <= 0 & %option_areasounds > 0 | $int4 > 0 & %option_areasounds <= 0 | $int3 = 1) {
        if_runscript*(ifscript_2493361579, settings_side:areasounds_slider_bobble, -1)(%option_areasounds);
    }
}
