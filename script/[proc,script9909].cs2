// 9909
[proc,script9909](component $component, inv $inv, int $int2, obj $obj)
def_int $int4 = 0;
def_int $int5 = 0;
def_int $int6 = 0;
def_int $int7 = 0;
def_int $int8 = 0;
if ($obj ! null) {
    $obj, $int4 = ~script9910($obj, $inv, $int2);
    cc_sethide(false);
    if (oc_cert($obj) ! $obj) {
        if ($int4 = 1) {
            cc_setop(1, "Collect-item");
            cc_setop(2, "Collect-note");
        } else {
            cc_setop(1, "Collect-notes");
            cc_setop(2, "Collect-items");
        }
    } else {
        cc_setop(2, "Collect");
    }
    cc_setop(3, "Bank");
    cc_setop(10, "Examine");
    cc_setopbase("<col=ff9040><oc_name($obj)></col>");
    if ($int4 ! -1) {
        cc_setobject($obj, $int4);
    } else {
        cc_setobject_nonum($obj, ^max_32bit_int);
    }
    $int5, $int6 = cc_getwidth, cc_getheight;
    $int7, $int8 = cc_getx, cc_gety;
    if (cc_find($component, calc(cc_getid + 2)) = true) {
        if ($int4 = -1) {
            cc_sethide(false);
        } else {
            cc_sethide(true);
        }
    } else {
        cc_create($component, ^iftype_text, calc(cc_getid + 2));
        cc_setposition($int7, $int8, ^setpos_abs_left, ^setpos_abs_top);
        cc_settext("Lots!");
        cc_setsize($int5, $int6, ^setsize_abs, ^setsize_abs);
        cc_settextshadow(true);
        cc_settextfont(p11_full);
        cc_settextalign(^settextalign_left, ^settextalign_top, 0);
        cc_setcolour(0x00ff80);
        if ($int4 = -1) {
            cc_sethide(false);
        } else {
            cc_sethide(true);
        }
    }
} else {
    cc_sethide(true);
    if (cc_find($component, calc(cc_getid + 2)) = true) {
        cc_sethide(true);
    }
}
