// 1756
[clientscript,worldmap_elements_samemap_op](int $int, coord $coord, boolean $boolean)
if ($int = 1 & $coord ! null) {
    sound_synth(interface_select1, 1, 0);
    if ($boolean = false) {
        worldmap_jumptosourcecoord($coord);
    } else {
        worldmap_jumptodisplaycoord($coord);
    }
}
