// 1535
[clientscript,raids_partydetails_preference_resetbutton](component $component, int $int1, string $string, int $int2)
if (clientclock < $int2) {
    return;
}
if (cc_find($component, $int1) = true) {
    cc_setcolour(0xff981f);
    ~raids_partydetails_preference_settext($component, $string);
}
~raids_partydetails_preference_setactive($component, $int1, $string);
