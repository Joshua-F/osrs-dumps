// 1535
[clientscript,raids_partydetails_preference_resetbutton](component $component0, int $int1, string $string0, int $int2)
if (clientclock < $int2) {
    return;
}
if (cc_find($component0, $int1) = true) {
    cc_setcolour(0xff981f);
    ~raids_partydetails_preference_settext($component0, $string0);
}
~raids_partydetails_preference_setactive($component0, $int1, $string0);
