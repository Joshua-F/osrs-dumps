// 9651
[proc,castle_drakan_clock_initbutton](component $component, graphic $graphic, string $string)
~castle_drakan_clock_setbutton($component, $graphic, $string, 0, 0);
if_setonmouserepeat("castle_drakan_clock_setbutton(event_com, $graphic, $string, 1)", $component);
if_setonmouseleave("castle_drakan_clock_setbutton(event_com, $graphic, $string, 0)", $component);
if_setop(1, removetags($string), $component);
if_setontimer(null, $component);
