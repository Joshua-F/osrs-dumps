// 6500
[clientscript,cluehelper_overlay_key_loc_invtransmit](dbrow $dbrow, loc $loc, obj $obj2, coord $coord, obj $obj4, int $int)
if (loc_find($coord, $loc) = true & (inv_total(inv, $obj2) > 0 & $int = 0 | inv_total(inv, $obj2) <= 0 & $int = 1)) {
    ~cluehelper_overlay_key_loc_draw($dbrow, $loc, $obj2, $coord, $obj4);
}
