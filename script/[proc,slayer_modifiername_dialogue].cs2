// 9745
[proc,slayer_modifiername_dialogue](int $int0, int $int1, int $int2)(string)
switch_int ($int0) {
    case 1 :
        return(".<br>Completing this task will award <tostring($int1)> bonus Slayer Points");
    case 2 :
        return("");
    case 3 :
        return(".<br>Creatures on this task will have an increased chance to award clue scrolls");
    case 4 :
        return(".<br>Superior creatures on this task will have a higher chance of awarding their unique loot");
    case 5 :
        return(".<br>Creatures on this task will award bonus Slayer XP");
    case default :
        if ($int0 ! 0) {
            ~script2075("Player <name> called slayer_modifiername_dialogue with an invalid modifier_id of <tostring($int0)>, task id <tostring(%slayer_target)>.");
        }
        return("");
}
