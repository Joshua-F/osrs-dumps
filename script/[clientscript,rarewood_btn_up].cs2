// 1682
[clientscript,rarewood_btn_up](component $rarewood_bar, component $rarewood_bar_fill)
if (~script10318 = false) {
    return;
}
if (%if1 <= 0) {
    return;
}
if (%misc_points_rarewood >= 10) {
    return;
}
%misc_points_rarewood = calc(%misc_points_rarewood + 1);
%if1 = calc(%if1 - 1);
~kingdom_fill_bar_level(%misc_points_rarewood, $rarewood_bar, $rarewood_bar_fill);
