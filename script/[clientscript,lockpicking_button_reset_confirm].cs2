// 7002
[clientscript,lockpicking_button_reset_confirm](component $component, string $string, int $int, boolean $boolean)
if (clientclock < $int) {
    return;
}
if ($boolean = true) {
    ~lockpicking_initbutton_confirm($component, $string);
} else {
    ~lockpicking_initbutton_confirm($component, $string);
}
