// 10206
[clientscript,script10206](component $component0, int $int1, int $int2, component $component3)
if (%displayname_input_listening = true) {
    return;
}
if (%displayname_menu_remainingchecks > 0 & enum(int, boolean, enum_2730, if_param(param_2357, $component3, -1)) = true) {
    sound_synth(synth_2266, 1, 0);
    if (cc_find($component0, $int2) = true & .cc_find($component0, $int1) = true) {
        cc_setcolour(0x9f9f9f);
        if (string_length(%displayname_menu_input) > 0) {
            cc_settextfont(b12_full);
            cc_settext(%displayname_menu_input);
        } else {
            cc_settextfont(p11_full);
            cc_settext("<~text_device("Click", "Tap")> here to type");
        }
        .cc_setcolour(^white);
        .cc_settrans(255);
        if (~on_mobile = false) {
            .cc_setonmouserepeat("cc_settrans(event_com, event_comsubid, 235, null)");
            .cc_setonmouseleave("cc_settrans(event_com, event_comsubid, 255, null)");
        }
        .cc_setonclick("script10207(event_com, event_comsubid, $int2, $component3)");
        .cc_setontimer(null);
        .cc_setonkey(null);
    }
}
