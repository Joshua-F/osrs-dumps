// 5243
[proc,ca_task_is_disabled](struct $struct)(int)
if (~deadman_world ! 0) {
    if (struct_param($struct, param_2641) = 1) {
        return(1);
    } else {
        return(0);
    }
}
if (%gim_groupsize <= 1 | %gim_groupsize > 5) {
    return(0);
}
def_int $int = struct_param($struct, param_1425);
if (%gim_groupsize <= $int) {
    return(1);
}
return(0);
