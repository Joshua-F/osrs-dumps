// 4856
[proc,collection_draw_reset_combatachievements](component $component0)
~collection_draw_combatachievements($component0, false);
if_setonmouserepeat("collection_draw_combatachievements(event_com, true)", $component0);
if_setonmouseleave("collection_draw_combatachievements(event_com, false)", $component0);
if_setontimer(null, $component0);
if_setonop("collection_draw_op_combatachievements(event_op, event_com)", $component0);
