// 9184
[proc,skill_guide_v2_overview_add_list](component $component, stringarray $stringarray, int $int1)
def_int $int2 = array_size($stringarray);
def_int $int3 = 0;
while ($int3 < $int2) {
    ~skill_guide_v2_overview_add_text($component, $stringarray($int3));
    ~skill_guide_v2_overview_new_line($component, calc(16 + $int1));
    $int3 = calc($int3 + 1);
}
