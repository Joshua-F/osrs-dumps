// 1135
[proc,trawler_camshake_set](component $component0, component $component1)
if (~settings_camera_effect_test(struct_350) = 0) {
    if_settrans(255, $component0);
    if_settrans(150, $component1);
    if_setonmouserepeat("trawler_camshake_hover(255, 0, $component0, $component1)", $component0);
    if_setonmouseleave("trawler_camshake_hover(255, 150, $component0, $component1)", $component0);
    if_setop(1, "Disable", $component0);
    if_setonop("trawler_camshake_op(event_op, 1, $component0, $component1)", $component0);
} else {
    if_settrans(150, $component0);
    if_settrans(150, $component1);
    if_setonmouserepeat("trawler_camshake_hover(0, 0, $component0, $component1)", $component0);
    if_setonmouseleave("trawler_camshake_hover(150, 150, $component0, $component1)", $component0);
    if_setop(1, "Enable", $component0);
    if_setonop("trawler_camshake_op(event_op, 0, $component0, $component1)", $component0);
}
