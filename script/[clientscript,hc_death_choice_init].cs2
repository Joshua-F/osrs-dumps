// 10240
[clientscript,hc_death_choice_init](component $frame, component $universe, component $reset_button, component $transfer_button, int $int4, int $int5, component $text, component $text_container, component $scrollbar)
~steelborder($frame, "Continue your journey", 0);
if_setonvartransmit("hc_death_redraw($reset_button, $transfer_button, $int4, $int5, $text, $text_container, $scrollbar){hc_interface_temp}", $universe);
~hc_death_draw_all($reset_button, $transfer_button, $int4, $int5, $text, $text_container, $scrollbar);
