// 2693
[clientscript,tournament_supplies_opapplybutton](int $int)
if ($int ! 1) {
    return;
}
sound_synth(interface_select1, 1, 0);
~tournament_supplies_drawapplybutton(true, true);
if_setonmouserepeat(null, tournament_supplies:loadout_apply);
if_setonmouseleave(null, tournament_supplies:loadout_apply);
if_setonop(null, tournament_supplies:loadout_apply);
if_setontimer("tournament_supplies_resetapplybutton(calc(clientclock + 40))", tournament_supplies:loadout_apply);
