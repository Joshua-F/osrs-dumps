// 7236
[proc,ground_items_price](obj $obj)(int, boolean)
if ($obj = coins) {
    return(1, true);
}
$obj = oc_uncert($obj);
def_long $long = 0;
def_int $int1 = 0;
def_int $int2 = 0;
def_boolean $boolean = true;
if (%ground_items_price_type = 0 & stockmarket_sellable($obj) = true) {
    $int2, $long = stockmarket_value($obj);
    $int1 = ~script9914($long);
    if ($int2 = 2) {
        return(max($int1, 0), true);
    } else {
        $boolean = false;
    }
}
if (oc_param($obj, param_295) = 0) {
    $int1 = ~script7127(oc_cost($obj));
