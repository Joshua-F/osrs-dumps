// 3426
[proc,boardgames_challenge_update](int $int, component $component1, component $component2, component $component3, component $component4)
if (cc_find($component1, $int) = true) {
    if (%boardgames_game = 0) {
        cc_setgraphic("radio_buttons,1");
    } else {
        cc_setgraphic("radio_buttons,0");
    }
}
if (cc_find($component2, $int) = true) {
    if (%boardgames_game = 1) {
        cc_setgraphic("radio_buttons,1");
    } else {
        cc_setgraphic("radio_buttons,0");
    }
}
if (cc_find($component3, $int) = true) {
    if (%boardgames_game = 2) {
        cc_setgraphic("radio_buttons,1");
    } else {
        cc_setgraphic("radio_buttons,0");
    }
}
if (cc_find($component4, $int) = true) {
    if (%boardgames_game = 3) {
        cc_setgraphic("radio_buttons,1");
    } else {
        cc_setgraphic("radio_buttons,0");
    }
}
