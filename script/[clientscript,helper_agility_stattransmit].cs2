// 5724
[clientscript,helper_agility_stattransmit](entityoverlay $entityoverlay, int $int1, int $int2, int $int3, loc $loc, coord $coord)
~helper_agility_shortcut_overlay_create($entityoverlay, $loc, $coord);
if (if_find_entityoverlay($entityoverlay) = true) {
    cc_setonstattransmit("helper_agility_stattransmit($entityoverlay, $int1, $int2, $int3, $loc, $coord){ranged, agility, strength}");
}
