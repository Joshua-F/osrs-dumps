// 8925
[clientscript,port_task_board_onop](component $component, int $int, dbrow $dbrow)
sound_synth(quetzal_map_select_01, 1, 0);
if (cc_find($component, $int) = true) {
    cc_setonop(null);
    cc_setontimer("port_task_board_onop_restore($component, $int, $dbrow, calc(clientclock + 32))");
}
