// 10295
[proc,hc_abbreviate_string](string $string, int $int0)(string)
def_int $int1 = string_length($string);
if ($int1 > $int0) {
    ~hc_summary_add_tooltip($string);
}
$string = substring($string, 0, min($int1, $int0));
if ($int1 > $int0) {
    $string = append($string, ".");
}
return($string);
