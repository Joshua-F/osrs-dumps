// 10337
[clientscript,quest_rating_toggle_button_press](component $component0, component $component1, component $component2)
%settings_disable_quest_rating_prompts = calc(1 - %settings_disable_quest_rating_prompts);
%settings_quest_rating_prompts_ever_changed = 1;
~quest_rating_toggle_update($component0, $component1, $component2, 0);
