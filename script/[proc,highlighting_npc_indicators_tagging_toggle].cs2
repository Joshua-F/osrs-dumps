// 7580
[proc,highlighting_npc_indicators_tagging_toggle](int $int0)
if (~on_enhanced_any = false) {
    return;
}
if ($int0 = 1) {
    clientop_npc_set(1, "Tag", highlighting_npc_highlight);
    clientop_npc_set(2, "Tag-All", highlighting_npc_all_highlight);
} else {
    clientop_npc_del(1);
    clientop_npc_del(2);
}
~script7431;
