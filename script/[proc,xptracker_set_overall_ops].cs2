// 5462
[proc,xptracker_set_overall_ops](int $int0)
def_string $string0 = "Pause";
if (~xptracker_get_paused(null) = 1) {
    $string0 = "Unpause";
}
if (cc_find(interface_729:com_5, $int0) = true) {
    cc_setopbase("<col=ff9040>All Trackers</col>");
    cc_setop(7, "Close");
    cc_setop(8, $string0);
    cc_setonop("xptracker_overall_ops(event_op)");
}
