// 9961
[proc,script9961](dbrow $dbrow, component $component, graphic $graphic2, int $int3, int $int4, int $int5, int $int6, graphic $graphic7, fontmetrics $fontmetrics, int $int9)(int)
def_int $int10 = 0;
def_int $int11 = 0;
def_string $string = "";
$int10, $int11 = ~script9968("Overview", $int10, $component, $int11, $graphic2, $int4, $int6);
$string = "Using protection prayers in PvP combat is key to survival. However, your opponent may switch equipment in combat to get around your prayer. In this scenario, you'll practice switching prayers in response to an opponent switching between common equipment sets. Your sparring partner will attack at a speed far faster than normal, just to keep you on your toes.";
$int10, $int11 = ~script9969($string, $int10, $component, $int11, $graphic7, $fontmetrics, $int9);
$int10, $int11 = ~script9968("Key Points", $int10, $component, calc($int11 + $int5), $graphic2, $int4, $int6);
$string = "- In PvP combat, prayers reduce damage by 40%.<br><br>- Look carefully at what equipment your opponent is using and be ready for them to switch.<br><br>- This challenge grants access to protection prayers, but their usual requirements are:<br>  - Protect from Magic: 37 Prayer.<br>  - Protect from Missiles: 40 Prayer.<br>  - Protect from Melee: 43 Prayer.<br><br>- Complete this challenge to receive 20 Blighted super restore (4) potions.";
$int10, $int11 = ~script9969($string, $int10, $component, $int11, $graphic7, $fontmetrics, $int9);
$int10, $int11 = ~script9968("Tips", $int10, $component, calc($int11 + $int5), $graphic2, $int4, $int6);
$string = "- When fighting opponents who change their equipment at a rapid pace, you may be better off predicting what they will attack with, rather than basing your prayers on the current gear they are wearing.<br><br>- Against a less experienced opponent, solely basing your protection prayers on their current gear will likely be optimal.<br><br>- Wearing your best defensive gear can also reduce incoming damage by making your opponent less likely to hit.";
$int10, $int11 = ~script9969($string, $int10, $component, $int11, $graphic7, $fontmetrics, $int9);
return($int11);
