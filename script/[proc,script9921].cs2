// 9921
[proc,script9921]
def_int $int = 35;
switch_int (%responsive_current_breakpoint) {
    case 1 :
        $int = 37;
        if_setsize(500, 400, ^setsize_abs, ^setsize_abs, pvptut_ui:window);
    case 2 :
        $int = 37;
        if_setsize(500, 500, ^setsize_abs, ^setsize_abs, pvptut_ui:window);
    case 3 :
        $int = 39;
        if_setsize(500, 600, ^setsize_abs, ^setsize_abs, pvptut_ui:window);
    case default :
        $int = 35;
        if_setsize(420, 300, ^setsize_abs, ^setsize_abs, pvptut_ui:window);
}
~responsive_interface_content_resize(pvptut_ui:content);
def_string $string = "PvP Challenges";
if (%pvptut_ui_selected_tutorial ! null) {
    $string = db_getfield(%pvptut_ui_selected_tutorial, pvp_tutorial:title, 0);
}
~steelborder(pvptut_ui:frame, $string, 17);
if (%pvptut_ui_selected_tutorial ! null) {
    ~script9927(%pvptut_ui_selected_tutorial);
} else {
    ~script9922;
}
