// 1321
[clientscript,bankmenu_incinerator_toggle_op](int $int0, component $component, int $int2)
if ($int0 ! 1) {
    return;
}
if (cc_find($component, $int2) = true) {
    sound_synth(interface_select1, 1, 0);
    %bank_showincinerator = calc(1 - %bank_showincinerator);
    ~bankmenu_incinerator_toggle_set($component);
}
