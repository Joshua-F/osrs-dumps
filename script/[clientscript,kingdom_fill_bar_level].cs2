// 10316
[clientscript,kingdom_fill_bar_level](component $component0, component $component1)
switch_component ($component1) {
    case misc_both_manage:fishing_bar_fill :
        ~kingdom_fill_bar_level(%misc_points_fish, $component0, $component1);
    case misc_both_manage:mining_bar_fill :
        ~kingdom_fill_bar_level(%misc_points_mine, $component0, $component1);
    case misc_both_manage:wood_bar_fill :
        ~kingdom_fill_bar_level(%misc_points_wood, $component0, $component1);
    case misc_both_manage:herbs_bar_fill :
        ~kingdom_fill_bar_level(%misc_points_herb, $component0, $component1);
    case misc_both_manage:rarewood_bar_fill :
        ~kingdom_fill_bar_level(%misc_points_rarewood, $component0, $component1);
    case misc_both_manage:farm_bar_fill :
        ~kingdom_fill_bar_level(%misc_points_farm, $component0, $component1);
}
