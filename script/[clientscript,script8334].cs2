// 8334
[clientscript,script8334](int $int0, int $int1)
def_string $string = "This poll is <"<col=ffffff>">not currently open</col>.";
if ($int1 ! -1) {
    $string = "Voting is due to begin in <"<col=ffffff>"><~tostring_minutes($int1, 0)></col>.";
}
~ballot_overview_draw_intro($int0, $string);
