// 2905
[proc,loottracker_debug_ui_output_display_components]
~debug_mes("loottracker_debug_ui_output_display_components");
def_component $component = null;
def_int $int1 = 0;
def_int $int2 = 0;
def_obj $obj = null;
def_int $int4 = -1;
while ($int1 < 10) {
    $component = ~loottracker_get_source_display_component($int1);
    ~debug_mes("<int_0=<tostring($int1)>>source (<int_0:zeropad_3>)");
    $int2 = calc(8 + (2 - 1));
    while (cc_find($component, $int2) = true) {
        $obj = cc_getinvobject;
        $int4 = cc_getinvcount;
        ~debug_mes("<int_0=<tostring($int1)>><int_1=<tostring($int2)>>source (<int_0:zeropad_3>) item  (<int_1:zeropad_3>) = <tostring($int4)> x <oc_name($obj)>");
        $int2 = calc($int2 + 2);
    }
    $int1 = calc($int1 + 1);
}
