// 1680
[clientscript,script1680](component $herbs_bar, component $herbs_bar_fill)
if (%if1 <= 0) {
    return;
}
if (%misc_points_herb >= 10) {
    return;
}
%misc_points_herb = calc(%misc_points_herb + 1);
%if1 = calc(%if1 - 1);
~script10317(%misc_points_herb, $herbs_bar, $herbs_bar_fill);
