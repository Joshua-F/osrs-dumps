// 7194
[clientscript,loottracker_add_drop_loc](loc $loc, int $int1, obj $obj, int $int3)
def_string $string = removetags(lc_name($loc));
if (string_length($string) = 0) {
    return;
}
$obj = ~loottracker_override_item($obj);
loottracker_lootadd($string, $obj, $int3, $int1);
~loottracker_ui_update_with_drop($string, $obj, $int3, $int1);
