// 986:0
[universe]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre

// 986:1
[content]
type=layer
width=512
height=334
xmode=abs_centre
ymode=abs_centre
layer=universe

// 986:2
[close_button]
type=layer
x=5
y=2
width=32
height=32
xmode=abs_right
layer=content
transmitop=1
op1=Close
onop=closebutton_click

// 986:3
