// 975:0
[universe]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script10045(tfa_lobby:dodger, tfa_lobby:content, tfa_lobby:names_header)

// 975:1
[dodger]
type=layer
widthmode=minus
heightmode=minus
layer=universe

// 975:2
[content]
type=layer
x=2
y=2
width=124
height=151
layer=dodger
onload=stonepanel(event_com, -1)

// 975:3
[content_background]
type=graphic
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=content
graphic=tradebacking
tiling=yes
trans=80

// 975:4
[names_header]
type=text
y=4
width=8
height=20
widthmode=minus
xmode=abs_centre
layer=content
textfont=b12_full
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xff981f

// 975:5
[names]
type=text
y=4
width=8
height=28
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=content
textfont=p12_full
textlineheight=15
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xff981f

