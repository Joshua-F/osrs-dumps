// 287:0
[universe]
type=layer
width=350
height=235
xmode=abs_centre
ymode=abs_centre
onload=fossil_underwater_training_init(event_com, fossil_underwater_training:bottom, fossil_underwater_training:agility, fossil_underwater_training:thieving, fossil_underwater_training:both)

// 287:1
[frame]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=universe
onload=steelborder(event_com, "Mairin's Training")

// 287:2
[buttons]
type=layer
y=40
width=20
height=85
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=universe

// 287:3
[agility]
type=layer
width=108
heightmode=minus
layer=buttons
transmitop=1,2,3,4
op1=Exchange-1
op2=Exchange-5
op3=Exchange-X
op4=Exchange-All

// 287:4
[com_4]
type=model
width=108
height=100
ymode=abs_centre
layer=buttons
model=model_3328
modelorigin=-2,2
modelangle=512,0,0
modelzoom=524

