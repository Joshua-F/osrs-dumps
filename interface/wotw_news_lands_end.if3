// 988:0
[universe]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre

// 988:1
[frame]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=universe

// 988:2
[background]
type=model
width=32
height=32
xmode=abs_centre
ymode=abs_centre
layer=frame
model=model_25725
modelangle=512,0,0
modelzoom=450

// 988:3
[content]
type=layer
widthmode=minus
heightmode=minus
layer=universe

// 988:4
[close_button]
type=layer
x=17
y=15
width=32
height=32
xmode=abs_right
layer=content
transmitop=1
op1=Close
onop=closebutton_click

// 988:5
[left_content]
type=layer
x=-129
y=58
width=190
height=200
xmode=abs_centre
ymode=abs_bottom
layer=content

// 988:6
[left_text]
type=text
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=left_content
