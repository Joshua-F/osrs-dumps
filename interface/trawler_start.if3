// 368:12
[close]
type=graphic
x=465
y=33
width=26
height=23
graphic="close_buttons,4"
transmitop=1
op1=Close
onmouseover=graphic_swapper(event_com, "close_buttons,5")
onmouseleave=graphic_swapper(event_com, "close_buttons,4")
onop=closebutton_click

// 368:13
[no_show_again]
type=layer
y=269
width=438
height=37
xmode=abs_centre
transmitop=1
op1=Select
onload=trawler_start_setgraphic(trawler_start:no_show_box)
onvartransmit=trawler_start_setgraphic(trawler_start:no_show_box){trawler}
onop=trawler_start_toggle(trawler_start:no_show_again)

// 368:14
[no_show_box]
type=graphic
x=-88
y=5
width=18
height=18
xmode=abs_centre
layer=no_show_again
graphic="toggle_box,0"

