// 972:0
[universe]
type=layer
widthmode=minus
heightmode=minus
onload=script9962(pvptut_scoreboard_ui:dodger, pvptut_scoreboard_ui:contents, pvptut_scoreboard_ui:text, pvptut_scoreboard_ui:output, pvptut_scoreboard_ui:tooltip)

// 972:1
[dodger]
type=layer
widthmode=minus
heightmode=minus
layer=universe

// 972:2
[contents]
type=layer
x=3
y=3
width=111
height=65
xmode=abs_right
layer=dodger

// 972:3
[tooltip]
type=layer
width=1
height=1
layer=dodger

// 972:4
[com_4]
type=rectangle
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=contents
colour=0x751111
fill=yes
trans=125

// 972:5
[text]
type=text
y=3
height=30
widthmode=minus
xmode=abs_centre
layer=contents
textfont=p12_full
text=Pete's Penultimate<br>Challenge
textlineheight=15
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffff00

// 972:6
[output]
type=text
height=30
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=contents
textfont=b12_full
text=Score<br>best
textalignh=centre
textalignv=centre
textshadow=yes

