// 980:0
[infinite]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre

// 980:1
[universe]
type=layer
width=232
height=265
ymode=abs_centre
layer=infinite
onload=script7055(event_com, displayname_menu:frame, displayname_menu:close, displayname_menu:1, displayname_menu:bg_freechange, displayname_menu:freechange, displayname_menu:bg_extrachanges, displayname_menu:extrachanges, displayname_menu:startsession, displayname_menu:bonds, displayname_menu:2, displayname_menu:swirly2, displayname_menu:exitqueue, displayname_menu:3, displayname_menu:entername, displayname_menu:action, displayname_menu:exitsession, displayname_menu:4, displayname_menu:swirly4)

// 980:2
[frame]
