widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=universe
noclickthrough=yes

// 980:3
[close]
type=graphic
x=1
y=1
width=1
height=1
layer=universe
transmitop=1
op1=*

