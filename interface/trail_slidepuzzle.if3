// 306:0
[universe]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=trail_slidepuzzle_init(trail_slidepuzzle:pieces, trail_slidepuzzle:grid_standard, trail_slidepuzzle:grid_mm, trail_slidepuzzle:grid_background)

// 306:1
[grid_background]
type=rectangle
width=265
height=265
xmode=abs_centre
ymode=abs_centre
layer=universe
colour=0x371c00
fill=yes

// 306:2
[grid_standard]
type=model
x=-2
y=-1
width=32
height=32
xmode=abs_centre
ymode=abs_centre
layer=universe
model=model_3438
modelorigin=2,-14
modelangle=512,0,0
modelzoom=342

// 306:3
[grid_mm]
type=model
x=-2
y=-1
width=32
height=32
xmode=abs_centre
ymode=abs_centre
layer=universe
hide=yes
model=model_4695
modelorigin=2,-13
modelangle=513,0,0
modelzoom=342

// 306:4
[pieces]
type=layer
width=251
height=251
xmode=abs_centre
ymode=abs_centre
layer=universe

// 306:5
[com_5]
type=graphic
x=58
y=16
width=26
height=23
xmode=abs_right
layer=universe
graphic="close_buttons,4"
transmitop=1
op1=Close
onmouseover=graphic_swapper(event_com, "close_buttons,5")
onmouseleave=graphic_swapper(event_com, "close_buttons,4")
onop=closebutton_click

