// 75:0
[universe]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=lunar_contact_npc_init(event_com, lunar_contact_npc:contents, lunar_contact_npc:scrollbar, lunar_contact_npc:scrolllayer)

// 75:1
[main]
type=layer
width=500
height=328
xmode=abs_centre
ymode=abs_centre
layer=universe

// 75:2
[frame]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=main
onload=steelborder(event_com, "Choose a character")

// 75:3
[contents]
