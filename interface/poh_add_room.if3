// 212:0
[universe]
type=layer
x=12
y=20
width=488
height=300

// 212:1
[frame]
type=layer
width=488
height=300
layer=universe
onload=steelborder(event_com, "Room Creation Menu")

// 212:2
[com_2]
type=text
y=40
width=20
height=20
widthmode=minus
xmode=abs_centre
layer=universe
textfont=p12_full
text=Select a room to build
textshadow=yes
colour=0xff981f

// 212:3
[com_3]
